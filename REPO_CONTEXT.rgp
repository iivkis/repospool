FILE	schema.sql
-- RGP SQLite index schema v0.1 (design contract, NOT shipped by MVP-A).
-- Compatible with SQLite 3.35+: no JSON1, FTS5, generated columns or STRICT tables required.
-- All byte-for-byte originals remain in files/<sha256> inside RGP, never in this DB.
-- Consumers MUST verify the outer RGP and ZIP before extracting this database, and
-- MUST open an extracted copy read-only with PRAGMA query_only=ON.
PRAGMA foreign_keys = ON;
PRAGMA user_version = 1;

CREATE TABLE snapshot (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    format_version TEXT NOT NULL,
    source_commit TEXT NOT NULL,
    input_tree_digest TEXT NOT NULL CHECK (length(input_tree_digest) = 64)
);

CREATE TABLE files (
    path TEXT PRIMARY KEY COLLATE BINARY,
    mode TEXT NOT NULL CHECK (mode IN ('100644', '100755', '120000')),
    kind TEXT NOT NULL CHECK (kind IN ('file', 'symlink')),
    size_bytes INTEGER NOT NULL CHECK (size_bytes >= 0),
    sha256 TEXT NOT NULL CHECK (length(sha256) = 64),
    blob_path TEXT NOT NULL,
    status TEXT NOT NULL CHECK (status IN ('included', 'pointer_only')),
    CHECK ((mode = '120000' AND kind = 'symlink') OR (mode != '120000' AND kind = 'file'))
);

-- Analyzer runs are configuration-scoped; different features/toolchains must not
-- silently share semantic claims. The config is serialized JSON, not executable SQL.
CREATE TABLE analysis_runs (
    run_id TEXT PRIMARY KEY,
    producer TEXT NOT NULL,
    producer_version TEXT NOT NULL,
    configuration_json TEXT NOT NULL,
    status TEXT NOT NULL CHECK (status IN ('parsed', 'partial', 'failed', 'unsupported')),
    input_tree_digest TEXT NOT NULL CHECK (length(input_tree_digest) = 64)
);

CREATE TABLE symbols (
    symbol_id TEXT PRIMARY KEY,
    path TEXT NOT NULL COLLATE BINARY REFERENCES files(path),
    name TEXT NOT NULL,
    kind TEXT NOT NULL,
    start_line INTEGER NOT NULL CHECK (start_line >= 1),
    start_column INTEGER NOT NULL CHECK (start_column >= 0),
    end_line INTEGER NOT NULL CHECK (end_line >= start_line),
    end_column INTEGER NOT NULL CHECK (end_column >= 0),
    run_id TEXT NOT NULL REFERENCES analysis_runs(run_id),
    -- Syntactic occurrence does not prove a resolved semantic reference.
    confidence_kind TEXT NOT NULL CHECK (confidence_kind IN
        ('confirmed_reference', 'possible_dependency', 'heuristic_relation', 'unknown'))
);
CREATE INDEX idx_symbols_name ON symbols(name);
CREATE INDEX idx_symbols_path ON symbols(path, start_line);

-- A relationship is a claim supported by a specific source range, not a proof of
-- runtime behavior. Exactly one of resolved target or unresolved text is recorded.
CREATE TABLE relations (
    relation_id TEXT PRIMARY KEY,
    relation_type TEXT NOT NULL CHECK (relation_type IN
        ('imports', 'references', 'calls', 'implements', 'contains', 'tests', 'configures')),
    source_path TEXT NOT NULL COLLATE BINARY REFERENCES files(path),
    source_symbol_id TEXT REFERENCES symbols(symbol_id),
    target_symbol_id TEXT REFERENCES symbols(symbol_id),
    unresolved_target TEXT,
    evidence_path TEXT NOT NULL COLLATE BINARY REFERENCES files(path),
    start_line INTEGER NOT NULL CHECK (start_line >= 1),
    start_column INTEGER NOT NULL CHECK (start_column >= 0),
    end_line INTEGER NOT NULL CHECK (end_line >= start_line),
    end_column INTEGER NOT NULL CHECK (end_column >= 0),
    run_id TEXT NOT NULL REFERENCES analysis_runs(run_id),
    evidence TEXT NOT NULL,
    confidence_kind TEXT NOT NULL CHECK (confidence_kind IN
        ('confirmed_reference', 'possible_dependency', 'heuristic_relation', 'unknown')),
    CHECK ((target_symbol_id IS NULL) != (unresolved_target IS NULL)),
    CHECK (confidence_kind != 'confirmed_reference' OR target_symbol_id IS NOT NULL)
);
CREATE INDEX idx_relations_source ON relations(source_symbol_id, relation_type);
CREATE INDEX idx_relations_target ON relations(target_symbol_id, relation_type);
CREATE INDEX idx_relations_evidence ON relations(evidence_path, start_line);

-- Snapshot, index, graph and investigation are not interchangeable metrics.
-- Investigation records Reader disclosures, never unobserved agent comprehension.
CREATE TABLE coverage (
    layer TEXT NOT NULL CHECK (layer IN ('snapshot', 'index', 'graph', 'investigation')),
    scope TEXT NOT NULL,
    run_id TEXT REFERENCES analysis_runs(run_id),
    status TEXT NOT NULL CHECK (status IN
        ('available', 'not_indexed', 'partial', 'failed', 'unsupported', 'unknown')),
    included_count INTEGER CHECK (included_count IS NULL OR included_count >= 0),
    total_count INTEGER CHECK (total_count IS NULL OR total_count >= 0),
    reason TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (layer, scope)
);

FILE	scripts/gate_b.py
#!/usr/bin/env python3
"""Gate B: assistant-operated GitHub-vs-RGP observations, no model API or runner.

This validates recorded observations, not the truthfulness of self-reported
answers/call counts. That requires inspection of actual tool history.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path

ARMS = ("github_connector", "rgp_reader")
HEX = frozenset("0123456789abcdef")


class ProtocolError(ValueError):
    pass


def require(ok: bool, message: str) -> None:
    if not ok:
        raise ProtocolError(message)


def strict_json(path: Path) -> dict:
    def unique(pairs):
        out = {}
        for key, value in pairs:
            require(key not in out, f"duplicate JSON field: {key}")
            out[key] = value
        return out

    value = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=unique)
    require(isinstance(value, dict), "expected JSON object")
    return value


def digest_plan(plan: dict) -> str:
    data = json.dumps(plan, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(data.encode("utf-8")).hexdigest()


def valid_commit(value: object) -> bool:
    return isinstance(value, str) and len(value) in (40, 64) and all(c in HEX for c in value)


def validate_plan(plan: dict) -> dict:
    require(plan.get("schema_version") == "2.0", "expected assistant-only plan v2.0")
    require(plan.get("method") == "assistant_in_chat", "an external model is not part of Gate B")
    require(plan.get("arms") == list(ARMS), "invalid comparison arms")
    limits = plan.get("requirements")
    require(isinstance(limits, dict) and limits.get("minimum_repositories") == 3, "need 3 repositories")
    require(type(limits.get("minimum_tasks")) is int and limits["minimum_tasks"] >= 10, "need >=10 tasks")
    require(limits.get("no_correctness_regressions") is True, "correctness guardrail missing")
    require(limits.get("minimum_connector_call_reduction") == 0.30, "call threshold changed")
    repos, tasks = plan.get("repositories"), plan.get("tasks")
    require(isinstance(repos, list) and len(repos) >= 3, "missing repositories")
    require(isinstance(tasks, list) and len(tasks) >= limits["minimum_tasks"], "missing tasks")
    by_id = {}
    github_repos = set()
    for repo in repos:
        require(isinstance(repo, dict) and isinstance(repo.get("id"), str)
                and repo["id"] and repo["id"] not in by_id, "invalid/duplicate repository")
        require(valid_commit(repo.get("commit")), "unpinned commit")
        github = repo.get("github")
        require(isinstance(github, str) and len(github.split("/")) == 2
                and all(part and part not in (".", "..") for part in github.split("/")),
                "invalid repo name")
        require(github not in github_repos, "duplicate GitHub repository")
        github_repos.add(github)
        by_id[repo["id"]] = repo
    ids = set()
    for task in tasks:
        require(isinstance(task, dict) and isinstance(task.get("id"), str)
                and task["id"] and task["id"] not in ids, "invalid/duplicate task")
        require(isinstance(task.get("repository"), str)
                and task["repository"] in by_id, "unknown task repository")
        require(isinstance(task.get("prompt"), str) and len(task["prompt"]) > 15, "invalid prompt")
        require(isinstance(task.get("rubric"), str) and len(task["rubric"]) > 15, "missing rubric")
        paths = task.get("reference_paths")
        require(isinstance(paths, list) and bool(paths) and all(isinstance(p, str) and p
                and not p.startswith("/") and all(seg not in ("", ".", "..") for seg in p.split("/"))
                for p in paths), "unsafe/missing source paths")
        require(len(paths) == len(set(paths)), "duplicate source paths")
        ids.add(task["id"])
    require({t["repository"] for t in tasks} == set(by_id), "every repository must have tasks")
    return {"plan_sha256": digest_plan(plan), "repositories": len(repos), "tasks": len(tasks),
            "expected_observations": len(tasks) * len(ARMS)}



def validate_github_cache(plan: dict, rows: dict, cache: object) -> dict:
    """Check first-use cache accounting against pinned paths and both arm's anchors.

    This is deterministic consistency checking. A JSON ledger is not a trusted
    recording of an actual connector call; independent chat-history review is
    still necessary before a GO decision.
    """
    require(isinstance(cache, dict) and cache.get("policy") == "first_use_pinned_blob",
            "unsupported GitHub source-cache policy")
    fetches = cache.get("source_fetches")
    require(isinstance(fetches, list), "source_fetches must be a list")
    repos = {repo["id"]: repo for repo in plan["repositories"]}
    expected = {}
    first_use_by_task = {task["id"]: 0 for task in plan["tasks"]}
    for task in plan["tasks"]:
        rid = task["repository"]
        for path in task["reference_paths"]:
            key = (rid, repos[rid]["commit"], path)
            if key not in expected:
                expected[key] = task["id"]
                first_use_by_task[task["id"]] += 1
    require(len(fetches) == len(expected), "cache ledger must contain exactly the unique required files")
    seen = set()
    blob_sha = {}
    for i, fetch in enumerate(fetches):
        require(isinstance(fetch, dict), f"cache fetch {i} must be an object")
        rid, commit, path, task_id = (fetch.get(k) for k in
                                       ("repository", "source_commit", "path", "task_id"))
        require(all(isinstance(v, str) for v in (rid, commit, path, task_id)),
                f"cache fetch {i}: invalid field type")
        key = (rid, commit, path)
        require(key in expected and key not in seen,
                f"cache fetch {i}: unknown or duplicate pinned source")
        require(task_id == expected[key],
                f"cache fetch {i}: source must be acquired at first task use")
        sha = fetch.get("git_blob_sha1")
        require(isinstance(sha, str) and len(sha) == 40 and all(c in HEX for c in sha),
                f"cache fetch {i}: invalid Git blob SHA-1")
        pinned_url = f'https://github.com/{repos[rid]["github"]}/blob/{commit}/{path}'
        require(fetch.get("source_url") == pinned_url,
                f"cache fetch {i}: source URL must pin repository, commit and path")
        seen.add(key)
        blob_sha[key] = sha
    require(seen == set(expected), "cache ledger has missing source files")
    for task in plan["tasks"]:
        tid, rid = task["id"], task["repository"]
        github_row = rows[(tid, ARMS[0])]
        require(github_row["connector_calls"] == first_use_by_task[tid],
                f"cache accounting mismatch for task {tid}")
        for arm in ARMS:
            row = rows[(tid, arm)]
            evidence = row.get("source_evidence")
            require(isinstance(evidence, dict) and set(evidence) == set(task["reference_paths"]),
                    f"cache task {tid}/{arm}: source evidence missing")
            for path in task["reference_paths"]:
                detail = evidence[path]
                key = (rid, repos[rid]["commit"], path)
                url = f'https://github.com/{repos[rid]["github"]}/blob/{key[1]}/{path}'
                require(isinstance(detail, dict) and detail.get("git_blob_sha1") == blob_sha[key]
                        and detail.get("source_url") == url,
                        f"cache task {tid}/{arm}: source anchor mismatch: {path}")
    return {"policy": "first_use_pinned_blob", "unique_source_fetches": len(fetches),
            "evidence_status": "self_reported_requires_independent_tool_history_review"}


def evaluate(plan: dict, measurements: dict) -> dict:
    info = validate_plan(plan)
    require(measurements.get("schema_version") == "2.0", "unsupported observations version")
    require(isinstance(measurements.get("observations"), list), "observations must be a list")
    rows = measurements["observations"]
    result = dict(gate="B", status="HOLD", plan_sha256=info["plan_sha256"],
                  expected_observations=info["expected_observations"], received_observations=len(rows),
                  reasons=[], call_reduction=None, token_reduction=None)
    if measurements.get("plan_sha256") != info["plan_sha256"]:
        result["reasons"].append("observation plan SHA mismatch")
    if measurements.get("method") != "assistant_in_chat":
        result["reasons"].append("only observations made by the assistant in this chat are eligible")
    tasks = {task["id"]: task for task in plan["tasks"]}
    repos = {repo["id"]: repo for repo in plan["repositories"]}
    seen = {}
    has_github_cache = "github_cache" in measurements
    for i, row in enumerate(rows):
        require(isinstance(row, dict), f"observation {i} must be an object")
        tid, arm = row.get("task_id"), row.get("arm")
        require(isinstance(tid, str) and tid in tasks
                and isinstance(arm, str) and arm in ARMS,
                f"observation {i}: invalid task/arm")
        key = (tid, arm)
        require(key not in seen, f"duplicate observation {key}")
        task = tasks[tid]
        require(row.get("repository") == task["repository"], f"observation {i}: wrong repository")
        require(row.get("source_commit") == repos[task["repository"]]["commit"], f"observation {i}: wrong commit")
        require(type(row.get("correct")) is bool, f"observation {i}: missing correctness assessment")
        require(type(row.get("connector_calls")) is int and row["connector_calls"] >= 0,
                f"observation {i}: connector_calls must be measured")
        require(arm != ARMS[0] or row["connector_calls"] >= 1 or has_github_cache,
                f"observation {i}: GitHub arm must include a source retrieval call")
        require(isinstance(row.get("answer"), str) and len(row["answer"].strip()) >= 15,
                f"observation {i}: answer missing")
        require(isinstance(row.get("evidence_url"), str) and row["evidence_url"].startswith("https://"),
                f"observation {i}: missing external evidence reference")
        source_paths = row.get("source_paths")
        require(isinstance(source_paths, list) and bool(source_paths)
                and all(isinstance(p, str) and p in task["reference_paths"] for p in source_paths)
                and len(source_paths) == len(task["reference_paths"])
                and set(source_paths) == set(task["reference_paths"]),
                f"observation {i}: source paths must cover each rubric reference exactly once")
        seen[key] = row
    if len(seen) != info["expected_observations"]:
        result["reasons"].append(f"{info['expected_observations'] - len(seen)} observations missing")
    preparation = measurements.get("rgp_preparation_calls")
    if not isinstance(preparation, dict) or set(preparation) != set(repos) or any(
            type(n) is not int or n < 1 for n in preparation.values()):
        result["reasons"].append("RGP artifact acquisition requires at least one counted connector call per repository")
    # No claimed savings from incomplete data or mismatched plan.
    if result["reasons"]:
        return result
    if has_github_cache:
        result["github_cache"] = validate_github_cache(plan, seen, measurements["github_cache"])
    baseline = sum(seen[(t, ARMS[0])]["connector_calls"] for t in tasks)
    rgp = sum(seen[(t, ARMS[1])]["connector_calls"] for t in tasks) + sum(preparation.values())
    result["github_calls"] = baseline
    result["rgp_calls_including_preparation"] = rgp
    result["call_reduction"] = None if baseline == 0 else 1 - rgp / baseline
    regressions = [tid for tid in tasks if seen[(tid, ARMS[0])]["correct"]
                   and not seen[(tid, ARMS[1])]["correct"]]
    result["correctness_regressions"] = regressions
    if regressions:
        result["reasons"].append("RGP correctness regressed")
    incorrect = [tid for tid in tasks if not seen[(tid, ARMS[1])]["correct"]]
    result["rgp_incorrect_tasks"] = incorrect
    if incorrect:
        result["reasons"].append("RGP answers did not meet all task rubrics")
    if result["call_reduction"] is None or result["call_reduction"] < 0.30:
        result["reasons"].append("connector-call reduction below 30%")
    # User-facing answers / tool logs still need inspection; a JSON file cannot attest itself.
    result["status"] = "PIVOT" if result["reasons"] else "GO_CANDIDATE"
    return result


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("plan", "report"))
    parser.add_argument("--plan", type=Path, default=Path("benchmarks/gate_b/plan.json"))
    parser.add_argument("--observations", type=Path, default=Path("benchmarks/gate_b/observations.template.json"))
    args = parser.parse_args()
    try:
        plan = strict_json(args.plan)
        value = validate_plan(plan) if args.command == "plan" else evaluate(plan, strict_json(args.observations))
    except (ProtocolError, OSError, json.JSONDecodeError) as exc:
        parser.error(str(exc))
    print(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()

FILE	scripts/gate_b_call_audit.py
#!/usr/bin/env python3
"""Gate B: reconcile a provider-call transcript with the frozen comparison.

The original cache-fair report records 13 unique source fetches versus six
RGP setup/acquisition calls. Those are *claims*, not an authenticated tool
transcript. A blank receipt ledger is generated without inventing calls.
A completely filled ledger can only become TRACE_CANDIDATE, never GO;
the source provider's original logs still need independent authentication.

No model runner or third-party Python dependency.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path

from gate_b import ProtocolError, digest_plan, require, strict_json, validate_plan
from gate_b_review import validate_observations

VERSION = "1.0"
HEX = frozenset("0123456789abcdef")
GITHUB_SOURCE_TOOLS = frozenset({
    "mcp__GitHub__fetch_file", "mcp__GitHub__fetch", "mcp__GitHub__fetch_blob",
})
# Exact six operations claimed in the old cache-fair replay.
# These claims do not authenticate themselves.
RGP_OPERATIONS = {
    "rgp": ("corpus_checkpoint", "artifact_listing", "artifact_download", "reader_source"),
    "serde_json": ("artifact_download",),
    "itsdangerous": ("artifact_download",),
}
RGP_TOOLS = {
    "corpus_checkpoint": frozenset({"mcp__GitHub__fetch_file", "mcp__GitHub__fetch"}),
    "artifact_listing": frozenset({"mcp__GitHub__fetch_workflow_run_artifacts", "mcp__GitHub__fetch"}),
    "artifact_download": frozenset({"mcp__GitHub__download_workflow_artifact"}),
    "reader_source": frozenset({"mcp__GitHub__fetch_file", "mcp__GitHub__fetch"}),
}


def make_template(plan: dict, observations: dict) -> dict:
    info = validate_plan(plan)
    rows, accounting = validate_observations(plan, observations)
    cache = observations.get("github_cache")
    require(isinstance(cache, dict), "missing first-use GitHub source accounting")
    fetches = cache.get("source_fetches")
    require(isinstance(fetches, list), "missing pinned GitHub source fetches")
    entries = []
    for entry in fetches:
        require(isinstance(entry, dict), "invalid cached source entry")
        entries.append({
            "task_id": entry["task_id"], "repository": entry["repository"],
            "source_commit": entry["source_commit"], "path": entry["path"],
            "source_url": entry["source_url"],
            "git_blob_sha1": entry["git_blob_sha1"], "receipt": None,
        })
    setup = observations.get("rgp_preparation_calls")
    require(isinstance(setup, dict), "missing RGP preparation accounting")
    rgp = []
    for repo in plan["repositories"]:
        name = repo["id"]
        require(name in RGP_OPERATIONS and len(RGP_OPERATIONS[name]) == setup[name],
                "historical RGP setup operation allocation changed")
        for ordinal, purpose in enumerate(RGP_OPERATIONS[name]):
            rgp.append({"repository": name, "source_commit": repo["commit"],
                        "slot": ordinal + 1, "purpose": purpose, "receipt": None})
    require(len(entries) == accounting["github_calls"] and
            len(rgp) == accounting["rgp_calls_including_preparation"],
            "claimed counts disagree with expected source and setup calls")
    return {
        "schema_version": VERSION, "kind": "gate_b_call_receipt_handoff",
        "plan_sha256": info["plan_sha256"],
        "observations_sha256": digest_plan(observations),
        "github_source_calls": entries, "rgp_acquisition_calls": rgp,
    }


def _hex(value: object, size: int) -> bool:
    return isinstance(value, str) and len(value) == size and all(c in HEX for c in value)


def _validate_receipt(receipt: object, expected_url: str | None,
                      seen: set[str], tools: frozenset[str],
                      purpose: str | None = None) -> bool:
    if receipt is None:
        return False
    require(isinstance(receipt, dict) and set(receipt) ==
            {"call_id", "tool_name", "request_url", "response_sha256", "record_url"},
            "malformed provider receipt")
    call_id = receipt["call_id"]
    require(isinstance(call_id, str) and 8 <= len(call_id) <= 200
            and call_id not in seen, "missing or reused provider call id")
    seen.add(call_id)
    require(receipt["tool_name"] in tools, "unexpected tool type for call")
    url = receipt["request_url"]
    require(isinstance(url, str) and url.startswith("https://github.com/"),
            "untrusted or missing provider request URL")
    if expected_url is not None:
        require(url == expected_url, "provider source request differs from pinned URL")
    else:
        prefix = "https://github.com/iivkis/rgp/"
        require(url.startswith(prefix),
                "RGP setup must reference the approved repository")
        if purpose in ("artifact_listing", "artifact_download"):
            require(url.startswith(prefix + "actions/"),
                    "RGP setup must reference the approved repository Actions run")
        elif purpose == "corpus_checkpoint":
            require("corpus_preparation.json" in url,
                    "RGP checkpoint request must identify the frozen checkpoint")
        elif purpose == "reader_source":
            require("rgp_reader.py" in url,
                    "RGP reader source request must identify the trusted Reader")
    require(_hex(receipt["response_sha256"], 64), "invalid response content digest")
    record_url = receipt["record_url"]
    require(isinstance(record_url, str) and record_url.startswith("https://")
            and len(record_url) <= 2048, "provider audit record URL missing")
    # An untrusted caller can self-author all the above strings. No GO.
    return True


def audit(plan: dict, observations: dict, ledger: dict) -> dict:
    expected = make_template(plan, observations)
    require(isinstance(ledger, dict) and set(ledger) == set(expected),
            "unexpected provider ledger fields")
    for key in ("schema_version", "kind", "plan_sha256", "observations_sha256"):
        require(ledger[key] == expected[key], f"provider ledger {key} mismatch")
    seen = set()
    counts = {}
    for key in ("github_source_calls", "rgp_acquisition_calls"):
        values, expected_rows = ledger[key], expected[key]
        require(isinstance(values, list) and len(values) == len(expected_rows),
                f"{key}: missing or additional claimed calls")
        present = 0
        # Order is part of the frozen first-use and setup-slot attribution.
        for n, (entry, reference) in enumerate(zip(values, expected_rows)):
            require(isinstance(entry, dict) and set(entry) == set(reference),
                    f"{key}[{n}]: missing/extra ledger fields")
            for field in reference:
                if field != "receipt":
                    require(entry[field] == reference[field],
                            f"{key}[{n}]: claimed source/slot changed")
            url = reference.get("source_url")
            purpose = reference.get("purpose")
            tools = GITHUB_SOURCE_TOOLS if purpose is None else RGP_TOOLS[purpose]
            present += int(_validate_receipt(entry["receipt"], url, seen, tools, purpose))
        counts[key] = {"expected": len(expected_rows),
                       "receipts_present": present, "receipts_missing": len(expected_rows) - present}
    total = sum(v["expected"] for v in counts.values())
    found = sum(v["receipts_present"] for v in counts.values())
    return {
        "gate": "B", "status": "HOLD",
        "evidence_state": "TRACE_CANDIDATE_UNAUTHENTICATED" if found == total
                          else "INCOMPLETE_PROVIDER_RECEIPTS",
        "plan_sha256": expected["plan_sha256"],
        "observations_sha256": expected["observations_sha256"],
        **counts,
        "claimed_call_reduction": 1 - counts["rgp_acquisition_calls"]["expected"] /
                                  counts["github_source_calls"]["expected"],
        "verified_connector_call_reduction": None,
        "provider_history_authenticated": False,
        "independent_answer_grading": "NOT_VERIFIED",
        "missing_receipts_total": total - found,
        "reasons": (["provider receipts incomplete"] if found < total else []) + [
            "receipt metadata cannot authenticate itself; compare every event with original tool logs",
            "original 24 answers need independent arm-masked grading",
            "official GO requires external maintainer verification",
        ],
    }


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("command", choices=("template", "audit"))
    p.add_argument("--plan", type=Path, default=Path("benchmarks/gate_b/plan.json"))
    p.add_argument("--observations", type=Path,
                   default=Path("benchmarks/gate_b/observations.cache_fair_2026-10-29.json"))
    p.add_argument("--ledger", type=Path)
    p.add_argument("--output", type=Path)
    args = p.parse_args()
    try:
        plan = strict_json(args.plan)
        obs = strict_json(args.observations)
        if args.command == "template":
            result = make_template(plan, obs)
        else:
            require(args.ledger is not None, "--ledger required")
            result = audit(plan, obs, strict_json(args.ledger))
    except (ProtocolError, ValueError, OSError, KeyError, TypeError) as exc:
        p.error(str(exc))
    data = json.dumps(result, indent=2, ensure_ascii=False, sort_keys=True) + "\n"
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(data, encoding="utf-8")
    print(data, end="")


if __name__ == "__main__":
    main()

FILE	scripts/gate_b_decision.py
#!/usr/bin/env python3
"""One truthful Gate B decision dossier from blinded grading + provider receipts.

This does not run an LLM or authenticate authors/host logs. The decision
remains HOLD unless a maintainer independently verifies external evidence.
Even a fully populated self-authored JSON packet can only be a candidate.
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path

from gate_b import ProtocolError, strict_json
from gate_b_review import review_report
from gate_b_call_audit import audit


def decision(plan: dict, observations: dict, packet: dict,
             review: dict, ledger: dict, source_lines: dict,
             checkpoint: dict) -> dict:
    answer = review_report(plan, observations, packet, review,
                           source_lines, checkpoint)
    calls = audit(plan, observations, ledger)
    reasons = []
    if answer["status"] == "PIVOT":
        reasons.append("submitted reviewer judgments indicate a correctness or call-reduction problem; authenticity requires verification")
    elif answer["status"] != "REVIEW_CANDIDATE":
        reasons.append("all 24 independent blinded answer verdicts are not yet evidenced")
    if calls["missing_receipts_total"]:
        reasons.append(f"{calls['missing_receipts_total']} original provider call receipts missing")
    reasons.append("original provider call log and reviewer identity must be authenticated independently")
    return {
        "gate": "B", "official_status": "HOLD",
        "technical_readiness": (
            "MAINTAINER_VERIFICATION_REQUIRED"
            if answer["status"] == "REVIEW_CANDIDATE"
            and calls["missing_receipts_total"] == 0
            else "BLOCKED"
        ),
        "answer_review": answer,
        "tool_history": calls,
        "independent_provider_history_authenticated": False,
        "reviewer_identity_authenticated": False,
        "external_approval_received": False,
        "reasons": reasons,
        "next_actions": [
            "have an independent reviewer grade all 24 masked answers against pinned sources",
            "retrieve the 19 original GitHub/RGP tool events from an inspectable authenticated provider history",
            "match event IDs, requests, response digests and counts with the frozen cache-fair observations",
            "verify independence, repeated-session comparability and result before any manual GO/PIVOT decision",
        ],
    }


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--plan", type=Path, default=Path("benchmarks/gate_b/plan.json"))
    p.add_argument("--observations", type=Path, default=Path(
        "benchmarks/gate_b/observations.cache_fair_2026-10-29.json"))
    p.add_argument("--source-lines", type=Path, default=Path(
        "benchmarks/gate_b/source_line_counts.json"))
    p.add_argument("--checkpoint", type=Path, default=Path(
        "benchmarks/gate_b/corpus_preparation.json"))
    p.add_argument("--packet", type=Path, required=True)
    p.add_argument("--review", type=Path, required=True)
    p.add_argument("--ledger", type=Path, required=True)
    p.add_argument("--output", type=Path)
    args = p.parse_args()
    try:
        report = decision(
            strict_json(args.plan), strict_json(args.observations),
            strict_json(args.packet), strict_json(args.review),
            strict_json(args.ledger), strict_json(args.source_lines),
            strict_json(args.checkpoint),
        )
    except (ProtocolError, ValueError, KeyError, TypeError, OSError) as exc:
        p.error(str(exc))
    rendered = json.dumps(report, sort_keys=True, indent=2, ensure_ascii=False) + "\n"
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(rendered, encoding="utf-8")
    print(rendered, end="")


if __name__ == "__main__":
    main()

FILE	scripts/gate_b_review.py
#!/usr/bin/env python3
"""Gate B: source-backed, arm-masked independent review handoff (stdlib only).

This checks the *structure* of a reviewer verdict; neither the reviewer identity
nor actual tool-call history can be authenticated by a JSON file. No model run.
"""
from __future__ import annotations

import argparse
from collections import Counter
import hashlib
import json
from pathlib import Path
import secrets

from gate_b import ARMS, HEX, ProtocolError, digest_plan, evaluate, require, strict_json, validate_plan

PACKET_VERSION = "1.0"


def hash_answer(answer: str) -> str:
    return hashlib.sha256(answer.encode("utf-8")).hexdigest()


def validate_observations(plan: dict, observations: dict) -> tuple[dict, dict]:
    info = validate_plan(plan)
    report = evaluate(plan, observations)
    require(observations.get("plan_sha256") == info["plan_sha256"],
            "observations do not match pinned plan")
    require(observations.get("method") == "assistant_in_chat", "wrong observation method")
    require(report["received_observations"] == info["expected_observations"],
            "incomplete paired observations")
    require("github_calls" in report and "rgp_calls_including_preparation" in report,
            "incomplete observation accounting")
    rows = {(r["task_id"], r["arm"]): r for r in observations["observations"]}
    return rows, report


def source_refs(task: dict, repo: dict) -> list[dict]:
    return [{"path": path,
             "url": f'https://github.com/{repo["github"]}/blob/{repo["commit"]}/{path}'}
            for path in task["reference_paths"]]


def make_packet(plan: dict, observations: dict) -> dict:
    rows, _ = validate_observations(plan, observations)
    repos = {repo["id"]: repo for repo in plan["repositories"]}
    tasks = []
    for task in plan["tasks"]:
        order = list(ARMS)
        if secrets.randbelow(2):
            order.reverse()
        answers = []
        for label, arm in zip(("A", "B"), order):
            answer = rows[(task["id"], arm)]["answer"]
            answers.append({"case_id": label, "answer": answer,
                            "answer_sha256": hash_answer(answer)})
        tasks.append({"task_id": task["id"], "repository": task["repository"],
                      "source_commit": repos[task["repository"]]["commit"],
                      "prompt": task["prompt"], "rubric": task["rubric"],
                      "source_refs": source_refs(task, repos[task["repository"]]),
                      "answers": answers})
    return {"schema_version": PACKET_VERSION, "kind": "arm_masked_review_packet",
            "plan_sha256": digest_plan(plan),
            "observations_sha256": digest_plan(observations),
            "nonce": secrets.token_hex(16), "tasks": tasks}


def validate_packet(plan: dict, observations: dict, packet: dict) -> None:
    rows, _ = validate_observations(plan, observations)
    require(isinstance(packet, dict) and packet.get("schema_version") == PACKET_VERSION
            and packet.get("kind") == "arm_masked_review_packet",
            "unsupported review packet")
    require(set(packet) == {"schema_version", "kind", "plan_sha256",
                            "observations_sha256", "nonce", "tasks"},
            "unexpected or missing review packet fields")
    require(packet["plan_sha256"] == digest_plan(plan)
            and packet["observations_sha256"] == digest_plan(observations),
            "review packet provenance mismatch")
    nonce = packet["nonce"]
    require(isinstance(nonce, str) and len(nonce) == 32 and all(c in HEX for c in nonce),
            "invalid packet nonce")
    repos = {repo["id"]: repo for repo in plan["repositories"]}
    items = packet["tasks"]
    require(isinstance(items, list) and len(items) == len(plan["tasks"]),
            "review packet task count mismatch")
    for task, item in zip(plan["tasks"], items):
        require(isinstance(item, dict) and set(item) ==
                {"task_id", "repository", "source_commit", "prompt",
                 "rubric", "source_refs", "answers"}, "malformed review task")
        repo = repos[task["repository"]]
        for field, expected in (
            ("task_id", task["id"]), ("repository", task["repository"]),
            ("source_commit", repo["commit"]), ("prompt", task["prompt"]),
            ("rubric", task["rubric"]), ("source_refs", source_refs(task, repo))
        ):
            require(item[field] == expected, f"review task {task['id']}: altered {field}")
        answers = item["answers"]
        require(isinstance(answers, list) and len(answers) == 2,
                f"review task {task['id']}: missing answers")
        require(all(isinstance(a, dict) and set(a) == {"case_id", "answer", "answer_sha256"}
                    for a in answers), f"review task {task['id']}: malformed answer")
        require([a["case_id"] for a in answers] == ["A", "B"],
                f"review task {task['id']}: invalid case identifiers")
        require(all(isinstance(a["answer"], str)
                    and a["answer_sha256"] == hash_answer(a["answer"])
                    for a in answers), f"review task {task['id']}: answer digest mismatch")
        original = Counter(rows[(task["id"], arm)]["answer"] for arm in ARMS)
        received = Counter(a["answer"] for a in answers)
        require(original == received, f"review task {task['id']}: answer substitution")


def validate_source_line_counts(plan: dict, observations: dict, source_lines: dict,
                                checkpoint: dict | None = None) -> dict:
    """Validate a pinned source line-count index against the planned Git blobs.

    Manifest metadata does not alone prove the underlying source bytes. The
    generator separately checks those bytes against independently pinned
    RGP SHA-256 and Git blob SHA-1 values.
    """
    rows, _ = validate_observations(plan, observations)
    require(isinstance(source_lines, dict) and
            source_lines.get("schema_version") == "1.0" and
            source_lines.get("method") == "verified_pinned_rgp_reader_plus_git_blob_sha1" and
            source_lines.get("plan_sha256") == digest_plan(plan),
            "invalid source-line index")
    sha_map = source_lines.get("source_rgp_sha256")
    require(isinstance(sha_map, dict), "missing source RGP SHA-256 anchors")
    repos = {repo["id"]: repo for repo in plan["repositories"]}
    require(set(sha_map) == set(repos) and
            all(isinstance(s, str) and len(s) == 64 and all(c in HEX for c in s)
                for s in sha_map.values()), "invalid source RGP SHA-256 anchors")
    if checkpoint is not None:
        require(isinstance(checkpoint, dict) and isinstance(checkpoint.get("artifacts"), list),
                "invalid corpus checkpoint")
        expected_shas = {
            r["repository"]: r["sha256"] for r in checkpoint["artifacts"]
            if isinstance(r, dict) and isinstance(r.get("repository"), str)
        }
        require(sha_map == expected_shas, "source-line RGP SHA-256 checkpoint mismatch")
    files = source_lines.get("files")
    require(isinstance(files, list), "source-line files must be a list")
    expected = {}
    for task in plan["tasks"]:
        tid, rid = task["id"], task["repository"]
        row = rows[(tid, ARMS[0])]
        evidence = row.get("source_evidence")
        require(isinstance(evidence, dict), f"task {tid}: source anchors missing")
        for path in task["reference_paths"]:
            require(path in evidence and isinstance(evidence[path], dict) and
                    isinstance(evidence[path].get("git_blob_sha1"), str),
                    f"task {tid}: source anchor missing for {path}")
            key = (rid, path)
            sha = evidence[path]["git_blob_sha1"]
            require(key not in expected or expected[key] == sha,
                    f"task {tid}: conflicting pinned blob SHA-1")
            expected[key] = sha
    require(len(files) == len(expected), "source-line index incomplete or has extra entries")
    seen = {}
    for i, entry in enumerate(files):
        require(isinstance(entry, dict) and set(entry) ==
                {"repository", "source_commit", "path", "git_blob_sha1", "line_count"},
                f"source-line index entry {i}: malformed")
        rid, path = entry["repository"], entry["path"]
        require(isinstance(rid, str) and isinstance(path, str),
                f"source-line index entry {i}: invalid repository/path")
        key = (rid, path)
        require(key in expected and key not in seen, "unknown/duplicate source-line entry")
        require(entry["source_commit"] == repos[rid]["commit"] and
                entry["git_blob_sha1"] == expected[key],
                f"source-line index {rid}/{path}: wrong pinned source")
        count = entry["line_count"]
        require(type(count) is int and 1 <= count <= 10_000_000,
                f"source-line index {rid}/{path}: invalid line count")
        seen[key] = count
    require(set(seen) == set(expected), "source-line index missing source")
    return seen


def blank_review(packet: dict) -> dict:
    return {"schema_version": PACKET_VERSION,
            "packet_sha256": digest_plan(packet),
            "reviewer": {"id": "", "independent_of_observation_author": False,
                         "review_record_url": ""},
            "judgments": [
                {"task_id": item["task_id"], "case_id": answer["case_id"],
                 "correct": None, "evidence": [], "rationale": ""}
                for item in packet["tasks"] for answer in item["answers"]
            ]}


def review_report(plan: dict, observations: dict, packet: dict, review: dict,
                  source_lines: dict | None = None,
                  checkpoint: dict | None = None) -> dict:
    validate_packet(plan, observations, packet)
    rows, accounting = validate_observations(plan, observations)
    line_bounds = (validate_source_line_counts(plan, observations, source_lines, checkpoint)
                   if source_lines is not None else None)
    require(isinstance(review, dict) and review.get("schema_version") == PACKET_VERSION,
            "unsupported review")
    require(review.get("packet_sha256") == digest_plan(packet),
            "review is not bound to this exact masked packet")
    judgments = review.get("judgments")
    require(isinstance(judgments, list), "judgments must be a list")
    expected = {(item["task_id"], a["case_id"])
                for item in packet["tasks"] for a in item["answers"]}
    tasks = {item["task_id"]: item for item in packet["tasks"]}
    seen = {}
    incomplete = []
    for i, row in enumerate(judgments):
        require(isinstance(row, dict), f"judgment {i}: not an object")
        tid, case = row.get("task_id"), row.get("case_id")
        require(isinstance(tid, str) and isinstance(case, str)
                and (tid, case) in expected and (tid, case) not in seen,
                f"judgment {i}: unknown or duplicate case")
        require(type(row.get("correct")) is bool or row.get("correct") is None,
                f"judgment {i}: correct must be boolean or null")
        evidence = row.get("evidence")
        require(isinstance(evidence, list), f"judgment {i}: evidence must be a list")
        rationale = row.get("rationale")
        require(isinstance(rationale, str), f"judgment {i}: rationale must be text")
        if row["correct"] is None:
            incomplete.append((tid, case))
        else:
            allowed = {x["path"] for x in tasks[tid]["source_refs"]}
            paths = set()
            for entry in evidence:
                require(isinstance(entry, dict), f"judgment {i}: evidence entry not object")
                path, start, end = (entry.get(k) for k in ("path", "start_line", "end_line"))
                require(isinstance(path, str) and path in allowed
                        and type(start) is int and type(end) is int
                        and 1 <= start <= end, f"judgment {i}: invalid source line evidence")
                if line_bounds is not None:
                    rid = tasks[tid]["repository"]
                    require(end <= line_bounds[(rid, path)],
                            f"judgment {i}: source line evidence out of bounds for {path}")
                paths.add(path)
            require(paths == allowed, f"judgment {i}: not all required source paths cited")
            require(len(rationale.strip()) >= 15,
                    f"judgment {i}: missing substantive rationale")
        seen[(tid, case)] = row
    incomplete.extend(sorted(expected - set(seen)))
    reviewer = review.get("reviewer")
    require(isinstance(reviewer, dict), "reviewer must be an object")
    reviewer_id = reviewer.get("id")
    independent = reviewer.get("independent_of_observation_author") is True
    url = reviewer.get("review_record_url")
    identified = (isinstance(reviewer_id, str) and bool(reviewer_id.strip())
                  and reviewer_id.strip().lower() not in ("assistant", "assistant-in-chat")
                  and isinstance(url, str) and url.startswith("https://"))
    summary = {"gate": "B", "status": "HOLD", "reviewed": len(expected) - len(incomplete),
               "expected": len(expected), "missing": len(incomplete),
               "reviewer_independence": "self_declared_unverified",
               "connector_calls": {"github": accounting["github_calls"],
                                   "rgp": accounting["rgp_calls_including_preparation"]},
               "call_reduction": accounting["call_reduction"],
               "reasons": []}
    if incomplete:
        summary["reasons"].append("independent verdicts incomplete")
    if not identified or not independent:
        summary["reasons"].append("independent reviewer declaration or review record missing")
    if line_bounds is None:
        summary["reasons"].append("verified source-line index required before candidate review")
    if summary["reasons"]:
        return summary

    graded = {}
    for item in packet["tasks"]:
        tid = item["task_id"]
        # Match the exact answer text, not a claimed arm label in reviewer input.
        for arm in ARMS:
            answer = rows[(tid, arm)]["answer"]
            cases = [a["case_id"] for a in item["answers"] if a["answer"] == answer]
            verdicts = {seen[(tid, case)]["correct"] for case in cases}
            require(len(verdicts) == 1, f"review task {tid}: same answer received conflicting grades")
            graded[(tid, arm)] = verdicts.pop()
    incorrect = [t["id"] for t in plan["tasks"] if not graded[(t["id"], ARMS[1])]]
    regressions = [t["id"] for t in plan["tasks"] if graded[(t["id"], ARMS[0])]
                   and not graded[(t["id"], ARMS[1])]]
    summary["rgp_incorrect_tasks"] = incorrect
    summary["correctness_regressions"] = regressions
    if incorrect:
        summary["reasons"].append("independent review found incorrect RGP answers")
    if regressions:
        summary["reasons"].append("independent review found RGP correctness regressions")
    if accounting["call_reduction"] is None or accounting["call_reduction"] < 0.30:
        summary["reasons"].append("connector-call reduction below 30%")
    summary["status"] = "PIVOT" if summary["reasons"] else "REVIEW_CANDIDATE"
    if summary["status"] == "REVIEW_CANDIDATE":
        summary["reasons"].append("independence and connector history still require external verification")
    return summary


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("pack", "template", "check"))
    parser.add_argument("--plan", type=Path, default=Path("benchmarks/gate_b/plan.json"))
    parser.add_argument("--observations", type=Path, default=Path(
        "benchmarks/gate_b/observations.cache_fair_2026-10-29.json"))
    parser.add_argument("--packet", type=Path)
    parser.add_argument("--review", type=Path)
    parser.add_argument("--source-lines", type=Path,
                        default=Path("benchmarks/gate_b/source_line_counts.json"))
    parser.add_argument("--corpus-checkpoint", type=Path,
                        default=Path("benchmarks/gate_b/corpus_preparation.json"))
    args = parser.parse_args()
    try:
        plan, observations = strict_json(args.plan), strict_json(args.observations)
        if args.command == "pack":
            result = make_packet(plan, observations)
        else:
            require(args.packet is not None, "--packet required")
            packet = strict_json(args.packet)
            validate_packet(plan, observations, packet)
            if args.command == "template":
                result = blank_review(packet)
            else:
                require(args.review is not None, "--review required")
                result = review_report(plan, observations, packet, strict_json(args.review),
                                       strict_json(args.source_lines),
                                       strict_json(args.corpus_checkpoint))
    except (ProtocolError, OSError, ValueError, KeyError, TypeError) as exc:
        parser.error(str(exc))
    print(json.dumps(result, indent=2, ensure_ascii=False, sort_keys=True))


if __name__ == "__main__":
    main()

