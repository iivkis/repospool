"""Frozen 12-task context plan and explicit no-answer-claim guardrails."""
import json
import sys
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))
sys.path.insert(0, str(ROOT / "python"))
from stage1_agent_task_pilot import TERMS  # noqa: E402
from rgp_agent_context import context, compact_json  # noqa: E402
from test_reader_api import three_scope_artifact  # noqa: E402
from rgp_reader import Reader  # noqa: E402


class FrozenTaskPilotTests(unittest.TestCase):
    def test_exact_pre_registered_twelve_tasks(self):
        plan = json.loads((ROOT / "benchmarks/gate_b/plan.json").read_text())
        self.assertEqual(set(TERMS), {t["id"] for t in plan["tasks"]})
        self.assertEqual(len(TERMS), 12)
        for task in plan["tasks"]:
            with self.subTest(task=task["id"]):
                terms = TERMS[task["id"]]
                self.assertTrue(1 <= len(terms) <= 6)
                self.assertEqual(len(terms), len(set(terms)))
                self.assertTrue(all(isinstance(t, str) and 1 <= len(t.encode()) <= 128
                                    for t in terms))
        self.assertEqual(
            {r: sum(t["repository"] == r for t in plan["tasks"])
             for r in ("rgp", "serde_json", "itsdangerous")},
            {"rgp": 4, "serde_json": 4, "itsdangerous": 4})

    def test_missing_term_is_not_disguised_as_source_evidence(self):
        result = context(Reader(three_scope_artifact()),
                         ["needle", "SOME_NOT_EXISTING_METHOD"], max_bytes=2048)
        self.assertEqual(result["terms_without_source"], ["SOME_NOT_EXISTING_METHOD"])
        self.assertTrue(result["sources"])
        self.assertLessEqual(len(compact_json(result).encode("utf-8")), 2048)

    def test_each_requested_term_gets_evidence_before_repeats(self):
        reader = Reader(three_scope_artifact())
        result = context(reader, ["needle", "again"], prefix="src/")
        self.assertEqual(result["terms_without_source"], [])
        selected = {s["match_term"] for s in result["sources"]
                    if s["path"] == "src/a.py"}
        self.assertEqual(selected, {"needle", "again"})


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_stage1_corpus.py
"""Offline contract tests for the Stage 1 pinned-corpus acceptance.

No network access, model API or external repositories required.
"""
import copy
import importlib.util
import json
import sys
import tempfile
import unittest
from pathlib import Path
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))
spec = importlib.util.spec_from_file_location("stage1_corpus", ROOT / "scripts/stage1_corpus.py")
corpus = importlib.util.module_from_spec(spec)
spec.loader.exec_module(corpus)
PLAN = json.loads((ROOT / "benchmarks/gate_b/plan.json").read_text())


class Stage1CorpusTests(unittest.TestCase):
    def test_all_frozen_task_paths_have_predeclared_anchors(self):
        self.assertEqual(len(corpus.ANCHORS), 12)
        for repo_id in ("rgp", "serde_json", "itsdangerous"):
            repo, tasks = corpus.tasks_for(PLAN, repo_id)
            self.assertEqual(repo["id"], repo_id)
            self.assertEqual(len(tasks), 4)
            for task in tasks:
                self.assertEqual(set(corpus.ANCHORS[task["id"]]), set(task["reference_paths"]))

    def test_rejects_new_task_without_anchor(self):
        plan = copy.deepcopy(PLAN)
        plan["tasks"][0]["id"] = "renamed-task"
        with self.assertRaisesRegex(ValueError, "anchor task ids"):
            corpus.tasks_for(plan, "rgp")

    def test_rejects_missing_reference_path_anchor(self):
        original = corpus.ANCHORS["rgp-transport-hash"]
        try:
            corpus.ANCHORS["rgp-transport-hash"] = {"src/main.rs": ("payload_sha256=",)}
            with self.assertRaisesRegex(ValueError, "anchor paths missing"):
                corpus.tasks_for(PLAN, "rgp")
        finally:
            corpus.ANCHORS["rgp-transport-hash"] = original

    def test_unknown_repository_rejected(self):
        with self.assertRaisesRegex(ValueError, "unknown repository"):
            corpus.tasks_for(PLAN, "unknown")

    def test_existing_corpus_checkpoint_requires_exact_bytes_and_commit(self):
        checkpoints = json.loads(
            (ROOT / "benchmarks/gate_b/corpus_preparation.json").read_text()
        )
        for item in checkpoints["artifacts"]:
            summary = {"repository": item["repository"],
                       "source_commit": item["source_commit"],
                       "rgp_sha256": item["sha256"],
                       "rgp_bytes": item["rgp_bytes"],
                       "included_files": item["included_files"]}
            corpus.match_checkpoint(checkpoints, summary)
            damaged = dict(summary)
            damaged["rgp_sha256"] = "0" * 64
            with self.assertRaisesRegex(ValueError, "compatibility regression"):
                corpus.match_checkpoint(checkpoints, damaged)

    def test_new_transport_keeps_source_guard_without_fake_legacy_hash_parity(self):
        checkpoints = json.loads(
            (ROOT / "benchmarks/gate_b/corpus_preparation.json").read_text()
        )
        pinned = checkpoints["artifacts"][0]
        summary = {
            "repository": pinned["repository"],
            "source_commit": pinned["source_commit"],
            "included_files": pinned["included_files"],
            "transport_version": "RGP/1.1",
            "rgp_sha256": "1" * 64,
            "rgp_bytes": pinned["rgp_bytes"] + 1300,
        }
        self.assertEqual(corpus.match_checkpoint(checkpoints, summary),
                         "SOURCE_EQUIVALENCE_ONLY")
        damaged = dict(summary, source_commit="0" * 40)
        with self.assertRaisesRegex(ValueError, "compatibility regression"):
            corpus.match_checkpoint(checkpoints, damaged)
        with self.assertRaisesRegex(ValueError, "unsupported transport checkpoint"):
            corpus.match_checkpoint(checkpoints, dict(summary, transport_version="RGP/9.0"))

    def test_generator_failure_is_a_failure_not_success(self):
        with tempfile.TemporaryDirectory() as td:
            path = Path(td) / "invalid-time"
            with self.assertRaises(RuntimeError):
                corpus.measured(["/bin/false"], path)

    def test_measurement_parsing_requires_complete_receipt(self):
        with tempfile.TemporaryDirectory() as td:
            path = Path(td) / "receipt"
            with patch.object(corpus, "execute", side_effect=lambda args: path.write_text("12\n")):
                with self.assertRaisesRegex(ValueError, "two metrics"):
                    corpus.measured(["/bin/true"], path)


if __name__ == "__main__":
    unittest.main()

