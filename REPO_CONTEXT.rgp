FILE	"python/rgp_agent_context.py"	7389	73b18c579a91388b122a3a0e77412244263df7ac9342fdb53daede35df729932
#!/usr/bin/env python3
"""Small, source-grounded context handoff for a human or LLM coding agent.

This is deliberately lexical: the model chooses terms, this process finds
source with the trusted stdlib Reader. It never infers a dependency graph,
runs archived source code, or claims that a code snippet is an answer.
All output is bounded and can be cited as path:start-end at a pinned commit.
"""
from __future__ import annotations

import argparse
import json
from collections import defaultdict
from pathlib import Path

from rgp_reader import Reader, RgpError

MAX_TERMS = 6
MAX_SEARCH = 100
MAX_FILES = 6
MAX_BYTES = 64 * 1024


def compact_json(value: dict) -> str:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def context(reader: Reader, terms: list[str], *, prefix: str = "",
            max_files: int = 4, max_bytes: int = 12_000) -> dict:
    try:
        invalid_terms = not 1 <= len(terms) <= MAX_TERMS or any(
            not isinstance(term, str) or not 1 <= len(term.encode("utf-8")) <= 128
            for term in terms
        )
    except UnicodeEncodeError:
        invalid_terms = True
    if invalid_terms:
        raise ValueError("give 1-6 literal search terms, each 1-128 UTF-8 bytes")
    if not isinstance(max_files, int) or not 1 <= max_files <= MAX_FILES:
        raise ValueError("max_files must be within 1..6")
    if not isinstance(max_bytes, int) or not 2048 <= max_bytes <= MAX_BYTES:
        raise ValueError("max_bytes must be within 2048..65536")

    state = reader.overview()
    hits: dict[str, list[tuple[str, int, str]]] = defaultdict(list)
    incomplete = []
    total_matches = 0
    for term in dict.fromkeys(terms):
        result = reader.search(term, prefix=prefix, limit=MAX_SEARCH)
        if result["next_cursor"] is not None:
            incomplete.append(term)
        total_matches += len(result["matches"])
        for hit in result["matches"]:
            hits[hit["path"]].append((term, hit["line"], hit["excerpt"]))

    ordered_paths = sorted(
        hits, key=lambda path: (
            -len({term for term, _, _ in hits[path]}),
            -len(hits[path]), path,
        )
    )
    response = {
        "kind": "rgp_agent_source_context",
        "source_commit": state["source_commit"],
        "snapshot_complete": state["snapshot_complete"],
        "index_coverage": reader.coverage("index")["status"],
        "graph_coverage": reader.coverage("graph")["status"],
        "retrieval": "lexical_not_semantic",
        "terms": list(dict.fromkeys(terms)),
        "prefix": prefix,
        "max_output_bytes": max_bytes,
        "search_hits_observed": total_matches,
        "search_capped_terms": incomplete,
        "candidate_paths": len(ordered_paths),
        "sources": [],
        "selection_truncated": False,
        "source_instructions_untrusted": True,
    }

    for path in ordered_paths[:max_files]:
        seen_lines = set()
        # Diversity matters more than repetition: 'serialize_i64'
        # may match several implementations before we reach f64/str.
        # Give each distinct term one source passage first, then fill
        # spare slots with additional matches in original search order.
        first_per_term = {}
        for hit in hits[path]:
            first_per_term.setdefault(hit[0], hit)
        prioritized = list(first_per_term.values())
        prioritized += [hit for hit in hits[path] if hit not in prioritized]
        for term, number, excerpt in prioritized:
            if number in seen_lines:
                continue
            seen_lines.add(number)
            # A short read gives the LLM the surrounding source, not just
            # a keyword match. An EOF-adjacent match can be read through
            # the exact hit line rather than asking beyond EOF.
            begin = max(1, number - 2)
            end = number + 7
            try:
                text = reader.read(path, begin, end)
            except RgpError as error:
                if error.code != "UNSUPPORTED_FORMAT":
                    raise
                try:
                    text = reader.read(path, begin, number)
                except RgpError:
                    # A long binary file or oversized result is not
                    # silently converted into a valid source quotation.
                    continue
            if text.get("encoding") != "utf-8":
                continue
            source = {
                "path": path,
                "match_term": term,
                "match_line": number,
                "start_line": text["start_line"],
                "end_line": text["end_line"],
                "content": text["content"],
                "source_reference": f"{path}:{text['start_line']}-{text['end_line']}",
            }
            response["sources"].append(source)
            if len(compact_json(response).encode("utf-8")) > max_bytes:
                response["sources"].pop()
                response["selection_truncated"] = True
                break
            if sum(s["path"] == path for s in response["sources"]) >= 4:
                break
        if response["selection_truncated"]:
            break

    response["selection_truncated"] = (
        response["selection_truncated"] or len(ordered_paths) > max_files
        or total_matches > len(response["sources"])
    )
    while len(compact_json(response).encode("utf-8")) > max_bytes and response["sources"]:
        response["sources"].pop()
        response["selection_truncated"] = True
    # Source-coverage is a separate dimension from query match count.
    # A search term may match a file yet have no *selected* source in
    # the agent prompt. Never present that as a grounded answer.
    selected = {source["match_term"] for source in response["sources"]}
    response["terms_without_source"] = [
        term for term in response["terms"] if term not in selected
    ]
    while len(compact_json(response).encode("utf-8")) > max_bytes and response["sources"]:
        response["sources"].pop()
        response["selection_truncated"] = True
        selected = {source["match_term"] for source in response["sources"]}
        response["terms_without_source"] = [
            term for term in response["terms"] if term not in selected
        ]
    # No answer correctness is inferred from a successful lexical hit.
    # Never label a no-match or truncated search 'source absent'.
    return response


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--artifact", required=True, type=Path)
    parser.add_argument("--term", required=True, action="append", dest="terms")
    parser.add_argument("--prefix", default="")
    parser.add_argument("--max-files", type=int, default=4)
    parser.add_argument("--max-bytes", type=int, default=12_000)
    args = parser.parse_args()
    try:
        result = context(Reader(args.artifact), args.terms,
                         prefix=args.prefix, max_files=args.max_files,
                         max_bytes=args.max_bytes)
    except (RgpError, ValueError) as exc:
        parser.exit(2, f"{exc}\n")
    # Emit exactly the budgeted JSON bytes: pretty-printing would
    # silently exceed --max-bytes even when source selection did not.
    print(compact_json(result), end="")


if __name__ == "__main__":
    main()

FILE	"python/rgp_bootstrap.py"	7121	80684933de72c2ec46a1b8b1214038b660d162d67d8f3ea80f7a397acd3e624b
"""Trusted stdlib bootstrap for GitHub Actions ZIPs containing one RGP artifact.

This is an explicitly selected *transport adapter*, not the RGP file format.
No Python code or shell commands from the archive are ever executed.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
import tempfile
import zipfile
from pathlib import Path

from rgp_reader import MAX_ARTIFACT, MAX_RATIO, Reader, RgpError, _require

HEX = re.compile(r"[0-9a-f]{64}\Z")


def bootstrap(zip_path: Path, output: Path, trusted_sha256: str | None = None) -> dict:
    """Verify and atomically emit a trusted-Reader-compatible .rgp file.

    The co-packed `expected.json` is an integrity cross-check ONLY, not a
    trusted authenticity assertion. Pass a separately verified trusted SHA to
    authenticate the RGP bytes against an external trust anchor.
    """
    if trusted_sha256 is not None:
        _require(bool(HEX.fullmatch(trusted_sha256)), "UNSUPPORTED_FORMAT", "invalid trusted SHA-256")
    _require(zip_path.stat().st_size <= 2 * MAX_ARTIFACT, "RESOURCE_LIMIT", "ZIP wrapper too large")
    try:
        with zipfile.ZipFile(zip_path) as archive:
            files = archive.infolist()
            _require(1 <= len(files) <= 2, "UNSUPPORTED_FORMAT", "expected one RGP and optional manifest")
            seen: set[str] = set()
            names = set()
            for info in files:
                name = info.filename
                _require(
                    bool(name) and "/" not in name and "\\" not in name and
                    name not in (".", "..") and not any(ord(c) < 32 or ord(c) == 127 for c in name),
                    "UNSAFE_PATH", "unsafe Actions ZIP entry",
                )
                _require(name.casefold() not in seen, "UNSAFE_PATH", "duplicate Actions ZIP entry")
                seen.add(name.casefold())
                # Reject symlinks; all supported members are ordinary file bytes.
                mode = (info.external_attr >> 16) & 0o170000
                _require(mode not in (0o120000, 0o040000), "UNSAFE_PATH", "non-file ZIP entry")
                _require(info.file_size <= 2 * MAX_ARTIFACT, "RESOURCE_LIMIT", "ZIP entry too large")
                _require(info.file_size <= max(4096, info.compress_size * MAX_RATIO), "RESOURCE_LIMIT", "ZIP compression ratio")
                names.add(name)
            rgps = [n for n in names if n.endswith(".rgp")]
            _require(
                len(rgps) == 1 and names - set(rgps) <= {"expected.json", "provenance.json"},
                "UNSUPPORTED_FORMAT", "unexpected Actions artifact files",
            )
            artifact_name = rgps[0]
            received = archive.read(artifact_name)
            _require(len(received) <= 2 * MAX_ARTIFACT, "RESOURCE_LIMIT", "RGP too large")
            digest = hashlib.sha256(received).hexdigest()
            provenance = None
            if "provenance.json" in names:
                meta_info = archive.getinfo("provenance.json")
                _require(meta_info.file_size <= 64 * 1024, "RESOURCE_LIMIT", "provenance.json too large")
                try:
                    provenance = json.loads(archive.read("provenance.json"))
                except (ValueError, UnicodeDecodeError) as exc:
                    raise RgpError("UNSUPPORTED_FORMAT", "invalid provenance.json") from exc
                _require(isinstance(provenance, dict), "UNSUPPORTED_FORMAT", "provenance.json shape")
                _require(provenance.get("rgp_sha256") == digest, "HASH_MISMATCH", "provenance RGP SHA-256")
                _require(type(provenance.get("rgp_bytes")) is int and
                         provenance["rgp_bytes"] == len(received), "HASH_MISMATCH", "provenance RGP bytes")
                _require(isinstance(provenance.get("plan_sha256"), str) and
                         bool(HEX.fullmatch(provenance["plan_sha256"])),
                         "UNSUPPORTED_FORMAT", "provenance benchmark plan SHA-256")
                _require(provenance.get("transport_verified") is False,
                         "UNSUPPORTED_FORMAT", "producer must not claim connector delivery")
            if "expected.json" in names:
                meta = archive.getinfo("expected.json")
                _require(meta.file_size <= 64 * 1024, "RESOURCE_LIMIT", "expected.json too large")
                try:
                    records = json.loads(archive.read("expected.json"))
                except (ValueError, UnicodeDecodeError) as exc:
                    raise RgpError("UNSUPPORTED_FORMAT", "invalid expected.json") from exc
                _require(isinstance(records, list) and len(records) == 1, "UNSUPPORTED_FORMAT", "expected.json shape")
                expected = records[0]
                _require(isinstance(expected, dict), "UNSUPPORTED_FORMAT", "expected.json row")
                _require(expected.get("file") == artifact_name, "HASH_MISMATCH", "expected.json filename")
                _require(expected.get("transport_bytes") == len(received), "HASH_MISMATCH", "expected.json RGP size")
                _require(expected.get("transport_sha256") == digest, "HASH_MISMATCH", "expected.json RGP hash")
    except (zipfile.BadZipFile, RuntimeError, EOFError) as exc:
        raise RgpError("UNSUPPORTED_FORMAT", "invalid Actions ZIP wrapper") from exc
    _require(trusted_sha256 is None or trusted_sha256 == digest, "HASH_MISMATCH", "external trusted SHA-256")
    reader = Reader(received)
    if provenance is not None:
        _require(provenance.get("source_commit") == reader.manifest["source_commit"],
                 "HASH_MISMATCH", "provenance source commit")
        overview = provenance.get("reader_overview")
        _require(isinstance(overview, dict) and
                 overview.get("input_tree_digest") == reader.manifest["input_tree_digest"] and
                 overview.get("file_count") == len(reader.manifest["files"]),
                 "HASH_MISMATCH", "provenance snapshot metadata")
    result = reader.validate()
    output.parent.mkdir(parents=True, exist_ok=True)
    name = None
    try:
        with tempfile.NamedTemporaryFile(dir=output.parent, prefix=".rgp-", suffix=".tmp", delete=False) as temp:
            name = temp.name
            temp.write(received)
        os.replace(name, output)
    finally:
        if name is not None and os.path.exists(name):
            os.unlink(name)
    return {"artifact": str(output), "bytes": len(received), "sha256": digest, **result}


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--actions-zip", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--trusted-sha256")
    args = parser.parse_args()
    try:
        result = bootstrap(args.actions_zip, args.output, args.trusted_sha256)
        print(json.dumps(result, indent=2))
    except (RgpError, OSError) as exc:
        print(f"BOOTSTRAP_ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc


if __name__ == "__main__":
    main()

