"""SQLite is a future optional read-only index; validate its schema in stdlib."""
import sqlite3
import unittest
from pathlib import Path

SCHEMA = (Path(__file__).resolve().parents[1] / "schema.sql").read_text(encoding="utf-8")
DIGEST = "a" * 64


class IndexSchemaTests(unittest.TestCase):
    def setUp(self):
        self.db = sqlite3.connect(":memory:")
        self.db.executescript(SCHEMA)
        self.db.execute("INSERT INTO snapshot VALUES (1, '1.0', ?, ?)", ("c" * 40, DIGEST))
        self.db.execute(
            "INSERT INTO files VALUES ('src/app.py', '100644', 'file', 8, ?, ?, 'included')",
            (DIGEST, "files/" + DIGEST),
        )
        self.db.execute(
            "INSERT INTO analysis_runs VALUES ('run-1', 'test', '0.1', '{}', 'parsed', ?)",
            (DIGEST,),
        )
        self.db.execute(
            "INSERT INTO symbols VALUES ('sym-1', 'src/app.py', 'f', 'function', 1, 0, 1, 8, 'run-1', 'confirmed_reference')"
        )

    def tearDown(self):
        self.db.close()

    def test_schema_version_and_foreign_keys(self):
        self.assertEqual(self.db.execute("PRAGMA user_version").fetchone()[0], 1)
        self.assertEqual(self.db.execute("PRAGMA foreign_keys").fetchone()[0], 1)
        self.assertEqual(self.db.execute("PRAGMA integrity_check").fetchone()[0], "ok")
        self.assertEqual(self.db.execute("PRAGMA foreign_key_check").fetchall(), [])

    def test_resolved_relation_provenance(self):
        self.db.execute(
            """INSERT INTO relations
            (relation_id, relation_type, source_path, source_symbol_id, target_symbol_id,
             evidence_path, start_line, start_column, end_line, end_column, run_id,
             evidence, confidence_kind)
            VALUES ('r1', 'references', 'src/app.py', 'sym-1', 'sym-1',
                    'src/app.py', 1, 0, 1, 8, 'run-1', 'symbol occurrence', 'confirmed_reference')"""
        )
        self.assertEqual(
            self.db.execute("SELECT confidence_kind FROM relations WHERE target_symbol_id = 'sym-1'").fetchone()[0],
            "confirmed_reference",
        )

    def test_unresolved_target_cannot_be_marked_confirmed(self):
        with self.assertRaises(sqlite3.IntegrityError):
            self.db.execute(
                """INSERT INTO relations
                (relation_id, relation_type, source_path, unresolved_target,
                 evidence_path, start_line, start_column, end_line, end_column,
                 run_id, evidence, confidence_kind)
                VALUES ('r2', 'calls', 'src/app.py', 'maybe', 'src/app.py',
                        1, 0, 1, 8, 'run-1', 'guess', 'confirmed_reference')"""
            )

    def test_unknown_symbol_and_wrong_layer_rejected(self):
        with self.assertRaises(sqlite3.IntegrityError):
            self.db.execute(
                "INSERT INTO symbols VALUES ('bad', 'missing.py', 'f', 'function', 1, 0, 1, 2, 'run-1', 'unknown')"
            )
        with self.assertRaises(sqlite3.IntegrityError):
            self.db.execute("INSERT INTO coverage(layer,scope,status) VALUES ('understanding','all','available')")

    def test_independent_coverage_layers(self):
        for layer, status in [("snapshot", "available"), ("index", "not_indexed"),
                              ("graph", "unknown"), ("investigation", "unknown")]:
            self.db.execute("INSERT INTO coverage(layer, scope, status) VALUES (?, 'all', ?)", (layer, status))
        self.assertEqual(
            self.db.execute("SELECT layer FROM coverage ORDER BY layer").fetchall(),
            [("graph",), ("index",), ("investigation",), ("snapshot",)],
        )


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_lean_reader.py
"""RGP/3.0 independent hash-free, token-lean reader vectors."""
import sys
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "python"))
from rgp_reader import Reader, RgpError  # noqa: E402


def artifact(files=None, ignored=2, excluded=None):
    if files is None:
        files = {
            "src/example.py": b'print("END RGP\\nFILE\\tgotcha")\r\n',
            "src/unicode.txt": "Привет!\n".encode("utf-8"),
        }
    excluded = excluded or []
    guide = b"Read only relevant source and verify provenance from trusted Git."
    index = "".join(f"F\t{path}\t{len(raw)}\n" for path, raw in sorted(files.items()))
    if ignored:
        index += f"I\t{ignored}\n"
    index += "S\t1\n"
    index += "".join(f"X\t{name}\t{reason}\n" for name, reason in excluded)
    result = (f"RGP/3.0\nguide_bytes={len(guide)}\nindex_bytes={len(index.encode())}\n--\n"
              ).encode() + guide + b"\n" + index.encode() + b"\n"
    for path, raw in sorted(files.items()):
        result += f"FILE\t{path}\n".encode() + raw + b"\n"
    return result + b"END RGP\n"


class LeanTransportTest(unittest.TestCase):
    def test_no_embedded_hashes_and_original_content(self):
        raw = artifact()
        self.assertTrue(raw.startswith(b"RGP/3.0\n"))
        for token in (b"sha256", b"source_commit", b"manifest_length", b"input_tree_digest",
                      b"payload_sha256", b"base64_line_width", b'"blob"'):
            self.assertNotIn(token, raw)
        self.assertNotIn(b"PK\x03\x04", raw)
        reader = Reader(raw)
        overview = reader.overview()
        self.assertIsNone(overview["source_commit"])
        self.assertEqual(overview["transport"], "RGP/3.0")
        self.assertEqual(overview["intentionally_ignored_files"], 2)
        self.assertEqual(overview["self_artifact_excluded"], 1)
        self.assertTrue(overview["snapshot_complete"])
        self.assertTrue(reader.validate()["valid"])
        self.assertEqual(reader.read_bytes("src/example.py"),
                         b'print("END RGP\\nFILE\\tgotcha")\r\n')
        self.assertEqual(reader.search("Привет")["matches"][0]["line"], 1)
        self.assertEqual(reader.tree()["paths"], ["src/example.py", "src/unicode.txt"])

    def test_nonignored_exclusions_make_partial(self):
        r = Reader(artifact(excluded=[("sensitive/.env", "sensitive_path")]))
        self.assertFalse(r.overview()["snapshot_complete"])
        self.assertEqual(r.overview()["excluded_files"], 1)

    def test_bounds_and_delimiters_reject_corruption(self):
        raw = artifact()
        for changed, code in (
            (raw[:-8], "TRUNCATED_ARTIFACT"),
            (raw.replace(b"index_bytes=", b"index_bytes=999999999", 1), "RESOURCE_LIMIT"),
            (raw.replace(b"FILE\tsrc/example.py", b"F1LE\tsrc/example.py", 1),
             "UNSUPPORTED_FORMAT"),
            (raw.replace(b"RGP/3.0", b"RGP/9.0", 1), "UNSUPPORTED_FORMAT"),
            (raw + b"\xff", "UNSUPPORTED_FORMAT"),
        ):
            with self.subTest(code=code):
                with self.assertRaisesRegex(RgpError, code):
                    Reader(changed)

    def test_equal_length_tamper_is_not_authenticated_without_external_git(self):
        raw = artifact({"file.py": b"answer = 42\n"}, ignored=0)
        changed = raw.replace(b"answer = 42", b"answer = 43")
        self.assertEqual(Reader(changed).read_bytes("file.py"), b"answer = 43\n")
        # This is an explicit security trade-off. The full Git blob hash
        # MUST be verified independently before treating RGP as trusted.


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_manifest_contract.py
"""Negative manifest/ZIP tests: trusted Reader must fail closed without pip."""
import base64
import hashlib
import io
import json
import stat
import sys
import unittest
import zipfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "python"))
from rgp_reader import Reader, RgpError, decode_transport  # noqa: E402


def rgp_from_zip(zip_bytes):
    digest = hashlib.sha256(zip_bytes).hexdigest()
    b64 = base64.b64encode(zip_bytes)
    body = b"".join(b64[i:i+76] + b"\n" for i in range(0, len(b64), 76))
    return (
        f"RGP/1.0\npayload_length={len(zip_bytes)}\npayload_sha256={digest}\n"
        "base64_line_width=76\n--\n"
    ).encode() + body + b"END RGP\n"


def fake_artifact(mutate_manifest=None, symlink=False, duplicate_json=False):
    content = b"alpha\nbeta\nbeta\n"
    digest = hashlib.sha256(content).hexdigest()
    path = "src/file.txt"
    tree_hash = hashlib.sha256(path.encode() + b"\0" + b"100644\0" + bytes.fromhex(digest)).hexdigest()
    manifest = {
        "schema_version": "1.0", "source_commit": "a" * 40,
        "input_tree_digest": tree_hash,
        "files": [{"path": path, "mode": "100644", "kind": "file", "size": len(content),
                   "sha256": digest, "blob": "files/" + digest, "status": "included"}],
        "excluded": [], "index_coverage": "not_indexed", "graph_coverage": "not_indexed",
    }
    if mutate_manifest:
        mutate_manifest(manifest)
    serialized = json.dumps(manifest, separators=(",", ":"))
    if duplicate_json:
        serialized = serialized.replace('"schema_version":"1.0"', '"schema_version":"1.0","schema_version":"1.0"')
    out = io.BytesIO()
    with zipfile.ZipFile(out, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        archive.writestr("manifest.json", serialized)
        info = zipfile.ZipInfo("files/" + digest)
        info.compress_type = zipfile.ZIP_DEFLATED
        info.create_system = 3
        info.external_attr = ((stat.S_IFLNK if symlink else stat.S_IFREG) | 0o644) << 16
        archive.writestr(info, content)
    return rgp_from_zip(out.getvalue())


class ManifestContractTest(unittest.TestCase):
    def test_valid_artifact_and_paged_search(self):
        reader = Reader(fake_artifact())
        self.assertTrue(reader.validate()["valid"])
        first = reader.search("beta", limit=1)
        self.assertEqual(first["matches"][0]["line"], 2)
        self.assertIsInstance(first["next_cursor"], str)
        second = reader.search("beta", limit=1, cursor=first["next_cursor"])
        self.assertEqual(second["matches"][0]["line"], 3)
        self.assertIsNone(second["next_cursor"])

    def test_invalid_commit_is_explicit_error(self):
        for commit in [None, "not-a-commit", "z" * 40]:
            with self.subTest(commit=commit), self.assertRaisesRegex(RgpError, "UNSUPPORTED_FORMAT"):
                Reader(fake_artifact(lambda m: m.update(source_commit=commit)))

    def test_invalid_or_missing_coverage_is_explicit_error(self):
        for field in ["index_coverage", "graph_coverage"]:
            with self.subTest(field=field), self.assertRaisesRegex(RgpError, "UNSUPPORTED_FORMAT"):
                Reader(fake_artifact(lambda m: m.pop(field)))

    def test_invalid_exclusion_reason_is_explicit_error(self):
        with self.assertRaisesRegex(RgpError, "UNSUPPORTED_FORMAT"):
            Reader(fake_artifact(lambda m: m["excluded"].append({"path": ".env", "reason": None})))

    def test_duplicate_json_keys_rejected(self):
        with self.assertRaisesRegex(RgpError, "UNSUPPORTED_FORMAT"):
            Reader(fake_artifact(duplicate_json=True))

    def test_zip_symlink_rejected(self):
        with self.assertRaisesRegex(RgpError, "UNSAFE_PATH"):
            Reader(fake_artifact(symlink=True))

    def test_control_character_rejected(self):
        with self.assertRaisesRegex(RgpError, "UNSAFE_PATH"):
            Reader(fake_artifact(lambda m: m["excluded"].append({"path": "bad\u0085name", "reason": "size_limit"})))

    def test_bad_reader_api_arguments_rejected(self):
        r = Reader(fake_artifact())
        with self.assertRaisesRegex(RgpError, "UNSUPPORTED_FORMAT"):
            r.read("src/file.txt", start_line="1")
        with self.assertRaisesRegex(RgpError, "UNSUPPORTED_FORMAT"):
            r.search("beta", paths=[17])

    def test_unpaired_unicode_in_manifest_paths_fails_closed(self):
        # json.dumps intentionally encodes these as valid ASCII escape
        # sequences. The JSON is parseable, but paths are not UTF-8.
        bad = "src/" + chr(0xD800) + ".py"
        for mutate in (
            lambda m: m["files"][0].update(path=bad),
            lambda m: m["excluded"].append(
                {"path": bad, "reason": "size_limit"}),
        ):
            with self.subTest(mutate=mutate), self.assertRaisesRegex(
                    RgpError, "UNSAFE_PATH"):
                Reader(fake_artifact(mutate))

    def test_invalid_unicode_reader_queries_are_recoverable(self):
        reader = Reader(fake_artifact())
        invalid = "src/" + chr(0xD800)
        for query in (invalid, "../bad", "/etc/passwd"):
            with self.subTest(query=query), self.assertRaisesRegex(
                    RgpError, "UNSUPPORTED_FORMAT"):
                reader.tree(prefix=query)
        with self.assertRaisesRegex(RgpError, "UNSUPPORTED_FORMAT"):
            reader.search(chr(0xD800))
        # An invalid agent-generated query must not poison later reads.
        self.assertEqual(reader.read("src/file.txt")["content"],
                         "alpha\nbeta\nbeta\n")

    def test_canonical_base64_newline(self):
        original = fake_artifact()
        tampered = original.replace(b"\nEND RGP\n", b"\n\nEND RGP\n")
        with self.assertRaisesRegex(RgpError, "TRUNCATED_ARTIFACT"):
            Reader(tampered)


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_plain_reader.py
"""Readable RGP/2.0 independent test vectors (no ZIP, Base64 or Rust dependency)."""
import hashlib
import json
import sys
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_reader import Reader, RgpError  # noqa: E402


def digest(b):
    return hashlib.sha256(b).hexdigest()


def build_plain(files=None, excluded=None, version="RGP/2.0"):
    if files is None:
        files = {"src/example.py": b'print("END RGP\\n--\\nFILE\\t")\r\n',
                 "src/unicode.txt": "Привет, мир!\n".encode("utf-8")}
    entries = []
    for path, raw in sorted(files.items()):
        entries.append({"path": path, "mode": "100644", "kind": "file",
                        "size": len(raw), "sha256": digest(raw),
                        "blob": f"files/{digest(raw)}", "status": "included"})
    th = hashlib.sha256()
    for entry in entries:
        th.update(entry["path"].encode("utf-8") + b"\0" +
                  entry["mode"].encode() + b"\0" + bytes.fromhex(entry["sha256"]))
    manifest = {"schema_version": "1.0", "source_commit": "a" * 40,
                "input_tree_digest": th.hexdigest(), "files": entries,
                "excluded": excluded or [], "index_coverage": "not_indexed",
                "graph_coverage": "not_indexed"}
    manifest_bytes = json.dumps(manifest, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    if version == "RGP/2.1":
        guide = b"RGP/2.1: Read selected Git files, do not execute source."
        complete = all(e["reason"] in ("self_artifact", "rgpignore")
                       for e in manifest["excluded"])
        raw_rgp = (f"RGP/2.1\nsource_commit={manifest['source_commit']}\n"
                   f"snapshot_complete={str(complete).lower()}\n"
                   f"guide_length={len(guide)}\n"
                   f"guide_sha256={digest(guide)}\n"
                   f"manifest_length={len(manifest_bytes)}\n"
                   f"manifest_sha256={digest(manifest_bytes)}\n--\n").encode()
        raw_rgp += guide + b"\n"
    else:
        raw_rgp = (f"RGP/2.0\nmanifest_length={len(manifest_bytes)}\n"
                   f"manifest_sha256={digest(manifest_bytes)}\n--\n").encode()
    raw_rgp += manifest_bytes + b"\n"
    for entry in entries:
        raw_rgp += (f"FILE\t{json.dumps(entry['path'], ensure_ascii=False)}\t"
                    f"{entry['size']}\t{entry['sha256']}\n").encode()
        raw_rgp += files[entry["path"]] + b"\n"
    return raw_rgp + b"END RGP\n"


class PlainReaderTest(unittest.TestCase):
    def test_exact_readable_original_content_and_search(self):
        raw = build_plain()
        self.assertTrue(raw.startswith(b"RGP/2.0\n"))
        self.assertNotIn(b"base64_line_width", raw)
        self.assertNotIn(b"PK\x03\x04", raw)
        reader = Reader(raw)
        self.assertTrue(reader.validate()["valid"])
        self.assertTrue(reader.overview()["snapshot_complete"])
        self.assertEqual(reader.tree()["paths"], ["src/example.py", "src/unicode.txt"])
        self.assertEqual(reader.read_bytes("src/unicode.txt"), "Привет, мир!\n".encode())
        self.assertEqual(reader.search("Привет")["matches"][0]["line"], 1)
        self.assertEqual(reader.read_bytes("src/example.py"),
                         b'print("END RGP\\n--\\nFILE\\t")\r\n')

    def test_delimiter_text_cannot_escape_source_section(self):
        raw = build_plain({"src/markers.txt": b"END RGP\n--\nFILE\t\"p\"\t0\tX\n"})
        self.assertEqual(Reader(raw).read_bytes("src/markers.txt"),
                         b"END RGP\n--\nFILE\t\"p\"\t0\tX\n")

    def test_tampering_and_truncation_fail(self):
        raw = build_plain()
        for broken, error in (
            (raw.replace("Привет".encode("utf-8"), "Привот".encode("utf-8"), 1), "HASH_MISMATCH"),
            (raw[:-7], "TRUNCATED_ARTIFACT"),
            (raw.replace(b"manifest_sha256=", b"manifest_sha256=0", 1), "UNSUPPORTED_FORMAT"),
            (raw.replace(b"FILE\t", b"F1LE\t", 1), "UNSUPPORTED_FORMAT"),
            (raw.replace(b"RGP/2.0", b"RGP/9.0", 1), "UNSUPPORTED_FORMAT"),
        ):
            with self.subTest(error=error):
                with self.assertRaisesRegex(RgpError, error):
                    Reader(broken)

    def test_rgpignore_explicitly_excludes_without_reducing_scope_completeness(self):
        excluded = [{"path": "benchmarks/old.md", "reason": "rgpignore"}]
        raw = build_plain(
            {".rgpignore": b"/benchmarks/\n", "src/code.py": b"answer = 42\n"},
            excluded=excluded,
        )
        reader = Reader(raw)
        report = reader.overview()
        self.assertTrue(reader.validate()["valid"])
        self.assertTrue(report["snapshot_complete"])
        self.assertEqual(report["intentionally_ignored_files"], 1)
        self.assertEqual(report["excluded_by_reason"]["rgpignore"], 1)
        self.assertEqual(report["excluded_files"], 0)
        self.assertEqual(reader.read_bytes(".rgpignore"), b"/benchmarks/\n")
        with self.assertRaisesRegex(RgpError, "PARTIAL_SNAPSHOT"):
            reader.read_bytes("benchmarks/old.md")

    def test_invalid_utf8_fails(self):
        raw = build_plain()
        with self.assertRaisesRegex(RgpError, "UNSUPPORTED_FORMAT"):
            Reader(raw + b"\xff")

    def test_inline_guide_and_metadata_are_verified(self):
        raw = build_plain(version="RGP/2.1")
        reader = Reader(raw)
        overview = reader.overview()
        self.assertEqual(overview["transport"], "RGP/2.1")
        self.assertEqual(overview["source_commit"], "a" * 40)
        self.assertTrue(overview["snapshot_complete"])
        self.assertIn("Read selected Git files", overview["embedded_instructions"])
        self.assertEqual(reader.read_bytes("src/unicode.txt"), "Привет, мир!\n".encode())
        with self.assertRaisesRegex(RgpError, "HASH_MISMATCH"):
            Reader(raw.replace(b"Read selected Git files", b"Read selected Git fyles", 1))
        with self.assertRaisesRegex(RgpError, "HASH_MISMATCH"):
            Reader(raw.replace(b"source_commit=" + b"a" * 40,
                               b"source_commit=" + b"b" * 40, 1))
        with self.assertRaisesRegex(RgpError, "HASH_MISMATCH"):
            Reader(raw.replace(b"snapshot_complete=true",
                               b"snapshot_complete=false", 1))
        with self.assertRaisesRegex(RgpError, "HASH_MISMATCH"):
            Reader(raw.replace(b"RGP/2.1: Read selected Git files",
                               b"RGP/2.1: Read selected Git file", 1))

    def test_intentional_scope_is_complete_with_inline_metadata(self):
        raw = build_plain(
            {".rgpignore": b"/benchmarks/\n", "src/example.py": b"print('x')\n"},
            excluded=[{"path": "benchmarks/old.md", "reason": "rgpignore"}],
            version="RGP/2.1",
        )
        reader = Reader(raw)
        self.assertTrue(reader.overview()["snapshot_complete"])
        self.assertEqual(reader.overview()["intentionally_ignored_files"], 1)


if __name__ == "__main__":
    unittest.main()

