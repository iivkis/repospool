#!/usr/bin/env python3
"""Stage 1: pinned three-repository real-RGP acceptance and resource profiling.

This is a stdlib-only developer-side test, NOT a model runner or Gate B.
The 12 frozen task ids / reference paths come from Gate B's existing plan;
the independently chosen anchors below are a test of Reader source navigation.
They are not full natural-language answers to the Gate B task rubrics.
No source code or RGP bytes are written to the evidence JSON.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import resource
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_reader import Reader, RgpError  # noqa: E402
from gate_b import strict_json, validate_plan  # noqa: E402

# Fixed, repository-specific anchors selected before the CI experiments.
# Each plan reference path must be exercised, otherwise fail closed.
ANCHORS = {
    "rgp-transport-hash": {
        "python/rgp_reader.py": ("payload_sha256=",),
        "src/main.rs": ("payload_sha256=",),
    },
    "rgp-git-snapshot": {"src/main.rs": ("fn snapshot(",)},
    "rgp-search-cursor": {
        "python/rgp_reader.py": ("def _read_cursor(",),
        "tests/test_reader_api.py": ("def test_search_keyset_cursor_scope_and_exhaustion",),
    },
    "rgp-trust-boundary": {
        "python/rgp_bootstrap.py": ("def bootstrap(",),
        "docs/RGP_SECURITY_MODEL.md": ("Trust boundary",),
    },
    "serde-json-deserializer": {"src/de.rs": ("pub fn from_str(", "pub fn from_slice(")},
    "serde-json-serializer": {"src/ser.rs": ("fn serialize_i64(", "fn serialize_str(")},
    "serde-json-error-position": {
        "src/error.rs": ("pub fn line(", "pub fn column(", "pub fn classify("),
    },
    "serde-json-ser-tests": {
        "tests/test.rs": ("fn test_write_",),
        "src/ser.rs": ("fn serialize_str(",),
    },
    "itsdangerous-timestamp": {"src/itsdangerous/timed.py": ("class TimestampSigner", "def unsign(")},
    "itsdangerous-hmac": {"src/itsdangerous/signer.py": ("class HMACAlgorithm", "def get_signature(")},
    "itsdangerous-deserialization": {
        "src/itsdangerous/serializer.py": ("def load_payload(", "def loads("),
        "src/itsdangerous/signer.py": ("def get_signature(",),
    },
    "itsdangerous-expiry-tests": {
        "tests/test_itsdangerous/test_timed.py": ("def test_",),
        "src/itsdangerous/timed.py": ("class TimestampSigner",),
    },
}


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ValueError(message)


def tasks_for(plan: dict, repository: str) -> tuple[dict, list[dict]]:
    validate_plan(plan)
    repos = {r["id"]: r for r in plan["repositories"]}
    require(repository in repos, "unknown repository in pinned plan")
    require(set(ANCHORS) == {t["id"] for t in plan["tasks"]}, "anchor task ids diverge from frozen plan")
    for task in plan["tasks"]:
        anchor = ANCHORS[task["id"]]
        require(set(anchor) == set(task["reference_paths"]), f"anchor paths missing: {task['id']}")
        require(all(isinstance(v, tuple) and v and all(isinstance(s, str) and s for s in v)
                    for v in anchor.values()), "invalid source search anchor")
    return repos[repository], [t for t in plan["tasks"] if t["repository"] == repository]


def execute(command: list[str], *, cwd: Path | None = None) -> bytes:
    result = subprocess.run(command, cwd=cwd, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, check=False)
    if result.returncode:
        raise RuntimeError(f"command failed with status {result.returncode}: "
                           f"{command[:4]!r}; {result.stderr[-1000:].decode(errors='replace')}")
    return result.stdout


def obtain_pinned_repo(repo: dict, dest: Path) -> None:
    # Only the immutable repo and SHA in the preregistered plan are used.
    url = f"https://github.com/{repo['github']}.git"
    execute(["git", "init", "-q", str(dest)])
    execute(["git", "-C", str(dest), "remote", "add", "origin", url])
    execute(["git", "-C", str(dest), "-c", "protocol.version=2", "fetch",
             "--depth=1", "--filter=blob:none", "origin", repo["commit"]])
    execute(["git", "-C", str(dest), "checkout", "--detach", "-q", "FETCH_HEAD"])
    actual = execute(["git", "-C", str(dest), "rev-parse", "HEAD"]).decode().strip()
    require(actual == repo["commit"], "pinned source revision mismatch")


def measured(command: list[str], metrics: Path) -> dict:
    # Ubuntu CI supplies GNU time. Resource measurements are per invocation;
    # no peak-memory extrapolation across hosts or machines is legitimate.
    execute(["/usr/bin/time", "-f", "%e %M", "-o", str(metrics), *command])
    pieces = metrics.read_text().strip().split()
    require(len(pieces) == 2, "GNU time did not produce two metrics")
    return {"elapsed_ms": round(float(pieces[0]) * 1000),
            "peak_rss_kib": int(pieces[1])}


def inspect(repo: dict, tasks: list[dict], source: Path, binary: Path, work: Path) -> dict:
    commit = repo["commit"]
    first, second = work / "a.rgp", work / "b.rgp"
    cmd = [str(binary), "generate", "--repo", str(source), "--rev", commit]
    first_metrics = measured([*cmd, "--output", str(first)], work / "time-a.txt")
    second_metrics = measured([*cmd, "--output", str(second)], work / "time-b.txt")
    raw = first.read_bytes()
    require(raw == second.read_bytes(), "RGP output nondeterministic at pinned commit")
    verify_metrics = measured([str(binary), "verify", "--artifact", str(first),
                               "--repo", str(source)], work / "time-verify.txt")

    start = time.perf_counter_ns()
    reader = Reader(first)
    validate_ms = round((time.perf_counter_ns() - start) / 1e6, 3)
    overview = reader.overview()
    require(reader.validate()["valid"] and overview["source_commit"] == commit,
            "Reader/commit validation failed")
    require(overview["snapshot_complete"], "fixed corpus RGP unexpectedly partial")
    require(reader.coverage("index")["status"] == "not_indexed", "semantic coverage overclaimed")

    paths = set()
    cursor = None
    while True:
        page = reader.tree(limit=17, cursor=cursor)
        require(not paths.intersection(page["paths"]), "duplicate tree paths across pages")
        paths.update(page["paths"])
        if page["next_cursor"] is None:
            break
        cursor = page["next_cursor"]
    require(len(paths) == overview["file_count"], "paginated Reader tree incomplete")
    seen_paths: dict[str, bytes] = {}
    task_rows = []
    query_count = 0
    task_start = time.perf_counter_ns()
    for task in tasks:
        rows = []
        for path in task["reference_paths"]:
            require(path in paths, f"task reference unavailable: {task['id']}:{path}")
            # Independent source-of-truth: raw git object from the pinned commit.
            original = seen_paths.get(path)
            if original is None:
                original = execute(["git", "-C", str(source), "show", f"{commit}:{path}"])
                seen_paths[path] = original
            # _blob is used for byte-fidelity verification only. All source
            # navigation tasks below use the PUBLIC read/search Reader API.
            require(reader._blob(path) == original, f"RGP content differs from Git: {path}")
            lines = original.decode("utf-8").splitlines(keepends=True)
            for needle in ANCHORS[task["id"]][path]:
                expected = [n for n, line in enumerate(lines, 1) if needle in line]
                require(0 < len(expected) < 100, f"anchor absent/ambiguous: {task['id']}:{path}")
                found = reader.search(needle, paths=[path], limit=100)
                observed = [match["line"] for match in found["matches"]]
                require(observed == expected and found["next_cursor"] is None,
                        f"search lines differ from pinned Git: {task['id']}:{path}")
                line_number = expected[0]
                from_rgp = reader.read(path, line_number, line_number)["content"]
                require(from_rgp == lines[line_number - 1],
                        f"Reader line content differs from Git: {task['id']}:{path}")
                query_count += 1
                rows.append({"path": path, "needle": needle,
                             "expected_lines": expected, "observed_lines": observed})
        task_rows.append({"task_id": task["id"], "status": "PASS", "anchors": rows})
    task_ms = round((time.perf_counter_ns() - task_start) / 1e6, 3)

    # Invalid bytes must still fail before returning any source content.
    for damaged, expected_error in (
        (raw[:-10], "TRUNCATED_ARTIFACT"),
        (raw.replace(raw.split(b"\n", 1)[0], b"RGP/9.0", 1), "UNSUPPORTED_FORMAT"),
        (re.sub(rb"(manifest_sha256=)[0-9a-f]{64}", lambda m: m.group(1) + b"0" * 64,
                raw, count=1), "HASH_MISMATCH"),
    ):
        try:
            Reader(damaged)
        except RgpError as exc:
            require(exc.code == expected_error, "negative-case error changed")
        else:
            raise AssertionError("corrupted archive was accepted")
    return {
        "repository": repo["id"], "source_commit": commit, "status": "PASS",
        "transport_version": raw.split(b"\n", 1)[0].decode("ascii"),
        "rgp_sha256": hashlib.sha256(raw).hexdigest(), "rgp_bytes": len(raw),
        "included_files": overview["file_count"], "unique_reference_files": len(seen_paths),
        "query_count": query_count, "tasks": task_rows,
        "timings": {"generate_first": first_metrics, "generate_second": second_metrics,
                    "verify": verify_metrics, "reader_validate_ms": validate_ms,
                    "source_navigation_ms": task_ms},
        "reader_process_peak_rss_kib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
        "checks": ["determinism", "Rust verification", "Reader completeness",
                   "all pinned source bytes", "source-based read/search",
                   "tree pagination", "invalid transport rejection"],
    }


def match_checkpoint(corpus: dict, result: dict) -> str:
    """Preserve the legacy byte checkpoint without misapplying it to v1.1.

    Source tasks independently compare manifest and blobs to pinned Git in
    inspect(). New transport bytes require their own future checkpoint.
    """
    rows = corpus.get("artifacts")
    require(isinstance(rows, list), "missing pinned checkpoint artifacts")
    checkpoints = [r for r in rows if r.get("repository") == result["repository"]]
    require(len(checkpoints) == 1, "missing or duplicate RGP checkpoint")
    expected = checkpoints[0]
    for key, current in (
        ("source_commit", result["source_commit"]),
        ("included_files", result["included_files"]),
    ):
        require(expected.get(key) == current, f"pinned compatibility regression: {key}")
    version = result.get("transport_version", "RGP/1.0")
    if version == "RGP/1.0":
        for key, current in (("sha256", result["rgp_sha256"]),
                             ("rgp_bytes", result["rgp_bytes"])):
            require(expected.get(key) == current, f"pinned compatibility regression: {key}")
        return "EXACT_LEGACY_BYTES"
    require(version in ("RGP/1.1", "RGP/1.2", "RGP/2.0"), "unsupported transport checkpoint version")
    # A v1.0 RGP hash cannot authenticate the intentionally changed v1.1
    # header. The run still verifies determinism, Git source truth and Reader.
    return "SOURCE_EQUIVALENCE_ONLY"


def run(repository: str, binary: Path, plan_file: Path, checkpoint_file: Path) -> dict:
    plan = strict_json(plan_file)
    repo, tasks = tasks_for(plan, repository)
    from gate_b import digest_plan
    with tempfile.TemporaryDirectory(prefix="rgp-stage1-corpus-") as folder:
        work = Path(folder)
        source = work / "source"
        obtain_pinned_repo(repo, source)
        result = inspect(repo, tasks, source, binary.resolve(), work)
    result["pinned_v1_format_compatibility"] = match_checkpoint(
        strict_json(checkpoint_file), result)
    result.update({
        "kind": "stage1_corpus_source_functional_and_resource_diagnostic",
        "plan_sha256": digest_plan(plan),
        "gate_b": "HOLD",
        "not_measured": ["GitHub connector calls", "model tokens", "agent answer grading",
                         "connector transport", "end-to-end acquisition latency"],
        "environment": "GitHub Actions ubuntu-latest, same runner per repository",
    })
    return result


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--repository", choices=("rgp", "serde_json", "itsdangerous"), required=True)
    p.add_argument("--rust-cli", type=Path, default=ROOT / "target/release/rgp")
    p.add_argument("--plan", type=Path, default=ROOT / "benchmarks/gate_b/plan.json")
    p.add_argument("--checkpoint", type=Path, default=ROOT / "benchmarks/gate_b/corpus_preparation.json")
    p.add_argument("--report", type=Path, required=True)
    args = p.parse_args()
    try:
        result = run(args.repository, args.rust_cli, args.plan, args.checkpoint)
    except Exception as exc:
        result = {"kind": "stage1_corpus_source_functional_and_resource_diagnostic",
                  "repository": args.repository, "status": "FAIL",
                  "reason": str(exc), "gate_b": "HOLD"}
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(result, ensure_ascii=False, sort_keys=True, indent=2) + "\n")
    print(json.dumps(result, ensure_ascii=False, sort_keys=True, indent=2))
    return 0 if result["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())

FILE	"scripts/stage1_delivery.py"	8272	0c25996a861a0465664cb57f3447a0d1860de0391568761de0c885cd5d826cb7
#!/usr/bin/env python3
"""Stage 1 delivery acceptance for a GitHub Actions ZIP.

A *committed*, separately retrieved corpus checkpoint is the expected RGP
SHA-256; hashes inside a ZIP are not trusted anchors. All bytes are verified
by the existing stdlib bootstrap and RGP Reader. Optional --source-repo
independently checks every frozen task reference against pinned Git objects.

This tool cannot attest which connector returned the ZIP, authenticate
reviewer independence, or grade natural-language Gate B answers.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_bootstrap import bootstrap  # noqa: E402
from rgp_reader import Reader, RgpError  # noqa: E402
from gate_b import ProtocolError, digest_plan, strict_json, validate_plan  # noqa: E402
from stage1_corpus import ANCHORS  # noqa: E402


def insist(condition: bool, detail: str) -> None:
    if not condition:
        raise ProtocolError(detail)


def pinned_expectation(plan: dict, checkpoint: dict, name: str) -> tuple[dict, dict, list[dict]]:
    validate_plan(plan)
    repos = [repo for repo in plan["repositories"] if repo["id"] == name]
    rows = checkpoint.get("artifacts")
    insist(isinstance(rows, list), "missing corpus checkpoint")
    matches = [row for row in rows if isinstance(row, dict)
               and row.get("repository") == name]
    insist(len(repos) == 1 and len(matches) == 1, "unknown or duplicate repository checkpoint")
    repo, row = repos[0], matches[0]
    insist(repo["commit"] == row.get("source_commit"), "checkpoint source revision differs from frozen plan")
    insist(isinstance(row.get("sha256"), str) and len(row["sha256"]) == 64
           and all(c in "0123456789abcdef" for c in row["sha256"]),
           "invalid checkpoint digest")
    insist(type(row.get("rgp_bytes")) is int and row["rgp_bytes"] > 0
           and type(row.get("included_files")) is int and row["included_files"] >= 0,
           "invalid checkpoint sizes")
    tasks = [task for task in plan["tasks"] if task["repository"] == name]
    insist(bool(tasks), "no pinned task coverage")
    return repo, row, tasks


def original_blob(repo_path: Path, commit: str, path: str) -> bytes:
    result = subprocess.run(["git", "-C", str(repo_path), "show", f"{commit}:{path}"],
                            check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return result.stdout


def verify_delivered(zip_path: Path, output: Path, repository: str,
                     plan: dict, checkpoint: dict,
                     source_repo: Path | None = None) -> dict:
    repo, row, tasks = pinned_expectation(plan, checkpoint, repository)
    # Hash/size are read from the independently committed repository record,
    # NOT from the ZIP's optional co-packed provenance.json.
    result = bootstrap(zip_path, output, trusted_sha256=row["sha256"])
    artifact = output.read_bytes()
    insist(result["sha256"] == row["sha256"] and
           len(artifact) == row["rgp_bytes"], "delivered artifact differs from checkpoint")
    reader = Reader(output)
    overview = reader.overview()
    insist(overview["source_commit"] == repo["commit"], "delivered source commit mismatch")
    insist(overview["snapshot_complete"], "delivered RGP is a partial snapshot")
    insist(overview["file_count"] == row["included_files"], "delivered file count differs")
    insist(reader.coverage("index")["status"] == "not_indexed", "unearned index coverage")

    found = set()
    cursor = None
    while True:
        page = reader.tree(limit=25, cursor=cursor)
        insist(not (found & set(page["paths"])), "duplicate delivered tree path")
        found.update(page["paths"])
        cursor = page["next_cursor"]
        if cursor is None:
            break
    insist(len(found) == overview["file_count"], "delivered tree is incomplete")
    seen: dict[str, bytes] = {}
    verified = []
    for task in tasks:
        insist(task["id"] in ANCHORS and
               set(ANCHORS[task["id"]]) == set(task["reference_paths"]),
               "missing preregistered source-navigation anchors")
        for path in task["reference_paths"]:
            insist(path in found, f"missing delivered reference {task['id']}:{path}")
            if source_repo is not None:
                if path not in seen:
                    seen[path] = original_blob(source_repo, repo["commit"], path)
                original = seen[path]
                insist(reader._blob(path) == original, f"delivered bytes differ from Git: {path}")
                lines = original.decode("utf-8").splitlines(keepends=True)
                for needle in ANCHORS[task["id"]][path]:
                    expected = [n for n, line in enumerate(lines, 1) if needle in line]
                    insist(0 < len(expected) < 100, "missing/ambiguous predefined anchor")
                    actual = reader.search(needle, paths=[path], limit=100)
                    insist([match["line"] for match in actual["matches"]] == expected and
                           actual["next_cursor"] is None,
                           f"delivered search does not match Git: {task['id']}:{path}")
                    line = expected[0]
                    insist(reader.read(path, line, line)["content"] == lines[line - 1],
                           f"delivered read differs from Git: {task['id']}:{path}")
        verified.append(task["id"])
    return {
        "kind": "stage1_github_actions_zip_delivery",
        "status": "PASS", "repository": repository,
        "source_commit": repo["commit"],
        "plan_sha256": digest_plan(plan),
        "rgp_sha256": hashlib.sha256(artifact).hexdigest(),
        "rgp_bytes": len(artifact),
        "snapshot_complete": overview["snapshot_complete"],
        "task_reference_sets": len(verified), "task_ids": verified,
        "unique_git_blobs_compared": len(seen),
        "validation": ["external committed SHA256 checkpoint",
                       "strict Actions ZIP bootstrap", "RGP 1.0 stdlib Reader",
                       "full tree pagination",
                       "all frozen task reference paths"] +
                      (["read/search and bytes independently compared with pinned Git"]
                       if source_repo is not None else []),
        "source_comparison": "PASS" if source_repo is not None else "NOT_RUN",
        "connector_acquisition": "NOT_ATTESTED_BY_LOCAL_SCRIPT",
        "gate_b": "HOLD",
        "not_measured": ["authenticated connected-tool call history",
                         "independent answer grading", "model token usage"],
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--actions-zip", type=Path, required=True)
    parser.add_argument("--repository", required=True, choices=("rgp", "serde_json", "itsdangerous"))
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--report", type=Path, required=True)
    parser.add_argument("--source-repo", type=Path)
    parser.add_argument("--plan", type=Path, default=ROOT / "benchmarks/gate_b/plan.json")
    parser.add_argument("--checkpoint", type=Path,
                        default=ROOT / "benchmarks/gate_b/corpus_preparation.json")
    args = parser.parse_args()
    try:
        result = verify_delivered(args.actions_zip, args.output, args.repository,
                                  strict_json(args.plan), strict_json(args.checkpoint),
                                  args.source_repo)
    except (ProtocolError, RgpError, ValueError, OSError,
            subprocess.CalledProcessError, KeyError) as exc:
        result = {"kind": "stage1_github_actions_zip_delivery",
                  "status": "FAIL", "repository": args.repository,
                  "reason": str(exc), "gate_b": "HOLD"}
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n")
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0 if result["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())

FILE	"scripts/stage1_mcp_agent_trial.py"	9177	673a3aae201c7a5d275342a866db40c3b859fb68b811f969d14e92efbeea1afc
#!/usr/bin/env python3
"""Full real Git -> RGP -> MCP stdio tool -> pinned Git evidence exercise.

Four previously frozen coding tasks per repo, with the exact same
source anchors as the existing agent-context protocol. This validates
that an *external MCP client* can navigate real source using just
tool calls, not Python imports of Reader. It is not LLM inference.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))
from gate_b import strict_json, validate_plan  # noqa: E402
from stage1_agent_task_pilot import TERMS  # noqa: E402


class Client:
    def __init__(self, artifact: Path):
        self.process = subprocess.Popen(
            [sys.executable, "-u", str(ROOT / "python/rgp_mcp.py"),
             "--artifact", str(artifact)],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        self.next_id = 0
        self.requests = 0
        self.response_bytes = 0
        self.tool_calls = 0

    def send(self, method: str, params: dict | None = None) -> dict:
        self.next_id += 1
        message = {"jsonrpc": "2.0", "id": self.next_id, "method": method}
        if params is not None:
            message["params"] = params
        assert self.process.stdin and self.process.stdout
        self.process.stdin.write((json.dumps(message) + "\n").encode())
        self.process.stdin.flush()
        line = self.process.stdout.readline()
        if not line:
            raise AssertionError("MCP process terminated without response")
        self.requests += 1
        self.response_bytes += len(line)
        response = json.loads(line)
        assert response.get("jsonrpc") == "2.0" and response.get("id") == self.next_id
        assert "error" not in response, f"unexpected MCP protocol error: {response}"
        return response["result"]

    def tool(self, name: str, args: dict | None = None) -> dict:
        self.tool_calls += 1
        result = self.send("tools/call", {"name": name, "arguments": args or {}})
        assert not result.get("isError"), f"unexpected MCP tool error: {result}"
        assert len(result["content"]) == 1
        return json.loads(result["content"][0]["text"])

    def close(self) -> None:
        if self.process.stdin:
            self.process.stdin.close()
        try:
            code = self.process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait()
            raise AssertionError("MCP process failed to shut down on EOF")
        assert code == 0, f"MCP exited {code}, {self.process.stderr.read()[-400:]!r}"


def run(artifact: Path, source_repo: Path, repository: str, plan: Path) -> dict:
    frozen = strict_json(plan)
    validate_plan(frozen)
    selected = [t for t in frozen["tasks"] if t["repository"] == repository]
    repo = next(r for r in frozen["repositories"] if r["id"] == repository)
    assert len(selected) == 4, "expected four frozen coding tasks per repo"
    start = time.perf_counter_ns()
    client = Client(artifact)
    read_paths = set()
    count = 0
    total_context_bytes = 0
    rows = []
    try:
        handshake = client.send("initialize", {"protocolVersion": "2025-06-18",
                                                "clientInfo": {"name": "rgp-agent-acceptance",
                                                               "version": "1.0"},
                                                "capabilities": {}})
        assert handshake["protocolVersion"] == "2025-06-18"
        tools = client.send("tools/list")["tools"]
        assert {t["name"] for t in tools} == {
            "rgp_status", "rgp_tree", "rgp_search", "rgp_read", "rgp_context"}
        status = client.tool("rgp_status")["overview"]
        assert status["source_commit"] == repo["commit"]
        assert status["snapshot_complete"]
        assert status["file_count"] > 0
        assert status["index_coverage"] == "not_indexed"
        first = client.tool("rgp_tree", {"limit": 200})
        assert first["paths"]
        for task in selected:
            terms = list(TERMS[task["id"]])
            context = client.tool("rgp_context", {
                "terms": terms, "max_bytes": 24_000, "max_files": 4
            })
            assert context["source_commit"] == repo["commit"]
            assert not context["terms_without_source"]
            assert not context["search_capped_terms"]
            actual_paths = {x["path"] for x in context["sources"]}
            assert set(task["reference_paths"]) <= actual_paths, (
                task["id"], set(task["reference_paths"]) - actual_paths)
            total_context_bytes += len(json.dumps(
                context, sort_keys=True, ensure_ascii=False, separators=(",", ":")
            ).encode("utf-8"))
            for item in context["sources"]:
                path = item["path"]
                original = subprocess.check_output([
                    "git", "-C", str(source_repo), "show",
                    f"{repo['commit']}:{path}"
                ])
                lines = original.decode("utf-8").splitlines(keepends=True)
                start_line, end_line = item["start_line"], item["end_line"]
                assert 1 <= start_line <= item["match_line"] <= end_line <= len(lines)
                assert "".join(lines[start_line - 1:end_line]) == item["content"]
                assert item["match_term"] in lines[item["match_line"] - 1]
                # Independently follow one actual MCP rgp_read citation for
                # each task, not just inspect its preselected context JSON.
                count += 1
                read_paths.add(path)
            source = context["sources"][0]
            reread = client.tool("rgp_read", {
                "path": source["path"], "start_line": source["start_line"],
                "end_line": source["end_line"],
            })
            assert reread["content"] == source["content"]
            # The search tool is a real independent step in the agent
            # protocol; the model can use it to refine its next query.
            matches = client.tool("rgp_search", {
                "query": source["match_term"], "paths": [source["path"]], "limit": 20
            })
            assert any(m["line"] == source["match_line"] for m in matches["matches"])
            rows.append({"task_id": task["id"], "passages_verified": len(context["sources"]),
                         "source_paths": sorted(actual_paths),
                         "context_bytes": len(json.dumps(
                            context, sort_keys=True, ensure_ascii=False,
                            separators=(",", ":")).encode("utf-8"))})
        negative = client.send("tools/call", {
            "name": "rgp_read", "arguments": {"path": "../not-in-repo"}
        })
        assert negative["isError"] and "PARTIAL_SNAPSHOT" in negative["content"][0]["text"]
        assert client.send("ping") == {}
    finally:
        client.close()
    elapsed_ms = round((time.perf_counter_ns() - start) / 1e6, 3)
    return {
        "kind": "rgp_real_mcp_agent_source_navigation",
        "status": "PASS", "repository": repository, "source_commit": repo["commit"],
        "task_count": len(rows), "verified_source_passages": count,
        "unique_source_paths": len(read_paths), "context_bytes": total_context_bytes,
        "mcp_json_rpc_requests": client.requests,
        "mcp_tool_calls": client.tool_calls,
        "mcp_wire_response_bytes": client.response_bytes,
        "elapsed_ms_including_local_git_truth_checks": elapsed_ms,
        "tasks": rows, "negative_read_rejected": True,
        "model_inference": "NOT_RUN",
        "model_tokens": "NOT_MEASURED",
        "github_provider_calls": "NOT_MEASURED_BY_LOCAL_GIT",
        "independent_answer_grading": "NOT_RUN",
        "gate_b": "HOLD",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--artifact", required=True, type=Path)
    parser.add_argument("--source-repo", required=True, type=Path)
    parser.add_argument("--repository", choices=("rgp", "serde_json", "itsdangerous"),
                        required=True)
    parser.add_argument("--report", required=True, type=Path)
    args = parser.parse_args()
    try:
        result = run(args.artifact, args.source_repo, args.repository,
                     ROOT / "benchmarks/gate_b/plan.json")
    except Exception as exc:
        result = {"kind": "rgp_real_mcp_agent_source_navigation", "status": "FAIL",
                  "repository": args.repository, "reason": str(exc),
                  "gate_b": "HOLD"}
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(result, ensure_ascii=False,
                                      indent=2, sort_keys=True) + "\n")
    print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    return 0 if result["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())

FILE	"scripts/stage1_memory_ab.py"	7453	b6ecd2b5511d8c0424740cfc91c77f8317bbc51774203fdd60b15dc18fd6be4e
#!/usr/bin/env python3
"""Paired old-vs-new Rust generator measurement on the exact same Git sources.

The CI job compiles both versions from clean source trees and runs each
against the same real temporary Git commit. RGP bytes MUST remain identical
for the same transport version; cross-version comparisons are marked SKIP.
Peak RSS is measured by GNU time; no tokens or connector calls are inferred.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_reader import Reader  # noqa: E402
from stage1_corpus import measured  # noqa: E402
from stage1_stress import make_source  # noqa: E402
from stage1_scale import FILES, CAP, SAMPLE, commit_many, path_for  # noqa: E402

PROFILES = ("many-files", "incompressible", "compressible", "disk-fallback", "scale-50k")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--baseline", type=Path, required=True)
    parser.add_argument("--candidate", type=Path, required=True)
    parser.add_argument("--report", type=Path, required=True)
    args = parser.parse_args()
    report = {"kind": "stage1_paired_same_runner_generator_memory",
              "status": "FAIL", "gate_b": "HOLD", "profiles": [],
              "limits": ["ephemeral runner, cache and invocation order may bias timings",
                         "no claims of connector, user latency or model token savings"]}
    try:
        for profile in PROFILES:
            with tempfile.TemporaryDirectory(prefix=f"rgp-memory-ab-{profile}-") as name:
                folder = Path(name)
                source_dir = folder / "source"
                if profile == "scale-50k":
                    commit = commit_many(source_dir, FILES)
                    sample = [path_for(index) for index in SAMPLE]
                else:
                    commit, fixture = make_source(source_dir, profile)
                    sample = list(fixture)[:3] + list(fixture)[-3:]
                # Alternate order to reduce, not eliminate, warm-cache bias.
                order = ("baseline", "candidate") if profile != "compressible" else (
                    "candidate", "baseline")
                paths: dict[str, Path] = {}
                times: dict[str, dict] = {}
                for arm in order:
                    binary = (args.baseline if arm == "baseline" else args.candidate).resolve()
                    artifact = folder / f"{arm}.rgp"
                    times[arm] = measured([
                        str(binary), "generate", "--repo", str(source_dir),
                        "--rev", commit, "--output", str(artifact),
                    ], folder / f"{arm}.time")
                    paths[arm] = artifact
                original = paths["baseline"].read_bytes()
                optimized = paths["candidate"].read_bytes()
                baseline_version = original.split(b"\n", 1)[0].decode("ascii", errors="replace")
                candidate_version = optimized.split(b"\n", 1)[0].decode("ascii", errors="replace")
                if baseline_version != candidate_version:
                    # Comparing transport 1.0 to 1.1 cannot satisfy the original
                    # byte-identical A/B claim, so do not report fake PASS/FAIL.
                    report.update(status="SKIP", reason="TRANSPORT_VERSION_CHANGED",
                                  baseline_version=baseline_version,
                                  candidate_version=candidate_version)
                    break
                if original != optimized:
                    raise AssertionError(f"RGP bytes changed on {profile}")
                for arm in ("baseline", "candidate"):
                    subprocess.run([
                        str((args.baseline if arm == "baseline" else args.candidate).resolve()),
                        "verify", "--artifact", str(paths[arm]), "--repo", str(source_dir),
                    ], check=True, stdout=subprocess.DEVNULL)
                reader = Reader(optimized)
                overview = reader.overview()
                if not reader.validate()["valid"] or overview["source_commit"] != commit:
                    raise AssertionError(f"invalid source snapshot: {profile}")
                if profile == "scale-50k":
                    if overview["snapshot_complete"] or overview["file_count"] != CAP:
                        raise AssertionError("large snapshot incorrectly claimed complete")
                    if overview["excluded_by_reason"].get("entry_limit") != FILES - CAP:
                        raise AssertionError("large source lost its exclusions")
                elif not overview["snapshot_complete"]:
                    raise AssertionError(f"unexpected partial snapshot: {profile}")
                # Check sampled source bytes against independently read pinned Git.
                for path in sorted(set(sample)):
                    raw = subprocess.check_output([
                        "git", "-C", str(source_dir), "show", f"{commit}:{path}"])
                    if reader._blob(path) != raw:
                        raise AssertionError(f"Git blob mismatch: {path}")
                baseline_rss = times["baseline"]["peak_rss_kib"]
                candidate_rss = times["candidate"]["peak_rss_kib"]
                if baseline_rss <= 0 or candidate_rss <= 0:
                    raise AssertionError("missing GNU time RSS")
                profile_report = {
                    "profile": profile, "source_commit": commit,
                    "same_artifact_sha256": hashlib.sha256(optimized).hexdigest(),
                    "rgp_bytes": len(optimized), "included_files": overview["file_count"],
                    "sampled_pinned_git_blobs": len(set(sample)),
                    "baseline": times["baseline"], "candidate": times["candidate"],
                    "peak_rss_change_percent": round(
                        100 * (candidate_rss - baseline_rss) / baseline_rss, 2),
                }
                report["profiles"].append(profile_report)
        # The current disk-backed baseline already saves RAM. This change
        # deliberately spends a bounded amount of memory to avoid 50k ZIP
        # filesystem seeks. Reject unbounded RSS increases and a large-tree
        # slowdown; report observed memory/latency for every profile.
        for item in report["profiles"]:
            if item["candidate"]["peak_rss_kib"] > 1.5 * item["baseline"]["peak_rss_kib"]:
                raise AssertionError(f"more than 50% peak-RSS regression: {item['profile']}")
            if item["profile"] == "scale-50k":
                before = item["baseline"]["elapsed_ms"]
                after = item["candidate"]["elapsed_ms"]
                if after > 1.1 * before:
                    raise AssertionError("50k-member latency regressed more than 10%")
        if report["status"] != "SKIP":
            report["status"] = "PASS"
    except Exception as exc:
        report["error"] = str(exc)
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["status"] in ("PASS", "SKIP") else 1


if __name__ == "__main__":
    raise SystemExit(main())

FILE	"scripts/stage1_sandbox_task_trial.py"	5139	81ef7fac52a2eda3e3d8a7fd7b159c6a9be4ef379d6c34f05b91358ee12a4fd0
#!/usr/bin/env python3
"""Real pinned Git -> verified RGP -> sandbox workspace -> byte-for-byte source audit.

This is the agent's working-context *filesystem* path, not a model quality
score. Frozen SHA-256 is read independently from committed corpus checkpoints.
No archived code is imported or executed.
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
sys.path.insert(0, str(ROOT / "scripts"))
from rgp_sandbox import export_workspace, METADATA  # noqa: E402
from rgp_reader import Reader, RgpError  # noqa: E402
from gate_b import strict_json  # noqa: E402


def run(repository: str, artifact: Path, source_repo: Path, output: Path) -> dict:
    plan = strict_json(ROOT / "benchmarks/gate_b/plan.json")
    checkpoints = strict_json(ROOT / "benchmarks/gate_b/corpus_preparation.json")
    pinned = next(r for r in plan["repositories"] if r["id"] == repository)
    anchor = next(r for r in checkpoints["artifacts"] if r["repository"] == repository)
    assert anchor["source_commit"] == pinned["commit"], "inconsistent external trust anchor"
    start = time.perf_counter_ns()
    # An authenticated RGP from the wrong commit must be rejected before
    # any workspace is created. Verify this on genuine pinned artifacts.
    other_commit = ("f" if pinned["commit"][0] != "f" else "e") * len(pinned["commit"])
    try:
        export_workspace(artifact, output, anchor["sha256"],
                         expected_commit=other_commit)
    except RgpError as error:
        assert error.code == "STALE_SNAPSHOT", f"wrong error: {error}"
    else:
        raise AssertionError("stale but authentic RGP was accepted")
    assert not output.exists(), "stale RGP created a workspace"
    report = export_workspace(artifact, output, anchor["sha256"],
                              expected_commit=pinned["commit"])
    reader = Reader(artifact)
    assert report["source_commit"] == pinned["commit"]
    assert report["snapshot_complete"] is True, "pinned repo unexpectedly partial"
    assert report["files_exported"] == anchor["included_files"]
    asserted = []
    for entry in reader.manifest["files"]:
        path = entry["path"]
        wanted = subprocess.check_output(
            ["git", "-C", str(source_repo), "show", f"{pinned['commit']}:{path}"])
        actual = (output / path).read_bytes()
        assert actual == wanted, f"sandbox source differs from original pinned Git: {path}"
        assert (output / path).stat().st_mode & 0o111 == 0, "source became executable"
        assert not (output / path).is_symlink(), "real symlink escaped into workspace"
        asserted.append(path)
    assert (output / METADATA).is_file()
    assert json.loads((output / METADATA).read_text()) == report
    assert sum(1 for x in output.rglob("*") if x.is_file()) == len(asserted) + 1, (
        "unexpected file or extra source in workspace")
    return {
        "kind": "rgp_sandbox_real_source_workflow",
        "status": "PASS",
        "repository": repository,
        "source_commit": pinned["commit"],
        "artifact_sha256_matched_committed_external_checkpoint": True,
        "valid_but_stale_commit_rejected": True,
        "expected_commit_matches_pinned_git": report["expected_commit"] == pinned["commit"],
        "files_exported": len(asserted),
        "source_files_compared_byte_for_byte_to_git": len(asserted),
        "bytes_exported": report["bytes_exported"],
        "source_snapshot_complete": report["snapshot_complete"],
        "symlink_entries_written_as_inert_regular_files": len(
            report["symlinks_materialized_as_regular_text_files"]),
        "all_file_executable_bits_cleared": True,
        "elapsed_ms_including_local_git_checks": round((time.perf_counter_ns() - start) / 1e6, 3),
        "source_code_execution": "NONE",
        "model_task_quality": "NOT_MEASURED_BY_THIS_SCRIPT",
        "gate_b": "HOLD",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", required=True,
                        choices=("rgp", "serde_json", "itsdangerous"))
    parser.add_argument("--artifact", type=Path, required=True)
    parser.add_argument("--source-repo", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--report", type=Path, required=True)
    args = parser.parse_args()
    try:
        result = run(args.repository, args.artifact, args.source_repo, args.output)
    except Exception as error:
        result = {"kind": "rgp_sandbox_real_source_workflow", "status": "FAIL",
                  "repository": args.repository, "reason": str(error),
                  "gate_b": "HOLD"}
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n")
    print(json.dumps(result, sort_keys=True, indent=2))
    return int(result["status"] != "PASS")


if __name__ == "__main__":
    raise SystemExit(main())

FILE	"scripts/stage1_scale.py"	9376	5b4df97134d12ee1b3b0a8b1ab886f36b291894b5e3d36a96573f0a61582c9b0
#!/usr/bin/env python3
"""Stage 1: 50,000-member RGP boundary from a real synthetic Git commit.

Generates 50,005 distinct Git blobs using git fast-import (no filesystem
checkout), tests the 49,999-blob + manifest ZIP boundary, verifies exact
source reads, pagination, deterministic bytes and honest exclusions.
CI artifacts contain JSON measurements only. No model or third-party Python.
"""
from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import resource
import subprocess
import sys
import tempfile
import time
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
sys.path.insert(0, str(ROOT / "scripts"))
from rgp_reader import Reader, RgpError, decode_transport  # noqa: E402
from stage1_corpus import measured  # noqa: E402

FILES = 50_005
CAP = 49_999
SAMPLE = (0, 9_999, 25_000, CAP - 1)


def demand(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def path_for(index: int) -> str:
    return f"src/scale/file-{index:05d}.txt"


def content_for(index: int) -> bytes:
    return f"source_{index:05d} = exactly_pinned_git_blob_{index:05d}\n".encode()


def commit_many(repo: Path, count: int) -> str:
    subprocess.run(["git", "init", "-q", str(repo)], check=True)
    process = subprocess.Popen(
        ["git", "-C", str(repo), "fast-import", "--quiet"],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    try:
        assert process.stdin is not None
        stream = process.stdin
        # Deliberately stream every object; do not build a 50k-file
        # working tree or hold all source bytes in the Python harness.
        for index in range(count):
            data = content_for(index)
            stream.write(f"blob\nmark :{index + 1}\ndata {len(data)}\n".encode())
            stream.write(data)
            stream.write(b"\n")
        stream.write(b"commit refs/heads/main\n")
        stream.write(
            b"author RGP Scale <rgp-scale@example.invalid> 1577836800 +0000\n"
            b"committer RGP Scale <rgp-scale@example.invalid> 1577836800 +0000\n"
            b"data 20\nstage1 scale fixture\n"
        )
        stream.write(b"deleteall\n")
        for index in range(count):
            stream.write(f"M 100644 :{index + 1} {path_for(index)}\n".encode())
        stream.write(b"\n")
        stream.close()
        assert process.stderr is not None
        stderr = process.stderr.read()
        assert process.stdout is not None
        stdout = process.stdout.read()
        result = process.wait()
        demand(result == 0, f"git fast-import failed: {stderr[-800:]!r}, {stdout[-200:]!r}")
    finally:
        if process.poll() is None:
            process.kill()
            process.wait()
    # A new Git repository may have HEAD on master while fast-import
    # committed refs/heads/main. Rust verify --repo checks HEAD.
    subprocess.run(["git", "-C", str(repo), "symbolic-ref",
                    "HEAD", "refs/heads/main"], check=True)
    return subprocess.check_output(
        ["git", "-C", str(repo), "rev-parse", "refs/heads/main"], text=True
    ).strip()


def run(binary: Path) -> dict:
    with tempfile.TemporaryDirectory(prefix="rgp-stage1-50k-") as folder:
        root = Path(folder)
        repo = root / "source"
        commit = commit_many(repo, FILES)
        first, second = root / "first.rgp", root / "second.rgp"
        cmd = [str(binary), "generate", "--repo", str(repo),
               "--rev", commit]
        gen_first = measured([*cmd, "--output", str(first)], root / "first.time")
        gen_second = measured([*cmd, "--output", str(second)], root / "second.time")
        raw = first.read_bytes()
        demand(raw == second.read_bytes(), "large Git snapshot not deterministic")
        verification = measured([str(binary), "verify", "--artifact", str(first),
                                 "--repo", str(repo)], root / "verify.time")
        start = time.perf_counter_ns()
        reader = Reader(first)
        reader_ms = round((time.perf_counter_ns() - start) / 1e6, 3)
        summary = reader.overview()
        demand(reader.validate()["valid"], "Reader validation failed")
        demand(summary["source_commit"] == commit, "wrong pinned source commit")
        demand(summary["file_count"] == CAP, "file inclusion exceeded capacity")
        demand(not summary["snapshot_complete"], "capacity truncation claimed complete")
        demand(summary["excluded_by_reason"].get("entry_limit") == FILES - CAP,
               "entry-limit exclusions not disclosed")
        demand(summary["index_coverage"] == "not_indexed",
               "index coverage hallucinated at scale")
        demand(raw.startswith(b"RGP/2.0\n"), "expected raw UTF-8 source transport")
        source_sections = len(reader._files)
        demand(source_sections == CAP, "plaintext source section limit")
        # All paths are covered by the public paginated tree operation,
        # not by inspecting the Reader's private path map.
        pages = 0
        count = 0
        cursor = None
        previous = None
        pagination_started = time.perf_counter_ns()
        while True:
            page = reader.tree(limit=200, cursor=cursor)
            paths = page["paths"]
            demand(bool(paths) and paths == sorted(paths), "tree pages out of order")
            demand(previous is None or previous < paths[0], "overlapping pagination pages")
            previous = paths[-1]
            count += len(paths)
            pages += 1
            cursor = page["next_cursor"]
            if cursor is None:
                break
            demand(pages <= 251, "cursor failed to terminate")
        pagination_ms = round((time.perf_counter_ns() - pagination_started) / 1e6, 3)
        demand(count == CAP and pages == 250, "tree enumeration incomplete")
        for index in SAMPLE:
            path = path_for(index)
            expected = subprocess.check_output(
                ["git", "-C", str(repo), "show", f"{commit}:{path}"])
            demand(reader.read(path, 1, 1)["content"].encode() == expected,
                   f"read mismatch against pinned Git: {path}")
            needle = f"exactly_pinned_git_blob_{index:05d}"
            found = reader.search(needle, paths=[path], limit=1)
            demand([m["line"] for m in found["matches"]] == [1]
                   and found["next_cursor"] is None,
                   f"search failed against pinned Git: {path}")
        excluded = path_for(FILES - 1)
        demand(subprocess.check_output([
            "git", "-C", str(repo), "show", f"{commit}:{excluded}"]) == content_for(FILES - 1),
            "excluded source was absent from original Git")
        for index in (CAP, FILES - 1):
            try:
                reader.read(path_for(index))
            except RgpError as exc:
                demand(exc.code == "PARTIAL_SNAPSHOT", "excluded read wrong error")
            else:
                raise AssertionError("excluded source was readable")
        try:
            Reader(raw[:-10])
        except RgpError as exc:
            demand(exc.code == "TRUNCATED_ARTIFACT", "unexpected truncation rejection")
        else:
            raise AssertionError("truncated large artifact accepted")

        return {
            "kind": "stage1_synthetic_git_50k_member_acceptance",
            "status": "PASS", "source_commit": commit,
            "source_files": FILES, "included_files": CAP,
            "excluded_files": FILES - CAP,
            "plain_source_sections": source_sections,
            "rgp_sha256": hashlib.sha256(raw).hexdigest(),
            "rgp_bytes": len(raw), "pagination_pages": pages,
            "sampled_git_source_checks": len(SAMPLE),
            "timings": {"generation_first": gen_first,
                        "generation_second": gen_second,
                        "rust_verification": verification,
                        "reader_validation_ms": reader_ms,
                        "full_pagination_ms": pagination_ms},
            "harness_peak_rss_kib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
            "gate_b": "HOLD",
            "not_measured": ["GitHub connector latency", "agent inference tokens",
                             "independent natural-language grading"],
            "note": "Synthetic pinned Git commit; text section integrity checked by Rust and Python; partial snapshot is deliberate at member cap.",
        }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--rust-cli", type=Path, default=ROOT / "target/release/rgp")
    parser.add_argument("--report", type=Path, required=True)
    args = parser.parse_args()
    try:
        report = run(args.rust_cli.resolve())
    except Exception as exc:
        report = {"kind": "stage1_synthetic_git_50k_member_acceptance",
                  "status": "FAIL", "reason": str(exc), "gate_b": "HOLD"}
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) + "\n")
    print(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2))
    return int(report["status"] != "PASS")


if __name__ == "__main__":
    raise SystemExit(main())

FILE	"scripts/stage1_stress.py"	10103	12be2d4b538187dbc86fc5f20b14b65c724ad65832812573baf3a0233b2f22c6
#!/usr/bin/env python3
"""Stage 1 synthetic stress and resource-boundary acceptance (stdlib only).

This creates a temporary, reproducible Git repository from test data.
No source archive or synthetic large blob is committed or uploaded.
All assertions use the *actual generated RGP* and independent Git bytes.
"""
from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import subprocess
import sys
import tempfile
import time
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
sys.path.insert(0, str(ROOT / "scripts"))
from rgp_reader import Reader, RgpError, decode_transport  # noqa: E402
from stage1_corpus import measured  # noqa: E402

MIB = 1024 * 1024
PROFILES = ("many-files", "incompressible", "compressible", "disk-fallback", "oversized")


def insist(ok: bool, detail: str) -> None:
    if not ok:
        raise AssertionError(detail)


def call(*args: str, env: dict | None = None) -> bytes:
    result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            check=False, env=env)
    if result.returncode:
        raise RuntimeError(f"command {args[:3]!r} exited {result.returncode}: "
                           f"{result.stderr[-600:].decode(errors='replace')}")
    return result.stdout


def make_source(repo: Path, profile: str) -> tuple[str, dict[str, bytes]]:
    insist(profile in PROFILES, "unrecognized stress profile")
    call("git", "init", "-q", str(repo))
    originals: dict[str, bytes] = {}

    def noise(seed: bytes, size: int) -> bytes:
        # Deterministic ASCII high-entropy data, not binary ZIP fixtures.
        return hashlib.shake_256(seed).digest(size // 2 + size % 2).hex().encode()[:size]

    if profile == "many-files":
        for index in range(2000):
            path = f"src/group-{index // 200:02d}/module-{index:04d}.txt"
            data = noise(f"RGP-stress-file-{index}".encode(), 1024)
            originals[path] = data
    elif profile == "incompressible":
        originals["data/incompressible.txt"] = noise(
            b"RGP-incompressible-12MiB", 12 * MIB)
    elif profile == "compressible":
        originals["data/compressible.txt"] = (b"A" * 4095 + bytes([10])) * 3072
    elif profile == "disk-fallback":
        # 36 MiB of readable high-entropy source exercises disk staging.
        for index in range(3):
            originals[f"data/disk-{index}.txt"] = noise(
                f"RGP-disk-fallback-{index}".encode(), 12 * MIB)
    else:
        # Exceed the documented per-file cap by one byte: must be EXCLUDED,
        # not mislabeled as a complete snapshot or a successful read.
        originals["data/oversized.bin"] = b"Z" * (16 * MIB + 1)
        originals["README.md"] = b"visible source stays available\n"

    for relative, data in originals.items():
        path = repo / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
    call("git", "-C", str(repo), "add", "--", ".")
    environment = dict(os.environ,
                       GIT_AUTHOR_DATE="2020-01-01T00:00:00+00:00",
                       GIT_COMMITTER_DATE="2020-01-01T00:00:00+00:00",
                       TZ="UTC")
    call("git", "-C", str(repo),
         "-c", "user.name=RGP Stress",
         "-c", "user.email=rgp-stress@example.invalid",
         "-c", "commit.gpgsign=false",
         "commit", "-q", "-m", f"stress {profile}", env=environment)
    commit = call("git", "-C", str(repo), "rev-parse", "HEAD").decode().strip()
    return commit, originals


def run(profile: str, binary: Path) -> dict:
    with tempfile.TemporaryDirectory(prefix=f"rgp-stress-{profile}-") as folder:
        workspace = Path(folder)
        repo = workspace / "source"
        commit, source = make_source(repo, profile)
        first, second = workspace / "first.rgp", workspace / "second.rgp"
        base = [str(binary), "generate", "--repo", str(repo), "--rev", commit]
        first_metrics = measured([*base, "--output", str(first)], workspace / "gen1.txt")
        second_metrics = measured([*base, "--output", str(second)], workspace / "gen2.txt")
        first_bytes = first.read_bytes()
        insist(first_bytes == second.read_bytes(), "non-deterministic stress RGP")
        verify_metrics = measured([str(binary), "verify", "--artifact", str(first),
                                   "--repo", str(repo)], workspace / "verify.txt")
        start = time.perf_counter_ns()
        reader = Reader(first)
        reader_validation_ms = round((time.perf_counter_ns() - start) / 1e6, 3)
        overview = reader.overview()
        insist(overview["source_commit"] == commit and reader.validate()["valid"],
               "source revision or RGP integrity mismatch")
        insist(first_bytes.startswith(b"RGP/2.0\n"), "expected readable transport")
        insist(b"\nFILE\t" in first_bytes, "missing plaintext file sections")

        observed_source_sha = {}
        for path, expected in source.items():
            independent = call("git", "-C", str(repo), "show", f"{commit}:{path}")
            insist(expected == independent, f"fixture Git source mismatch: {path}")
            if profile == "oversized" and path == "data/oversized.bin":
                try:
                    reader.read(path)
                except RgpError as exc:
                    insist(exc.code == "PARTIAL_SNAPSHOT", "oversized file wrong error")
                else:
                    raise AssertionError("oversized source unexpectedly readable")
                continue
            actual = reader._blob(path)  # Private helper used for byte-fidelity only.
            insist(actual == independent, f"RGP bytes differ from Git: {path}")
            observed_source_sha[path] = hashlib.sha256(actual).hexdigest()
            if path.endswith(".txt") and profile == "compressible":
                found = reader.search("AAAA", paths=[path], limit=1)
                insist(found["matches"][0]["line"] == 1, "large-text search failed")
                insist(reader.read(path, 1, 1)["content"] == expected.splitlines(keepends=True)[0].decode(),
                       "line reading lost large source bytes")
        if profile == "many-files":
            paths = set()
            cursor = None
            while True:
                page = reader.tree(limit=79, cursor=cursor)
                insist(not paths.intersection(page["paths"]), "pagination duplicate")
                paths.update(page["paths"])
                cursor = page["next_cursor"]
                if cursor is None:
                    break
            insist(paths == set(source), "many-file pagination lost paths")
        if profile == "compressible":
            insist(overview["snapshot_complete"], "compressible valid source marked partial")
        if profile in ("incompressible", "disk-fallback"):
            insist(overview["snapshot_complete"], "incompressible valid source marked partial")
        if profile == "disk-fallback":
            insist(overview["file_count"] == 3, "disk fallback lost source files")
            insist(len(first_bytes) > 32 * MIB, "did not exercise large plaintext transport")
        if profile == "oversized":
            insist(not overview["snapshot_complete"], "oversized source misrepresented as complete")
            insist(overview["excluded_by_reason"].get("size_limit") == 1,
                   "oversized source missing explicit exclusion")
        if profile == "many-files":
            insist(overview["file_count"] == 2000 and overview["snapshot_complete"],
                   "many-file snapshot incomplete")
        # Fail closed if the real generated artifact is truncated.
        try:
            Reader(first_bytes[:-10])
        except RgpError as exc:
            insist(exc.code == "TRUNCATED_ARTIFACT", "unexpected truncation result")
        else:
            raise AssertionError("truncated stress RGP accepted")

        return {
            "kind": "stage1_synthetic_stress_not_external_benchmark",
            "status": "PASS", "profile": profile, "source_commit": commit,
            "rgp_sha256": hashlib.sha256(first_bytes).hexdigest(),
            "rgp_bytes": len(first_bytes), "file_count": overview["file_count"],
            "excluded_by_reason": overview["excluded_by_reason"],
            "snapshot_complete": overview["snapshot_complete"],
            "stored_blob_count": 0,
            "verified_included_source_count": len(observed_source_sha),
            "timings": {"generate_first": first_metrics,
                        "generate_second": second_metrics,
                        "verify": verify_metrics,
                        "reader_validate_ms": reader_validation_ms},
            "limits": {"per_file_bytes": 16 * MIB, "max_inflated_bytes": 128 * MIB},
            "gate_b": "HOLD", "notes": [
                "local generated Git fixture, no public repository data",
                "no measured GitHub connector transport, inference tokens or real-world speedup",
                "GNU time wall-time resolution is 10 ms; cache and host may vary",
            ],
        }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", choices=PROFILES, required=True)
    parser.add_argument("--rust-cli", type=Path, default=ROOT / "target/release/rgp")
    parser.add_argument("--report", type=Path, required=True)
    args = parser.parse_args()
    try:
        report = run(args.profile, args.rust_cli.resolve())
    except Exception as exc:
        report = {"kind": "stage1_synthetic_stress_not_external_benchmark",
                  "status": "FAIL", "profile": args.profile,
                  "reason": str(exc), "gate_b": "HOLD"}
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(report, sort_keys=True, indent=2) + "\n")
    print(json.dumps(report, indent=2))
    return 0 if report["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())

