#!/usr/bin/env python3
"""Recompute the Gate B source-line index from three verified pinned RGP files.

Uses only the trusted Python stdlib Reader. No source code from the snapshots
is executed or extracted to the filesystem.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))

from rgp_reader import Reader, RgpError  # noqa: E402
from gate_b import ProtocolError, digest_plan, require, strict_json, validate_plan  # noqa: E402
from gate_b_review import validate_source_line_counts  # noqa: E402


def make_source_line_index(plan: dict, observations: dict, checkpoint: dict,
                           rgp_dir: Path) -> dict:
    validate_plan(plan)
    require(isinstance(checkpoint, dict) and isinstance(checkpoint.get("artifacts"), list),
            "missing RGP corpus checkpoint")
    by_repo = {a["repository"]: a for a in checkpoint["artifacts"]
               if isinstance(a, dict) and isinstance(a.get("repository"), str)}
    repos = {repo["id"]: repo for repo in plan["repositories"]}
    require(set(by_repo) == set(repos), "RGP checkpoint repositories do not match plan")
    row_index = {(r["task_id"], r["arm"]): r for r in observations["observations"]}
    entries = []
    seen = set()
    for repo_id, repo in repos.items():
        raw = (rgp_dir / (repo_id + ".rgp")).read_bytes()
        artifact = by_repo[repo_id]
        require(hashlib.sha256(raw).hexdigest() == artifact["sha256"],
                f"{repo_id}: RGP SHA-256 checkpoint mismatch")
        require(len(raw) == artifact["rgp_bytes"], f"{repo_id}: RGP byte size mismatch")
        reader = Reader(raw)
        summary = reader.overview()
        require(summary["snapshot_complete"] is True and
                summary["source_commit"] == repo["commit"] and
                summary["included_files"] == artifact["included_files"],
                f"{repo_id}: incomplete/wrong pinned snapshot")
        for task in plan["tasks"]:
            if task["repository"] != repo_id:
                continue
            for path in task["reference_paths"]:
                key = (repo_id, path)
                if key in seen:
                    continue
                seen.add(key)
                response = reader.read(path)
                require(response["status"] == "included" and response["encoding"] == "utf-8",
                        f"{repo_id}/{path}: source must be fully included UTF-8")
                raw_blob = response["content"].encode("utf-8")
                git_sha = hashlib.sha1(
                    b"blob " + str(len(raw_blob)).encode("ascii") + b"\0" + raw_blob
                ).hexdigest()
                original = row_index[(task["id"], "github_connector")]["source_evidence"][path]
                require(git_sha == original["git_blob_sha1"],
                        f"{repo_id}/{path}: Git blob SHA-1 mismatch")
                line_count = raw_blob.count(b"\n") + int(not raw_blob.endswith(b"\n"))
                require(line_count > 0, f"{repo_id}/{path}: empty source")
                entries.append({
                    "repository": repo_id,
                    "source_commit": repo["commit"],
                    "path": path,
                    "git_blob_sha1": git_sha,
                    "line_count": line_count,
                })
    result = {
        "schema_version": "1.0",
        "plan_sha256": digest_plan(plan),
        "method": "verified_pinned_rgp_reader_plus_git_blob_sha1",
        "source_rgp_sha256": {key: by_repo[key]["sha256"] for key in by_repo},
        "files": entries,
    }
    validate_source_line_counts(plan, observations, result, checkpoint)
    return result


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--rgp-dir", type=Path, required=True)
    p.add_argument("--plan", type=Path, default=Path("benchmarks/gate_b/plan.json"))
    p.add_argument("--observations", type=Path, default=Path(
        "benchmarks/gate_b/observations.cache_fair_2026-10-29.json"))
    p.add_argument("--checkpoint", type=Path, default=Path(
        "benchmarks/gate_b/corpus_preparation.json"))
    p.add_argument("--expected", type=Path, default=Path(
        "benchmarks/gate_b/source_line_counts.json"))
    p.add_argument("--check", action="store_true",
                   help="Fail when generated data differs from the committed source index")
    args = p.parse_args()
    try:
        manifest = make_source_line_index(strict_json(args.plan),
                                          strict_json(args.observations),
                                          strict_json(args.checkpoint),
                                          args.rgp_dir)
        if args.check:
            require(manifest == strict_json(args.expected),
                    "source-line index changed from pinned RGP bytes")
            print(json.dumps({"status": "PASS", "files": len(manifest["files"]),
                              "verified_snapshots": 3}, sort_keys=True))
        else:
            print(json.dumps(manifest, ensure_ascii=False, indent=2))
    except (ProtocolError, RgpError, OSError, ValueError, TypeError, KeyError) as exc:
        p.error(str(exc))


if __name__ == "__main__":
    main()

FILE	scripts/repo_dogfood.py
#!/usr/bin/env python3
"""Validate and export the in-repository RGP snapshot for real agent work.

RGP source_commit may precede checkout HEAD by a commit changing ONLY
REPO_CONTEXT.rgp: the snapshot excludes itself, so no source code changed.
Never silently accept any other Git difference, an untracked/tampered RGP,
or a snapshot with unknown coverage. Python stdlib only.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_reader import Reader, RgpError, _require  # noqa: E402
from rgp_sandbox import export_workspace  # noqa: E402

NAME = "REPO_CONTEXT.rgp"


def git(repo: Path, *args: str) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
    )


def checked_git(repo: Path, *args: str) -> bytes:
    result = git(repo, *args)
    _require(result.returncode == 0, "STALE_SNAPSHOT",
             f"git command failed ({' '.join(args)}): {result.stderr.decode('utf-8', 'replace')[:240]}")
    return result.stdout


def check(repo: Path, artifact: Path | None = None) -> dict:
    """Require a committed, unchanged RGP matching current HEAD source bytes.

    Do not infer freshness from the RGP's own SHA-256. The local repository
    checkout is the independent Git trust anchor and source of HEAD.
    """
    repo = Path(repo).resolve(strict=True)
    artifact = (repo / NAME) if artifact is None else Path(artifact)
    _require(artifact.absolute() == (repo / NAME), "UNSAFE_PATH",
             "the dogfood snapshot must be the repository-root REPO_CONTEXT.rgp")
    _require(artifact.is_file() and not artifact.is_symlink(),
             "UNSUPPORTED_FORMAT", "the tracked RGP file is absent or not a regular file")
    head = checked_git(repo, "rev-parse", "--verify", "HEAD^{commit}").decode().strip()
    # Check that the *same actual bytes* exist at HEAD, not a modified local file.
    committed = checked_git(repo, "show", f"{head}:{NAME}")
    actual = artifact.read_bytes()
    _require(actual == committed, "HASH_MISMATCH",
             "local REPO_CONTEXT.rgp differs from committed Git blob")
    reader = Reader(actual)
    overview = reader.overview()
    # The transport is structurally checked; Git HEAD anchors its authenticity.
    _require(overview["snapshot_complete"], "PARTIAL_SNAPSHOT",
             "in-repository source snapshot is not complete")
    source = overview["source_commit"]
    if source is None and overview["transport"] == "RGP/0.1.0":
        # RGP/0.1.0 intentionally contains no commit/hash text. Recover the
        # source revision ONLY from independently trusted local Git history.
        # Find the last publication commit, even if later source commits exist.
        publication = checked_git(repo, "log", "-1", "--format=%H", "HEAD",
                                  "--", NAME).decode().strip()
        source = publication or head
        if publication:
            parent_result = git(repo, "rev-parse", f"{publication}^")
            if parent_result.returncode == 0:
                parent = parent_result.stdout.decode().strip()
                changed = checked_git(repo, "diff", "--name-only",
                                      parent, publication).decode().splitlines()
                if changed == [NAME]:
                    source = parent

        # Check all included source bytes against Git at the chosen revision.
        # The RGP's in-memory derived SHA is never accepted as provenance.
        cursor = None
        seen = 0
        while True:
            page = reader.tree(limit=200, cursor=cursor)
            for path in page["paths"]:
                committed_source = checked_git(repo, "show", f"{source}:{path}")
                _require(reader.read_bytes(path) == committed_source, "HASH_MISMATCH",
                         f"RGP source differs from trusted Git: {path}")
                seen += 1
            cursor = page["next_cursor"]
            if cursor is None:
                break
        _require(seen == overview["file_count"], "HASH_MISMATCH", "RGP file index incomplete")
    checked_git(repo, "cat-file", "-e", f"{source}^{{commit}}")
    ancestor = git(repo, "merge-base", "--is-ancestor", source, head)
    _require(ancestor.returncode == 0, "STALE_SNAPSHOT",
             "RGP source commit is not an ancestor of checkout HEAD")
    # Only the tracked RGP is excluded from the input digest.
    # Publication may change only this file after source commit A. Other
    # changes (even docs and tests) make the snapshot stale.
    diff = git(repo, "diff", "--quiet", source, head,
               "--", ".", f":(exclude){NAME}")
    _require(diff.returncode == 0, "STALE_SNAPSHOT",
             "source files differ from the RGP commit; refresh the snapshot")
    # Local working-tree modifications are not represented by a pinned Git
    # snapshot, even when committed HEAD is source-equivalent. Refuse to
    # present the snapshot as a complete view of modified agent work.
    worktree = git(repo, "diff", "--quiet", "HEAD",
                   "--", ".", f":(exclude){NAME}")
    _require(worktree.returncode == 0, "STALE_SNAPSHOT",
             "tracked working-tree files differ from HEAD")
    staged = git(repo, "diff", "--cached", "--quiet", "HEAD",
                 "--", ".", f":(exclude){NAME}")
    _require(staged.returncode == 0, "STALE_SNAPSHOT",
             "staged source changes are not in the RGP")
    untracked = checked_git(repo, "ls-files", "--others", "--exclude-standard", "-z")
    _require(not untracked, "STALE_SNAPSHOT",
             "untracked source files are absent from the Git-pinned RGP")
    digest = hashlib.sha256(actual).hexdigest()
    return {
        "status": "PASS",
        "artifact": NAME,
        "artifact_sha256": digest,
        "source_commit": source,
        "checkout_commit": head,
        "snapshot_equivalent_to_checkout": True,
        "commit_difference_is_artifact_only": source != head,
        "snapshot_complete": True,
        "file_count": overview["file_count"],
        "included_source_bytes": overview["included_bytes"],
        "validation": "committed Git blob, Reader integrity, Git ancestry and all-source diff",
        "gate_b": "HOLD",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("check", "export"):
        command = sub.add_parser(name)
        command.add_argument("--repo", type=Path, default=ROOT)
        if name == "export":
            command.add_argument("--output", required=True, type=Path)
            command.add_argument("--prefix", default="")
            command.add_argument("--max-files", type=int, default=1000)
            command.add_argument("--max-bytes", type=int, default=32 * 1024 * 1024)
    args = parser.parse_args()
    try:
        report = check(args.repo)
        if args.command == "export":
            # check() has already established that the Git-tracked snapshot
            # represents HEAD's complete source tree, though source_commit
            # can differ by the inevitable artifact-only publication commit.
            output = export_workspace(
                Path(args.repo).resolve() / NAME, args.output,
                report["artifact_sha256"], expected_commit=report["source_commit"],
                attested_source_commit=report["source_commit"],
                prefix=args.prefix, max_files=args.max_files,
                max_bytes=args.max_bytes)
            report["export"] = {
                "directory": str(args.output),
                "files_exported": output["files_exported"],
                "bytes_exported": output["bytes_exported"],
            }
    except (OSError, RgpError, ValueError) as exc:
        parser.exit(2, f"{exc}\n")
    print(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

FILE	scripts/stage1_acceptance.py
#!/usr/bin/env python3
"""Stage 1 acceptance: answer real source questions using a generated RGP.

No model, network, GitHub connector or third-party Python packages required.
This is an agent-owned *functional* check, not the comparative Gate B trial.
The emitted JSON contains only evidence metadata, never source bytes.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_reader import Reader, RgpError  # noqa: E402

# Freeze task descriptions BEFORE inspecting the generated RGP.
# Their answers must agree with the original Git commit, not another RGP.
TASKS = (
    ("generator definition", "src/main.rs", "fn generate("),
    ("trusted Reader class", "python/rgp_reader.py", "class Reader:"),
    ("product stage 1", "docs/PRODUCT_ROADMAP.md", "## Этап 1."),
)


def git(repo: Path, *args: str) -> bytes:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    ).stdout


def run(*args: str) -> None:
    result = subprocess.run(list(args), text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(
            f"command failed ({result.returncode}): {args!r}\n"
            f"{result.stdout[-1500:]}\n{result.stderr[-1500:]}"
        )


def check(repo: Path, rust_cli: Path) -> dict:
    commit = git(repo, "rev-parse", "--verify", "HEAD^{commit}").decode().strip()
    evidence = {"status": "FAIL", "stage": 1, "source_commit": commit,
                "tasks": [], "checks": [], "gate_b": "HOLD"}
    with tempfile.TemporaryDirectory(prefix="rgp-stage1-") as d:
        work = Path(d)
        first, second, shared = (work / n for n in ("first.rgp", "second.rgp", "shared.rgp"))
        command = [str(rust_cli), "generate", "--repo", str(repo), "--rev", commit]
        run(*command, "--output", str(first))
        run(*command, "--output", str(second))
        data = first.read_bytes()
        assert data == second.read_bytes(), "nondeterministic RGP bytes"
        inline = Reader(first).overview()
        assert inline["transport"] == "RGP/0.1.0", "missing standalone transport"
        assert inline["embedded_instructions"], "missing inline agent instructions"
        assert inline["source_commit"] is None, "RGP must not contain Git hash"
        evidence["checks"].append("hash-free RGP; externally verified Git source")
        evidence["artifact_sha256"] = hashlib.sha256(data).hexdigest()
        evidence["artifact_bytes"] = len(data)
        evidence["checks"].append("deterministic RGP generated twice")
        run(str(rust_cli), "verify", "--artifact", str(first), "--repo", str(repo))
        reader = Reader(first)
        assert reader.validate()["valid"] is True
        assert reader.overview()["source_commit"] is None
        assert reader.coverage("index")["status"] == "not_indexed"
        assert reader.coverage("graph")["status"] == "not_indexed"
        assert reader.coverage("investigation")["status"] == "unknown"
        evidence["snapshot_status"] = reader.overview()["status"]
        evidence["checks"].append("Rust verify + Python validate + honest coverage")

        # Exercise tree, whole-file reads and line search through the RGP,
        # comparing their actual answers with Git at the *same pinned commit*.
        paths = set()
        cursor = None
        while True:
            page = reader.tree(limit=20, cursor=cursor)
            paths.update(page["paths"])
            cursor = page["next_cursor"]
            if cursor is None:
                break
        assert len(paths) == reader.overview()["file_count"], "tree pagination lost paths"
        for title, path, needle in TASKS:
            assert path in paths, f"source absent from snapshot: {path}"
            original = git(repo, "show", f"{commit}:{path}")
            decoded = original.decode("utf-8")
            result = reader.read(path)
            assert result["content"] == decoded, f"source mismatch: {path}"
            expected = [i for i, line in enumerate(decoded.splitlines(), 1) if needle in line]
            hits = reader.search(needle, paths=[path], limit=100)
            actual = [h["line"] for h in hits["matches"]]
            assert expected and actual == expected and hits["next_cursor"] is None, (
                f"incorrect answer for {title}: {actual} vs {expected}"
            )
            evidence["tasks"].append({
                "goal": title, "path": path, "source_sha256": hashlib.sha256(original).hexdigest(),
                "expected_lines": expected, "observed_lines": actual, "result": "PASS"
            })
        evidence["checks"].append("three predefined source tasks matched independent Git source")

        # Negative cases on the *actual* generated output, not only fixtures.
        oversized_index = re.sub(rb"index_bytes=[0-9]+", b"index_bytes=999999999",
                                 data, count=1)
        assert oversized_index != data
        for label, bad, code in (
            ("truncation", data[:-10], "TRUNCATED_ARTIFACT"),
            ("unknown version", data.replace(data.split(b"\n", 1)[0], b"RGP/9.0", 1), "UNSUPPORTED_FORMAT"),
            ("oversized index", oversized_index, "RESOURCE_LIMIT"),
        ):
            try:
                Reader(bad)
            except RgpError as exc:
                assert exc.code == code, f"{label}: unexpected error {exc.code}"
            else:
                raise AssertionError(f"{label}: invalid artifact accepted")
        try:
            reader.read("does-not-exist.src")
        except RgpError as exc:
            assert exc.code == "PARTIAL_SNAPSHOT"
        else:
            raise AssertionError("missing source unexpectedly readable")
        evidence["checks"].append("truncation, unsupported version, oversized index and absent file rejected")

        # Concurrent writers to the *same* destination must not share a
        # temporary filename. The published artifact must stay verifiable.
        children = [
            subprocess.Popen(command + ["--output", str(shared)],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            for _ in range(3)
        ]
        for child in children:
            out, err = child.communicate(timeout=180)
            assert child.returncode == 0, f"parallel generation failed: {out!r} {err!r}"
        assert shared.read_bytes() == data
        assert not list(work.glob(".*.tmp")), "staging temp files left behind"
        run(str(rust_cli), "verify", "--artifact", str(shared), "--repo", str(repo))
        evidence["checks"].append("three concurrent writers produced a valid identical artifact")
    evidence["status"] = "PASS"
    return evidence


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=ROOT)
    parser.add_argument("--rust-cli", type=Path, default=ROOT / "target/debug/rgp")
    parser.add_argument("--report", type=Path)
    args = parser.parse_args()
    try:
        report = check(args.repo.resolve(), args.rust_cli.resolve())
    except Exception as exc:
        report = {"status": "FAIL", "stage": 1, "reason": str(exc),
                  "gate_b": "HOLD"}
        print(json.dumps(report, ensure_ascii=False, indent=2), file=sys.stderr)
        if args.report:
            args.report.parent.mkdir(parents=True, exist_ok=True)
            args.report.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
        return 1
    if args.report:
        args.report.parent.mkdir(parents=True, exist_ok=True)
        args.report.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

FILE	scripts/stage1_agent_task_pilot.py
#!/usr/bin/env python3
"""Twelve preregistered coding questions: real RGP context vs pinned Git truth.

This is a *source-grounding* trial, not a hidden model inference benchmark:
the search terms below are author-selected and deliberately informed by
the frozen tasks. Each exact excerpt is compared against independent Git
objects. Do not infer LLM accuracy, token savings or connector calls.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
sys.path.insert(0, str(ROOT / "scripts"))
from rgp_reader import Reader, RgpError  # noqa: E402
from rgp_agent_context import context, compact_json  # noqa: E402
from gate_b import strict_json, validate_plan  # noqa: E402

# Term selection is explicitly *not* blinded: an assistant looked at the
# frozen reference paths and knew relevant symbols. This measures whether
# RGP supplies verifiable source material, not unaided model discovery.
TERMS = {
    "rgp-transport-hash": ("payload_length=", "payload_sha256=", "ZIP hash mismatch"),
    "rgp-git-snapshot": ("fn snapshot(", "submodule_unavailable", "pointer_only"),
    "rgp-search-cursor": ("_read_cursor", "test_search_keyset_cursor_scope_and_exhaustion"),
    "rgp-trust-boundary": ("def bootstrap(", "unsafe Actions ZIP entry", "Trust boundary"),
    "serde-json-deserializer": ("pub fn from_str(", "pub fn from_slice("),
    "serde-json-serializer": ("fn serialize_i64(", "fn serialize_f64(", "fn serialize_str("),
    "serde-json-error-position": ("pub fn line(", "pub fn column(", "pub fn classify("),
    "serde-json-ser-tests": ("fn test_write_i64()", "fn test_write_f64()",
                             "fn test_write_str()", "fn test_write_list()", "fn serialize_str("),
    "itsdangerous-timestamp": ("if age > max_age:", "if age < 0:"),
    "itsdangerous-hmac": ("class HMACAlgorithm", "mac = hmac.new(",
                           "sig = self.algorithm.get_signature"),
    "itsdangerous-deserialization": ("def load_payload(",
                                    "return self.load_payload(signer.unsign(s))", "def unsign("),
    "itsdangerous-expiry-tests": ("def test_max_age(", "if age > max_age:"),
}


def git_blob(source_repo: Path, commit: str, path: str) -> bytes:
    return subprocess.check_output([
        "git", "-C", str(source_repo), "show", f"{commit}:{path}"
    ])


def run(artifact: Path, source_repo: Path, repository: str,
        plan_file: Path = ROOT / "benchmarks/gate_b/plan.json") -> dict:
    plan = strict_json(plan_file)
    validate_plan(plan)
    expected = [task for task in plan["tasks"] if task["repository"] == repository]
    assert len(expected) == 4, "each frozen repository must have four tasks"
    assert set(TERMS) == {task["id"] for task in plan["tasks"]}, (
        "not covering the complete frozen twelve-task plan")
    repo_row = next(r for r in plan["repositories"] if r["id"] == repository)
    reader = Reader(artifact)
    overview = reader.overview()
    # The source revision for RGP/3.0 comes from the independent pinned
    # benchmark plan. Verify actual cited bytes against that Git revision.
    commit = repo_row["commit"]
    assert overview["source_commit"] in (None, commit), "RGP revision contradicts pinned Git"
    assert overview["snapshot_complete"], "a partial archive cannot ground the full task plan"

    source_cache: dict[str, bytes] = {}
    rows = []
    for task in expected:
        task_id = task["id"]
        terms = list(TERMS[task_id])
        result = context(reader, terms, max_files=4, max_bytes=24_000)
        assert not result["search_capped_terms"], f"{task_id}: lexical search was capped"
        assert not result["terms_without_source"], (
            f"{task_id}: query terms missing source passages: {result['terms_without_source']}")
        actual_paths = {s["path"] for s in result["sources"]}
        assert set(task["reference_paths"]) <= actual_paths, (
            f"{task_id}: missing reference paths: {set(task['reference_paths']) - actual_paths}")
        citations = []
        for source in result["sources"]:
            path = source["path"]
            if path not in source_cache:
                source_cache[path] = git_blob(source_repo, commit, path)
            original = source_cache[path]
            decoded = original.decode("utf-8")
            lines = decoded.splitlines(keepends=True)
            start, end, matched = source["start_line"], source["end_line"], source["match_line"]
            assert 1 <= start <= matched <= end <= len(lines), (
                f"{task_id}: invalid source location {path}:{start}-{end}")
            assert source["content"] == "".join(lines[start - 1:end]), (
                f"{task_id}: RGP excerpt differs from the pinned Git blob")
            assert source["match_term"] in lines[matched - 1], (
                f"{task_id}: source does not contain alleged search hit")
            citations.append({
                "path": path, "start_line": start, "end_line": end,
                "match_line": matched, "term": source["match_term"],
                "git_blob_sha1": hashlib.sha1(
                    b"blob " + str(len(original)).encode() + b"\0" + original
                ).hexdigest(),
            })
        rows.append({
            "task_id": task_id,
            "source_navigation": "PASS",
            "model_answer": "NOT_RUN_BY_CI",
            "answer_correctness": "NOT_INDEPENDENTLY_GRADED",
            "search_terms": terms,
            "cited_files": sorted(actual_paths),
            "source_passages": citations,
            "context_bytes": len(compact_json(result).encode("utf-8")),
            "selected_source_terms": sorted({s["match_term"] for s in result["sources"]}),
        })
    return {
        "kind": "rgp_twelve_frozen_agent_source_navigation",
        "status": "PASS",
        "repository": repository,
        "source_commit": commit,
        "source_snapshot_complete": True,
        "index_coverage": reader.coverage("index")["status"],
        "task_count": len(rows),
        "source_passages_compared_to_pinned_git": sum(len(x["source_passages"]) for x in rows),
        "unique_source_files_compared_to_pinned_git": len(source_cache),
        "github_equivalent_unique_source_bytes": sum(len(x) for x in source_cache.values()),
        "rgp_source_context_bytes": sum(x["context_bytes"] for x in rows),
        "tasks": rows,
        "model_inference": "NOT_RUN_BY_CI",
        "independent_answer_grading": "NOT_RUN",
        "provider_connector_calls": "NOT_MEASURED_BY_LOCAL_GIT",
        "gate_b": "HOLD",
        "method_limits": [
            "query terms were selected with knowledge of the frozen task references",
            "this is exact source navigation, not a blinded model answer evaluation",
            "Git show is a local source baseline, not a GitHub connector invocation",
        ],
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", choices=("rgp", "serde_json", "itsdangerous"),
                        required=True)
    parser.add_argument("--artifact", required=True, type=Path)
    parser.add_argument("--source-repo", required=True, type=Path)
    parser.add_argument("--report", required=True, type=Path)
    args = parser.parse_args()
    try:
        result = run(args.artifact, args.source_repo, args.repository)
    except (AssertionError, RgpError, ValueError, OSError,
            subprocess.CalledProcessError) as exc:
        result = {
            "kind": "rgp_twelve_frozen_agent_source_navigation",
            "status": "FAIL", "repository": args.repository,
            "reason": str(exc), "gate_b": "HOLD",
        }
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n")
    print(json.dumps(result, sort_keys=True, indent=2))
    return int(result["status"] != "PASS")


if __name__ == "__main__":
    raise SystemExit(main())

FILE	scripts/stage1_corpus.py
#!/usr/bin/env python3
"""Stage 1: pinned three-repository real-RGP acceptance and resource profiling.

This is a stdlib-only developer-side test, NOT a model runner or Gate B.
The 12 frozen task ids / reference paths come from Gate B's existing plan;
the independently chosen anchors below are a test of Reader source navigation.
They are not full natural-language answers to the Gate B task rubrics.
No source code or RGP bytes are written to the evidence JSON.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import resource
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_reader import Reader, RgpError  # noqa: E402
from gate_b import strict_json, validate_plan  # noqa: E402

# Fixed, repository-specific anchors selected before the CI experiments.
# Each plan reference path must be exercised, otherwise fail closed.
ANCHORS = {
    "rgp-transport-hash": {
        "python/rgp_reader.py": ("payload_sha256=",),
        "src/main.rs": ("payload_sha256=",),
    },
    "rgp-git-snapshot": {"src/main.rs": ("fn snapshot(",)},
    "rgp-search-cursor": {
        "python/rgp_reader.py": ("def _read_cursor(",),
        "tests/test_reader_api.py": ("def test_search_keyset_cursor_scope_and_exhaustion",),
    },
    "rgp-trust-boundary": {
        "python/rgp_bootstrap.py": ("def bootstrap(",),
        "docs/RGP_SECURITY_MODEL.md": ("Trust boundary",),
    },
    "serde-json-deserializer": {"src/de.rs": ("pub fn from_str(", "pub fn from_slice(")},
    "serde-json-serializer": {"src/ser.rs": ("fn serialize_i64(", "fn serialize_str(")},
    "serde-json-error-position": {
        "src/error.rs": ("pub fn line(", "pub fn column(", "pub fn classify("),
    },
    "serde-json-ser-tests": {
        "tests/test.rs": ("fn test_write_",),
        "src/ser.rs": ("fn serialize_str(",),
    },
    "itsdangerous-timestamp": {"src/itsdangerous/timed.py": ("class TimestampSigner", "def unsign(")},
    "itsdangerous-hmac": {"src/itsdangerous/signer.py": ("class HMACAlgorithm", "def get_signature(")},
    "itsdangerous-deserialization": {
        "src/itsdangerous/serializer.py": ("def load_payload(", "def loads("),
        "src/itsdangerous/signer.py": ("def get_signature(",),
    },
    "itsdangerous-expiry-tests": {
        "tests/test_itsdangerous/test_timed.py": ("def test_",),
        "src/itsdangerous/timed.py": ("class TimestampSigner",),
    },
}


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ValueError(message)


def tasks_for(plan: dict, repository: str) -> tuple[dict, list[dict]]:
    validate_plan(plan)
    repos = {r["id"]: r for r in plan["repositories"]}
    require(repository in repos, "unknown repository in pinned plan")
    require(set(ANCHORS) == {t["id"] for t in plan["tasks"]}, "anchor task ids diverge from frozen plan")
    for task in plan["tasks"]:
        anchor = ANCHORS[task["id"]]
        require(set(anchor) == set(task["reference_paths"]), f"anchor paths missing: {task['id']}")
        require(all(isinstance(v, tuple) and v and all(isinstance(s, str) and s for s in v)
                    for v in anchor.values()), "invalid source search anchor")
    return repos[repository], [t for t in plan["tasks"] if t["repository"] == repository]


def execute(command: list[str], *, cwd: Path | None = None) -> bytes:
    result = subprocess.run(command, cwd=cwd, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, check=False)
    if result.returncode:
        raise RuntimeError(f"command failed with status {result.returncode}: "
                           f"{command[:4]!r}; {result.stderr[-1000:].decode(errors='replace')}")
    return result.stdout


def obtain_pinned_repo(repo: dict, dest: Path) -> None:
    # Only the immutable repo and SHA in the preregistered plan are used.
    url = f"https://github.com/{repo['github']}.git"
    execute(["git", "init", "-q", str(dest)])
    execute(["git", "-C", str(dest), "remote", "add", "origin", url])
    execute(["git", "-C", str(dest), "-c", "protocol.version=2", "fetch",
             "--depth=1", "--filter=blob:none", "origin", repo["commit"]])
    execute(["git", "-C", str(dest), "checkout", "--detach", "-q", "FETCH_HEAD"])
    actual = execute(["git", "-C", str(dest), "rev-parse", "HEAD"]).decode().strip()
    require(actual == repo["commit"], "pinned source revision mismatch")


def measured(command: list[str], metrics: Path) -> dict:
    # Ubuntu CI supplies GNU time. Resource measurements are per invocation;
    # no peak-memory extrapolation across hosts or machines is legitimate.
    execute(["/usr/bin/time", "-f", "%e %M", "-o", str(metrics), *command])
    pieces = metrics.read_text().strip().split()
    require(len(pieces) == 2, "GNU time did not produce two metrics")
    return {"elapsed_ms": round(float(pieces[0]) * 1000),
            "peak_rss_kib": int(pieces[1])}


def inspect(repo: dict, tasks: list[dict], source: Path, binary: Path, work: Path) -> dict:
    commit = repo["commit"]
    first, second = work / "a.rgp", work / "b.rgp"
    cmd = [str(binary), "generate", "--repo", str(source), "--rev", commit]
    first_metrics = measured([*cmd, "--output", str(first)], work / "time-a.txt")
    second_metrics = measured([*cmd, "--output", str(second)], work / "time-b.txt")
    raw = first.read_bytes()
    require(raw == second.read_bytes(), "RGP output nondeterministic at pinned commit")
    verify_metrics = measured([str(binary), "verify", "--artifact", str(first),
                               "--repo", str(source)], work / "time-verify.txt")

    start = time.perf_counter_ns()
    reader = Reader(first)
    validate_ms = round((time.perf_counter_ns() - start) / 1e6, 3)
    overview = reader.overview()
    require(reader.validate()["valid"] and overview["source_commit"] is None,
            "Reader/commit validation failed")
    require(overview["snapshot_complete"], "fixed corpus RGP unexpectedly partial")
    require(reader.coverage("index")["status"] == "not_indexed", "semantic coverage overclaimed")

    paths = set()
    cursor = None
    while True:
        page = reader.tree(limit=17, cursor=cursor)
        require(not paths.intersection(page["paths"]), "duplicate tree paths across pages")
        paths.update(page["paths"])
        if page["next_cursor"] is None:
            break
        cursor = page["next_cursor"]
    require(len(paths) == overview["file_count"], "paginated Reader tree incomplete")
    seen_paths: dict[str, bytes] = {}
    task_rows = []
    query_count = 0
    task_start = time.perf_counter_ns()
    for task in tasks:
        rows = []
        for path in task["reference_paths"]:
            require(path in paths, f"task reference unavailable: {task['id']}:{path}")
            # Independent source-of-truth: raw git object from the pinned commit.
            original = seen_paths.get(path)
            if original is None:
                original = execute(["git", "-C", str(source), "show", f"{commit}:{path}"])
                seen_paths[path] = original
            # _blob is used for byte-fidelity verification only. All source
            # navigation tasks below use the PUBLIC read/search Reader API.
            require(reader._blob(path) == original, f"RGP content differs from Git: {path}")
            lines = original.decode("utf-8").splitlines(keepends=True)
            for needle in ANCHORS[task["id"]][path]:
                expected = [n for n, line in enumerate(lines, 1) if needle in line]
                require(0 < len(expected) < 100, f"anchor absent/ambiguous: {task['id']}:{path}")
                found = reader.search(needle, paths=[path], limit=100)
                observed = [match["line"] for match in found["matches"]]
                require(observed == expected and found["next_cursor"] is None,
                        f"search lines differ from pinned Git: {task['id']}:{path}")
                line_number = expected[0]
                from_rgp = reader.read(path, line_number, line_number)["content"]
                require(from_rgp == lines[line_number - 1],
                        f"Reader line content differs from Git: {task['id']}:{path}")
                query_count += 1
                rows.append({"path": path, "needle": needle,
                             "expected_lines": expected, "observed_lines": observed})
        task_rows.append({"task_id": task["id"], "status": "PASS", "anchors": rows})
    task_ms = round((time.perf_counter_ns() - task_start) / 1e6, 3)

    # Invalid bytes must still fail before returning any source content.
    for damaged, expected_error in (
        (raw[:-10], "TRUNCATED_ARTIFACT"),
        (raw.replace(raw.split(b"\n", 1)[0], b"RGP/9.0", 1), "UNSUPPORTED_FORMAT"),
        (re.sub(rb"index_bytes=[0-9]+", b"index_bytes=999999999", raw, count=1), "RESOURCE_LIMIT"),
    ):
        try:
            Reader(damaged)
        except RgpError as exc:
            require(exc.code == expected_error, "negative-case error changed")
        else:
            raise AssertionError("corrupted archive was accepted")
    return {
        "repository": repo["id"], "source_commit": commit, "status": "PASS",
        "transport_version": raw.split(b"\n", 1)[0].decode("ascii"),
        "rgp_sha256": hashlib.sha256(raw).hexdigest(), "rgp_bytes": len(raw),
        "included_files": overview["file_count"], "unique_reference_files": len(seen_paths),
        "query_count": query_count, "tasks": task_rows,
        "timings": {"generate_first": first_metrics, "generate_second": second_metrics,
                    "verify": verify_metrics, "reader_validate_ms": validate_ms,
                    "source_navigation_ms": task_ms},
        "reader_process_peak_rss_kib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
        "checks": ["determinism", "Rust verification", "Reader completeness",
                   "all pinned source bytes", "source-based read/search",
                   "tree pagination", "invalid transport rejection"],
    }


def match_checkpoint(corpus: dict, result: dict) -> str:
    """Check pinned source identity, not obsolete transport bytes."""
    rows = corpus.get("artifacts")
    require(isinstance(rows, list), "missing pinned checkpoint artifacts")
    checkpoints = [r for r in rows if r.get("repository") == result["repository"]]
    require(len(checkpoints) == 1, "missing or duplicate RGP checkpoint")
    expected = checkpoints[0]
    for key in ("source_commit", "included_files"):
        require(expected.get(key) == result.get(key), f"pinned source regression: {key}")
    require(result.get("transport_version") == "RGP/0.1.0",
            "unsupported transport checkpoint version")
    return "SOURCE_EQUIVALENCE_ONLY"


def run(repository: str, binary: Path, plan_file: Path, checkpoint_file: Path) -> dict:
    plan = strict_json(plan_file)
    repo, tasks = tasks_for(plan, repository)
    from gate_b import digest_plan
    with tempfile.TemporaryDirectory(prefix="rgp-stage1-corpus-") as folder:
        work = Path(folder)
        source = work / "source"
        obtain_pinned_repo(repo, source)
        result = inspect(repo, tasks, source, binary.resolve(), work)
    result["pinned_v1_format_compatibility"] = match_checkpoint(
        strict_json(checkpoint_file), result)
    result.update({
        "kind": "stage1_corpus_source_functional_and_resource_diagnostic",
        "plan_sha256": digest_plan(plan),
        "gate_b": "HOLD",
        "not_measured": ["GitHub connector calls", "model tokens", "agent answer grading",
                         "connector transport", "end-to-end acquisition latency"],
        "environment": "GitHub Actions ubuntu-latest, same runner per repository",
    })
    return result


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--repository", choices=("rgp", "serde_json", "itsdangerous"), required=True)
    p.add_argument("--rust-cli", type=Path, default=ROOT / "target/release/rgp")
    p.add_argument("--plan", type=Path, default=ROOT / "benchmarks/gate_b/plan.json")
    p.add_argument("--checkpoint", type=Path, default=ROOT / "benchmarks/gate_b/corpus_preparation.json")
    p.add_argument("--report", type=Path, required=True)
    args = p.parse_args()
    try:
        result = run(args.repository, args.rust_cli, args.plan, args.checkpoint)
    except Exception as exc:
        result = {"kind": "stage1_corpus_source_functional_and_resource_diagnostic",
                  "repository": args.repository, "status": "FAIL",
                  "reason": str(exc), "gate_b": "HOLD"}
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(result, ensure_ascii=False, sort_keys=True, indent=2) + "\n")
    print(json.dumps(result, ensure_ascii=False, sort_keys=True, indent=2))
    return 0 if result["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())

FILE	scripts/stage1_mcp_agent_trial.py
#!/usr/bin/env python3
"""Full real Git -> RGP -> MCP stdio tool -> pinned Git evidence exercise.

Four previously frozen coding tasks per repo, with the exact same
source anchors as the existing agent-context protocol. This validates
that an *external MCP client* can navigate real source using just
tool calls, not Python imports of Reader. It is not LLM inference.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))
from gate_b import strict_json, validate_plan  # noqa: E402
from stage1_agent_task_pilot import TERMS  # noqa: E402


class Client:
    def __init__(self, artifact: Path):
        self.process = subprocess.Popen(
            [sys.executable, "-u", str(ROOT / "python/rgp_mcp.py"),
             "--artifact", str(artifact)],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        self.next_id = 0
        self.requests = 0
        self.response_bytes = 0
        self.tool_calls = 0

    def send(self, method: str, params: dict | None = None) -> dict:
        self.next_id += 1
        message = {"jsonrpc": "2.0", "id": self.next_id, "method": method}
        if params is not None:
            message["params"] = params
        assert self.process.stdin and self.process.stdout
        self.process.stdin.write((json.dumps(message) + "\n").encode())
        self.process.stdin.flush()
        line = self.process.stdout.readline()
        if not line:
            raise AssertionError("MCP process terminated without response")
        self.requests += 1
        self.response_bytes += len(line)
        response = json.loads(line)
        assert response.get("jsonrpc") == "2.0" and response.get("id") == self.next_id
        assert "error" not in response, f"unexpected MCP protocol error: {response}"
        return response["result"]

    def tool(self, name: str, args: dict | None = None) -> dict:
        self.tool_calls += 1
        result = self.send("tools/call", {"name": name, "arguments": args or {}})
        assert not result.get("isError"), f"unexpected MCP tool error: {result}"
        assert len(result["content"]) == 1
        return json.loads(result["content"][0]["text"])

    def close(self) -> None:
        if self.process.stdin:
            self.process.stdin.close()
        try:
            code = self.process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait()
            raise AssertionError("MCP process failed to shut down on EOF")
        assert code == 0, f"MCP exited {code}, {self.process.stderr.read()[-400:]!r}"


def run(artifact: Path, source_repo: Path, repository: str, plan: Path) -> dict:
    frozen = strict_json(plan)
    validate_plan(frozen)
    selected = [t for t in frozen["tasks"] if t["repository"] == repository]
    repo = next(r for r in frozen["repositories"] if r["id"] == repository)
    assert len(selected) == 4, "expected four frozen coding tasks per repo"
    start = time.perf_counter_ns()
    client = Client(artifact)
    read_paths = set()
    count = 0
    total_context_bytes = 0
    rows = []
    try:
        handshake = client.send("initialize", {"protocolVersion": "2025-06-18",
                                                "clientInfo": {"name": "rgp-agent-acceptance",
                                                               "version": "1.0"},
                                                "capabilities": {}})
        assert handshake["protocolVersion"] == "2025-06-18"
        tools = client.send("tools/list")["tools"]
        assert {t["name"] for t in tools} == {
            "rgp_status", "rgp_tree", "rgp_search", "rgp_read", "rgp_context"}
        status = client.tool("rgp_status")["overview"]
        assert status["source_commit"] in (None, repo["commit"])
        # RGP/0.1.0 leaves authenticity to the pinned Git source comparisons.
        assert status["snapshot_complete"]
        assert status["file_count"] > 0
        assert status["index_coverage"] == "not_indexed"
        first = client.tool("rgp_tree", {"limit": 200})
        assert first["paths"]
        for task in selected:
            terms = list(TERMS[task["id"]])
            context = client.tool("rgp_context", {
                "terms": terms, "max_bytes": 24_000, "max_files": 4
            })
            assert context["source_commit"] in (None, repo["commit"])
            assert not context["terms_without_source"]
            assert not context["search_capped_terms"]
            actual_paths = {x["path"] for x in context["sources"]}
            assert set(task["reference_paths"]) <= actual_paths, (
                task["id"], set(task["reference_paths"]) - actual_paths)
            total_context_bytes += len(json.dumps(
                context, sort_keys=True, ensure_ascii=False, separators=(",", ":")
            ).encode("utf-8"))
            for item in context["sources"]:
                path = item["path"]
                original = subprocess.check_output([
                    "git", "-C", str(source_repo), "show",
                    f"{repo['commit']}:{path}"
                ])
                lines = original.decode("utf-8").splitlines(keepends=True)
                start_line, end_line = item["start_line"], item["end_line"]
                assert 1 <= start_line <= item["match_line"] <= end_line <= len(lines)
                assert "".join(lines[start_line - 1:end_line]) == item["content"]
                assert item["match_term"] in lines[item["match_line"] - 1]
                # Independently follow one actual MCP rgp_read citation for
                # each task, not just inspect its preselected context JSON.
                count += 1
                read_paths.add(path)
            source = context["sources"][0]
            reread = client.tool("rgp_read", {
                "path": source["path"], "start_line": source["start_line"],
                "end_line": source["end_line"],
            })
            assert reread["content"] == source["content"]
            # The search tool is a real independent step in the agent
            # protocol; the model can use it to refine its next query.
            matches = client.tool("rgp_search", {
                "query": source["match_term"], "paths": [source["path"]], "limit": 20
            })
            assert any(m["line"] == source["match_line"] for m in matches["matches"])
            rows.append({"task_id": task["id"], "passages_verified": len(context["sources"]),
                         "source_paths": sorted(actual_paths),
                         "context_bytes": len(json.dumps(
                            context, sort_keys=True, ensure_ascii=False,
                            separators=(",", ":")).encode("utf-8"))})
        negative = client.send("tools/call", {
            "name": "rgp_read", "arguments": {"path": "../not-in-repo"}
        })
        assert negative["isError"] and "PARTIAL_SNAPSHOT" in negative["content"][0]["text"]
        assert client.send("ping") == {}
    finally:
        client.close()
    elapsed_ms = round((time.perf_counter_ns() - start) / 1e6, 3)
    return {
        "kind": "rgp_real_mcp_agent_source_navigation",
        "status": "PASS", "repository": repository, "source_commit": repo["commit"],
        "task_count": len(rows), "verified_source_passages": count,
        "unique_source_paths": len(read_paths), "context_bytes": total_context_bytes,
        "mcp_json_rpc_requests": client.requests,
        "mcp_tool_calls": client.tool_calls,
        "mcp_wire_response_bytes": client.response_bytes,
        "elapsed_ms_including_local_git_truth_checks": elapsed_ms,
        "tasks": rows, "negative_read_rejected": True,
        "model_inference": "NOT_RUN",
        "model_tokens": "NOT_MEASURED",
        "github_provider_calls": "NOT_MEASURED_BY_LOCAL_GIT",
        "independent_answer_grading": "NOT_RUN",
        "gate_b": "HOLD",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--artifact", required=True, type=Path)
    parser.add_argument("--source-repo", required=True, type=Path)
    parser.add_argument("--repository", choices=("rgp", "serde_json", "itsdangerous"),
                        required=True)
    parser.add_argument("--report", required=True, type=Path)
    args = parser.parse_args()
    try:
        result = run(args.artifact, args.source_repo, args.repository,
                     ROOT / "benchmarks/gate_b/plan.json")
    except Exception as exc:
        result = {"kind": "rgp_real_mcp_agent_source_navigation", "status": "FAIL",
                  "repository": args.repository, "reason": str(exc),
                  "gate_b": "HOLD"}
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(result, ensure_ascii=False,
                                      indent=2, sort_keys=True) + "\n")
    print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    return 0 if result["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())

FILE	scripts/stage1_memory_ab.py
#!/usr/bin/env python3
"""Paired old-vs-new Rust generator measurement on the exact same Git sources.

The CI job compiles both versions from clean source trees and runs each
against the same real temporary Git commit. RGP bytes MUST remain identical
for the same transport version; cross-version comparisons are marked SKIP.
Peak RSS is measured by GNU time; no tokens or connector calls are inferred.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_reader import Reader  # noqa: E402
from stage1_corpus import measured  # noqa: E402
from stage1_stress import make_source  # noqa: E402
from stage1_scale import FILES, CAP, SAMPLE, commit_many, path_for  # noqa: E402

PROFILES = ("many-files", "incompressible", "compressible", "disk-fallback", "scale-50k")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--baseline", type=Path, required=True)
    parser.add_argument("--candidate", type=Path, required=True)
    parser.add_argument("--report", type=Path, required=True)
    args = parser.parse_args()
    report = {"kind": "stage1_paired_same_runner_generator_memory",
              "status": "FAIL", "gate_b": "HOLD", "profiles": [],
              "limits": ["ephemeral runner, cache and invocation order may bias timings",
                         "no claims of connector, user latency or model token savings"]}
    try:
        for profile in PROFILES:
            with tempfile.TemporaryDirectory(prefix=f"rgp-memory-ab-{profile}-") as name:
                folder = Path(name)
                source_dir = folder / "source"
                if profile == "scale-50k":
                    commit = commit_many(source_dir, FILES)
                    sample = [path_for(index) for index in SAMPLE]
                else:
                    commit, fixture = make_source(source_dir, profile)
                    sample = list(fixture)[:3] + list(fixture)[-3:]
                # Alternate order to reduce, not eliminate, warm-cache bias.
                order = ("baseline", "candidate") if profile != "compressible" else (
                    "candidate", "baseline")
                paths: dict[str, Path] = {}
                times: dict[str, dict] = {}
                for arm in order:
                    binary = (args.baseline if arm == "baseline" else args.candidate).resolve()
                    artifact = folder / f"{arm}.rgp"
                    times[arm] = measured([
                        str(binary), "generate", "--repo", str(source_dir),
                        "--rev", commit, "--output", str(artifact),
                    ], folder / f"{arm}.time")
                    paths[arm] = artifact
                original = paths["baseline"].read_bytes()
                optimized = paths["candidate"].read_bytes()
                baseline_version = original.split(b"\n", 1)[0].decode("ascii", errors="replace")
                candidate_version = optimized.split(b"\n", 1)[0].decode("ascii", errors="replace")
                if baseline_version != candidate_version:
                    # Comparing transport 1.0 to 1.1 cannot satisfy the original
                    # byte-identical A/B claim, so do not report fake PASS/FAIL.
                    report.update(status="SKIP", reason="TRANSPORT_VERSION_CHANGED",
                                  baseline_version=baseline_version,
                                  candidate_version=candidate_version)
                    break
                if original != optimized:
                    raise AssertionError(f"RGP bytes changed on {profile}")
                for arm in ("baseline", "candidate"):
                    subprocess.run([
                        str((args.baseline if arm == "baseline" else args.candidate).resolve()),
                        "verify", "--artifact", str(paths[arm]), "--repo", str(source_dir),
                    ], check=True, stdout=subprocess.DEVNULL)
                reader = Reader(optimized)
                overview = reader.overview()
                if not reader.validate()["valid"] or overview["source_commit"] is not None:
                    raise AssertionError(f"invalid source snapshot: {profile}")
                if profile == "scale-50k":
                    if overview["snapshot_complete"] or overview["file_count"] != CAP:
                        raise AssertionError("large snapshot incorrectly claimed complete")
                    if overview["excluded_by_reason"].get("entry_limit") != FILES - CAP:
                        raise AssertionError("large source lost its exclusions")
                elif not overview["snapshot_complete"]:
                    raise AssertionError(f"unexpected partial snapshot: {profile}")
                # Check sampled source bytes against independently read pinned Git.
                for path in sorted(set(sample)):
                    raw = subprocess.check_output([
                        "git", "-C", str(source_dir), "show", f"{commit}:{path}"])
                    if reader._blob(path) != raw:
                        raise AssertionError(f"Git blob mismatch: {path}")
                baseline_rss = times["baseline"]["peak_rss_kib"]
                candidate_rss = times["candidate"]["peak_rss_kib"]
                if baseline_rss <= 0 or candidate_rss <= 0:
                    raise AssertionError("missing GNU time RSS")
                profile_report = {
                    "profile": profile, "source_commit": commit,
                    "same_artifact_sha256": hashlib.sha256(optimized).hexdigest(),
                    "rgp_bytes": len(optimized), "included_files": overview["file_count"],
                    "sampled_pinned_git_blobs": len(set(sample)),
                    "baseline": times["baseline"], "candidate": times["candidate"],
                    "peak_rss_change_percent": round(
                        100 * (candidate_rss - baseline_rss) / baseline_rss, 2),
                }
                report["profiles"].append(profile_report)
        # The current disk-backed baseline already saves RAM. This change
        # deliberately spends a bounded amount of memory to avoid 50k ZIP
        # filesystem seeks. Reject unbounded RSS increases and a large-tree
        # slowdown; report observed memory/latency for every profile.
        for item in report["profiles"]:
            if item["candidate"]["peak_rss_kib"] > 1.5 * item["baseline"]["peak_rss_kib"]:
                raise AssertionError(f"more than 50% peak-RSS regression: {item['profile']}")
            if item["profile"] == "scale-50k":
                before = item["baseline"]["elapsed_ms"]
                after = item["candidate"]["elapsed_ms"]
                if after > 1.1 * before:
                    raise AssertionError("50k-member latency regressed more than 10%")
        if report["status"] != "SKIP":
            report["status"] = "PASS"
    except Exception as exc:
        report["error"] = str(exc)
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["status"] in ("PASS", "SKIP") else 1


if __name__ == "__main__":
    raise SystemExit(main())

FILE	scripts/stage1_sandbox_task_trial.py
#!/usr/bin/env python3
"""Real pinned Git -> verified RGP -> sandbox workspace -> byte-for-byte source audit.

This is the agent's working-context *filesystem* path, not a model quality
score. Frozen SHA-256 is read independently from committed corpus checkpoints.
No archived code is imported or executed.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
sys.path.insert(0, str(ROOT / "scripts"))
from rgp_sandbox import export_workspace, METADATA  # noqa: E402
from rgp_reader import Reader, RgpError  # noqa: E402
from gate_b import strict_json  # noqa: E402


def run(repository: str, artifact: Path, source_repo: Path, output: Path) -> dict:
    plan = strict_json(ROOT / "benchmarks/gate_b/plan.json")
    checkpoints = strict_json(ROOT / "benchmarks/gate_b/corpus_preparation.json")
    pinned = next(r for r in plan["repositories"] if r["id"] == repository)
    anchor = next(r for r in checkpoints["artifacts"] if r["repository"] == repository)
    assert anchor["source_commit"] == pinned["commit"], "inconsistent external trust anchor"
    start = time.perf_counter_ns()
    reader = Reader(artifact)
    hash_free = reader.overview()["source_commit"] is None
    # The historic SHA checkpoint is frozen to the old transport. In
    # RGP/0.1.0 we can only check this run's artifact hash locally, then
    # independently compare every exported file to pinned Git.
    trusted = hashlib.sha256(artifact.read_bytes()).hexdigest() if hash_free else anchor["sha256"]
    # An authenticated RGP from the wrong commit must be rejected before
    # any workspace is created. Verify this on genuine pinned artifacts.
    other_commit = ("f" if pinned["commit"][0] != "f" else "e") * len(pinned["commit"])
    try:
        export_workspace(artifact, output, trusted,
                         expected_commit=other_commit,
                         attested_source_commit=pinned["commit"])
    except RgpError as error:
        assert error.code == "STALE_SNAPSHOT", f"wrong error: {error}"
    else:
        raise AssertionError("stale but authentic RGP was accepted")
    assert not output.exists(), "stale RGP created a workspace"
    report = export_workspace(artifact, output, trusted,
                              expected_commit=pinned["commit"],
                              attested_source_commit=pinned["commit"])
    assert report["source_commit"] == pinned["commit"]
    assert report["snapshot_complete"] is True, "pinned repo unexpectedly partial"
    assert report["files_exported"] == anchor["included_files"]
    asserted = []
    for entry in reader.manifest["files"]:
        path = entry["path"]
        wanted = subprocess.check_output(
            ["git", "-C", str(source_repo), "show", f"{pinned['commit']}:{path}"])
        actual = (output / path).read_bytes()
        assert actual == wanted, f"sandbox source differs from original pinned Git: {path}"
        assert (output / path).stat().st_mode & 0o111 == 0, "source became executable"
        assert not (output / path).is_symlink(), "real symlink escaped into workspace"
        asserted.append(path)
    assert (output / METADATA).is_file()
    assert json.loads((output / METADATA).read_text()) == report
    assert sum(1 for x in output.rglob("*") if x.is_file()) == len(asserted) + 1, (
        "unexpected file or extra source in workspace")
    return {
        "kind": "rgp_sandbox_real_source_workflow",
        "status": "PASS",
        "repository": repository,
        "source_commit": pinned["commit"],
        "artifact_sha256_matched_committed_external_checkpoint": not hash_free,
        "whole_artifact_authenticated_independently": not hash_free,
        "source_bytes_compared_to_independent_git": True,
        "valid_but_stale_commit_rejected": True,
        "expected_commit_matches_pinned_git": report["expected_commit"] == pinned["commit"],
        "files_exported": len(asserted),
        "source_files_compared_byte_for_byte_to_git": len(asserted),
        "bytes_exported": report["bytes_exported"],
        "source_snapshot_complete": report["snapshot_complete"],
        "symlink_entries_written_as_inert_regular_files": len(
            report["symlinks_materialized_as_regular_text_files"]),
        "all_file_executable_bits_cleared": True,
        "elapsed_ms_including_local_git_checks": round((time.perf_counter_ns() - start) / 1e6, 3),
        "source_code_execution": "NONE",
        "model_task_quality": "NOT_MEASURED_BY_THIS_SCRIPT",
        "gate_b": "HOLD",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", required=True,
                        choices=("rgp", "serde_json", "itsdangerous"))
    parser.add_argument("--artifact", type=Path, required=True)
    parser.add_argument("--source-repo", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--report", type=Path, required=True)
    args = parser.parse_args()
    try:
        result = run(args.repository, args.artifact, args.source_repo, args.output)
    except Exception as error:
        result = {"kind": "rgp_sandbox_real_source_workflow", "status": "FAIL",
                  "repository": args.repository, "reason": str(error),
                  "gate_b": "HOLD"}
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n")
    print(json.dumps(result, sort_keys=True, indent=2))
    return int(result["status"] != "PASS")


if __name__ == "__main__":
    raise SystemExit(main())

