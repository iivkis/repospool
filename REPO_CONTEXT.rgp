#!/usr/bin/env python3
"""Recompute the Gate B source-line index from three verified pinned RGP files.

Uses only the trusted Python stdlib Reader. No source code from the snapshots
is executed or extracted to the filesystem.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))

from rgp_reader import Reader, RgpError  # noqa: E402
from gate_b import ProtocolError, digest_plan, require, strict_json, validate_plan  # noqa: E402
from gate_b_review import validate_source_line_counts  # noqa: E402


def make_source_line_index(plan: dict, observations: dict, checkpoint: dict,
                           rgp_dir: Path) -> dict:
    validate_plan(plan)
    require(isinstance(checkpoint, dict) and isinstance(checkpoint.get("artifacts"), list),
            "missing RGP corpus checkpoint")
    by_repo = {a["repository"]: a for a in checkpoint["artifacts"]
               if isinstance(a, dict) and isinstance(a.get("repository"), str)}
    repos = {repo["id"]: repo for repo in plan["repositories"]}
    require(set(by_repo) == set(repos), "RGP checkpoint repositories do not match plan")
    row_index = {(r["task_id"], r["arm"]): r for r in observations["observations"]}
    entries = []
    seen = set()
    for repo_id, repo in repos.items():
        raw = (rgp_dir / (repo_id + ".rgp")).read_bytes()
        artifact = by_repo[repo_id]
        require(hashlib.sha256(raw).hexdigest() == artifact["sha256"],
                f"{repo_id}: RGP SHA-256 checkpoint mismatch")
        require(len(raw) == artifact["rgp_bytes"], f"{repo_id}: RGP byte size mismatch")
        reader = Reader(raw)
        summary = reader.overview()
        require(summary["snapshot_complete"] is True and
                summary["source_commit"] == repo["commit"] and
                summary["included_files"] == artifact["included_files"],
                f"{repo_id}: incomplete/wrong pinned snapshot")
        for task in plan["tasks"]:
            if task["repository"] != repo_id:
                continue
            for path in task["reference_paths"]:
                key = (repo_id, path)
                if key in seen:
                    continue
                seen.add(key)
                response = reader.read(path)
                require(response["status"] == "included" and response["encoding"] == "utf-8",
                        f"{repo_id}/{path}: source must be fully included UTF-8")
                raw_blob = response["content"].encode("utf-8")
                git_sha = hashlib.sha1(
                    b"blob " + str(len(raw_blob)).encode("ascii") + b"\0" + raw_blob
                ).hexdigest()
                original = row_index[(task["id"], "github_connector")]["source_evidence"][path]
                require(git_sha == original["git_blob_sha1"],
                        f"{repo_id}/{path}: Git blob SHA-1 mismatch")
                line_count = raw_blob.count(b"\n") + int(not raw_blob.endswith(b"\n"))
                require(line_count > 0, f"{repo_id}/{path}: empty source")
                entries.append({
                    "repository": repo_id,
                    "source_commit": repo["commit"],
                    "path": path,
                    "git_blob_sha1": git_sha,
                    "line_count": line_count,
                })
    result = {
        "schema_version": "1.0",
        "plan_sha256": digest_plan(plan),
        "method": "verified_pinned_rgp_reader_plus_git_blob_sha1",
        "source_rgp_sha256": {key: by_repo[key]["sha256"] for key in by_repo},
        "files": entries,
    }
    validate_source_line_counts(plan, observations, result, checkpoint)
    return result


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--rgp-dir", type=Path, required=True)
    p.add_argument("--plan", type=Path, default=Path("benchmarks/gate_b/plan.json"))
    p.add_argument("--observations", type=Path, default=Path(
        "benchmarks/gate_b/observations.cache_fair_2026-10-29.json"))
    p.add_argument("--checkpoint", type=Path, default=Path(
        "benchmarks/gate_b/corpus_preparation.json"))
    p.add_argument("--expected", type=Path, default=Path(
        "benchmarks/gate_b/source_line_counts.json"))
    p.add_argument("--check", action="store_true",
                   help="Fail when generated data differs from the committed source index")
    args = p.parse_args()
    try:
        manifest = make_source_line_index(strict_json(args.plan),
                                          strict_json(args.observations),
                                          strict_json(args.checkpoint),
                                          args.rgp_dir)
        if args.check:
            require(manifest == strict_json(args.expected),
                    "source-line index changed from pinned RGP bytes")
            print(json.dumps({"status": "PASS", "files": len(manifest["files"]),
                              "verified_snapshots": 3}, sort_keys=True))
        else:
            print(json.dumps(manifest, ensure_ascii=False, indent=2))
    except (ProtocolError, RgpError, OSError, ValueError, TypeError, KeyError) as exc:
        p.error(str(exc))


if __name__ == "__main__":
    main()

FILE	scripts/golden_fixtures.py
"""Maintain deterministic v1 contract fixtures (stdlib-only, independent of Rust).

`write` intentionally changes version-controlled golden bytes. `check` regenerates
fixtures and requires exact equality; the Rust CLI may be supplied for parity.
These are *synthetic* snapshots, not proof of completeness of a Git tree.
"""
from __future__ import annotations

import argparse
import base64
import hashlib
import io
import json
import subprocess
import warnings
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
TARGET = ROOT / "tests" / "fixtures" / "v1"
ZIP_TIME = (1980, 1, 1, 0, 0, 0)


def sha(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def fixture_files() -> list[tuple[str, str, bytes, str]]:
    lfs_pointer = (
        b"version https://git-lfs.github.com/spec/v1\n"
        b"oid sha256:" + b"1" * 64 + b"\nsize 100000000\n"
    )
    readme = b"# sample\r\nUTF-8 and bytes are preserved.\n"
    return [
        ("README.md", "100644", readme, "included"),
        ("assets/raw.bin", "100644", bytes(range(256)) + b"\x00\xff", "included"),
        ("lfs/large.bin", "100644", lfs_pointer, "pointer_only"),
        ("scripts/link", "120000", b"../README.md", "included"),
        ("src/copy.md", "100644", readme, "included"),
        ("src/пример.py", "100644", "def ответ():\n    return 42\n".encode(), "included"),
    ]


def manifest_and_blobs(mixed: bool = True) -> tuple[dict, dict[str, bytes]]:
    files = []
    blobs: dict[str, bytes] = {}
    tree = hashlib.sha256()
    for path, mode, content, status in (fixture_files() if mixed else []):
        digest = sha(content)
        entry = {
            "path": path, "mode": mode,
            "kind": "symlink" if mode == "120000" else "file",
            "size": len(content), "sha256": digest,
            "blob": f"files/{digest}", "status": status,
        }
        files.append(entry)
        blobs[entry["blob"]] = content
        tree.update(path.encode() + b"\0" + mode.encode("ascii") + b"\0" + bytes.fromhex(digest))
    manifest = {
        "schema_version": "1.0", "source_commit": "c" * 40,
        "input_tree_digest": tree.hexdigest(),
        "files": files,
        "excluded": ([
            {"path": ".env", "reason": "sensitive_path"},
            {"path": "REPO_CONTEXT.rgp", "reason": "self_artifact"},
            {"path": "vendor/submodule", "reason": "submodule_unavailable"},
        ] if mixed else []),
        "index_coverage": "not_indexed", "graph_coverage": "not_indexed",
    }
    return manifest, blobs


def zip_payload(manifest: dict, blobs: dict[str, bytes], extra: tuple[str, bytes] | None = None) -> bytes:
    memory = io.BytesIO()
    with zipfile.ZipFile(memory, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=6) as zipout:
        for name, content in [("manifest.json", json.dumps(manifest, separators=(",", ":"), ensure_ascii=False).encode()),
                              *sorted(blobs.items()), *([extra] if extra else [])]:
            info = zipfile.ZipInfo(name, date_time=ZIP_TIME)
            info.compress_type = zipfile.ZIP_DEFLATED
            info.create_system = 3
            info.external_attr = 0o100644 << 16
            with warnings.catch_warnings():
                warnings.filterwarnings("ignore", message="Duplicate name")
                zipout.writestr(info, content)
    return memory.getvalue()


def transport(payload: bytes) -> bytes:
    encoded = base64.b64encode(payload)
    header = (f"RGP/1.0\npayload_length={len(payload)}\n"
              f"payload_sha256={sha(payload)}\nbase64_line_width=76\n--\n").encode()
    return header + b"".join(encoded[i:i + 76] + b"\n" for i in range(0, len(encoded), 76)) + b"END RGP\n"


def generate() -> tuple[dict[str, bytes], dict]:
    mixed, blobs = manifest_and_blobs()
    empty, empty_blobs = manifest_and_blobs(False)
    valid = transport(zip_payload(mixed, blobs))
    empty_valid = transport(zip_payload(empty, empty_blobs))
    bad_tree = {**mixed, "input_tree_digest": "0" * 64}
    # Flip the first hash digit without changing field width.
    header, tail = valid.split(b"\n--\n", 1)
    original_hash = sha(zip_payload(mixed, blobs))
    header = header.replace(original_hash.encode(), ("0" if original_hash[0] != "0" else "1").encode() + original_hash[1:].encode())
    corrupt_sha = header + b"\n--\n" + tail
    artifacts = {
        "valid-mixed.rgp": valid,
        "valid-empty.rgp": empty_valid,
        "invalid-truncated.rgp": valid[:-12],
        "invalid-payload-sha.rgp": corrupt_sha,
        "invalid-zip-slip.rgp": transport(zip_payload(mixed, blobs, ("../escape.txt", b"nope"))),
        "invalid-tree-digest.rgp": transport(zip_payload(bad_tree, blobs)),
        "invalid-unsupported-version.rgp": valid.replace(b"RGP/1.0\n", b"RGP/2.0\n", 1),
    }
    expected = {
        "format": "RGP/1.0",
        "valid": ["valid-mixed.rgp", "valid-empty.rgp"],
        "invalid": {
            "invalid-truncated.rgp": "TRUNCATED_ARTIFACT",
            "invalid-payload-sha.rgp": "HASH_MISMATCH",
            "invalid-zip-slip.rgp": "UNSAFE_PATH",
            "invalid-tree-digest.rgp": "HASH_MISMATCH",
            "invalid-unsupported-version.rgp": "UNSUPPORTED_FORMAT",
        },
        "mixed_input_tree_digest": mixed["input_tree_digest"],
        "mixed_files": mixed["files"],
        "mixed_excluded": mixed["excluded"],
        "artifacts": {name: {"bytes": len(data), "sha256": sha(data)} for name, data in sorted(artifacts.items())},
    }
    return artifacts, expected


def run_check(rust_cli: Path | None) -> None:
    artifacts, expected = generate()
    expected_bytes = (json.dumps(expected, ensure_ascii=False, sort_keys=True, indent=2) + "\n").encode()
    assert (TARGET / "expected.json").read_bytes() == expected_bytes, "golden expected.json drift"
    for name, data in artifacts.items():
        assert (TARGET / name).read_bytes() == data, f"golden fixture drift: {name}"
        if rust_cli is not None:
            result = subprocess.run([str(rust_cli.resolve()), "verify", "--artifact", str(TARGET / name)],
                                    capture_output=True, text=True, check=False)
            should_pass = name in expected["valid"]
            assert (result.returncode == 0) == should_pass, f"Rust verifier parity: {name}: {result.stderr}"
            if not should_pass:
                assert expected["invalid"][name] in result.stderr, f"wrong Rust error class: {name}: {result.stderr}"
    print(f"Verified {len(artifacts)} immutable golden RGP fixtures" + (" against Rust" if rust_cli else ""))


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("write", "check"))
    parser.add_argument("--rust-cli", type=Path, default=None)
    args = parser.parse_args()
    if args.command == "write":
        TARGET.mkdir(parents=True, exist_ok=True)
        artifacts, expected = generate()
        for name, data in artifacts.items():
            (TARGET / name).write_bytes(data)
        (TARGET / "expected.json").write_text(
            json.dumps(expected, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
        print(f"Wrote {len(artifacts)} golden RGP fixtures")
    else:
        run_check(args.rust_cli)


if __name__ == "__main__":
    main()

FILE	scripts/repo_dogfood.py
#!/usr/bin/env python3
"""Validate and export the in-repository RGP snapshot for real agent work.

RGP source_commit may precede checkout HEAD by a commit changing ONLY
REPO_CONTEXT.rgp: the snapshot excludes itself, so no source code changed.
Never silently accept any other Git difference, an untracked/tampered RGP,
or a snapshot with unknown coverage. Python stdlib only.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_reader import Reader, RgpError, _require  # noqa: E402
from rgp_sandbox import export_workspace  # noqa: E402

NAME = "REPO_CONTEXT.rgp"


def git(repo: Path, *args: str) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
    )


def checked_git(repo: Path, *args: str) -> bytes:
    result = git(repo, *args)
    _require(result.returncode == 0, "STALE_SNAPSHOT",
             f"git command failed ({' '.join(args)}): {result.stderr.decode('utf-8', 'replace')[:240]}")
    return result.stdout


def check(repo: Path, artifact: Path | None = None) -> dict:
    """Require a committed, unchanged RGP matching current HEAD source bytes.

    Do not infer freshness from the RGP's own SHA-256. The local repository
    checkout is the independent Git trust anchor and source of HEAD.
    """
    repo = Path(repo).resolve(strict=True)
    artifact = (repo / NAME) if artifact is None else Path(artifact)
    _require(artifact.absolute() == (repo / NAME), "UNSAFE_PATH",
             "the dogfood snapshot must be the repository-root REPO_CONTEXT.rgp")
    _require(artifact.is_file() and not artifact.is_symlink(),
             "UNSUPPORTED_FORMAT", "the tracked RGP file is absent or not a regular file")
    head = checked_git(repo, "rev-parse", "--verify", "HEAD^{commit}").decode().strip()
    # Check that the *same actual bytes* exist at HEAD, not a modified local file.
    committed = checked_git(repo, "show", f"{head}:{NAME}")
    actual = artifact.read_bytes()
    _require(actual == committed, "HASH_MISMATCH",
             "local REPO_CONTEXT.rgp differs from committed Git blob")
    reader = Reader(actual)
    overview = reader.overview()
    # RGP/2.1 verifies its own guide, provenance header, manifest and source
    # hashes. Full artifact integrity is anchored independently in Git HEAD.
    _require(overview["snapshot_complete"], "PARTIAL_SNAPSHOT",
             "in-repository source snapshot is not complete")
    source = overview["source_commit"]
    if source is None and overview["transport"] == "RGP/3.0":
        # RGP/3.0 intentionally contains no commit/hash text. Recover the
        # source revision ONLY from independently trusted local Git history.
        # The publication bot makes a one-file RGP commit after source HEAD.
        parent_result = git(repo, "rev-parse", "HEAD^")
        source = head
        if parent_result.returncode == 0:
            parent = parent_result.stdout.decode().strip()
            changed = checked_git(repo, "diff", "--name-only", parent, head).decode().splitlines()
            if changed == [NAME]:
                source = parent
        # Check all included source bytes against Git at the chosen revision.
        # The RGP's in-memory derived SHA is never accepted as provenance.
        cursor = None
        seen = 0
        while True:
            page = reader.tree(limit=200, cursor=cursor)
            for path in page["paths"]:
                committed_source = checked_git(repo, "show", f"{source}:{path}")
                _require(reader.read_bytes(path) == committed_source, "HASH_MISMATCH",
                         f"RGP source differs from trusted Git: {path}")
                seen += 1
            cursor = page["next_cursor"]
            if cursor is None:
                break
        _require(seen == overview["file_count"], "HASH_MISMATCH", "RGP file index incomplete")
    checked_git(repo, "cat-file", "-e", f"{source}^{{commit}}")
    ancestor = git(repo, "merge-base", "--is-ancestor", source, head)
    _require(ancestor.returncode == 0, "STALE_SNAPSHOT",
             "RGP source commit is not an ancestor of checkout HEAD")
    # Only the tracked RGP is excluded from the input digest.
    # Publication may change only this file after source commit A. Other
    # changes (even docs and tests) make the snapshot stale.
    diff = git(repo, "diff", "--quiet", source, head,
               "--", ".", f":(exclude){NAME}")
    _require(diff.returncode == 0, "STALE_SNAPSHOT",
             "source files differ from the RGP commit; refresh the snapshot")
    # Local working-tree modifications are not represented by a pinned Git
    # snapshot, even when committed HEAD is source-equivalent. Refuse to
    # present the snapshot as a complete view of modified agent work.
    worktree = git(repo, "diff", "--quiet", "HEAD",
                   "--", ".", f":(exclude){NAME}")
    _require(worktree.returncode == 0, "STALE_SNAPSHOT",
             "tracked working-tree files differ from HEAD")
    staged = git(repo, "diff", "--cached", "--quiet", "HEAD",
                 "--", ".", f":(exclude){NAME}")
    _require(staged.returncode == 0, "STALE_SNAPSHOT",
             "staged source changes are not in the RGP")
    untracked = checked_git(repo, "ls-files", "--others", "--exclude-standard", "-z")
    _require(not untracked, "STALE_SNAPSHOT",
             "untracked source files are absent from the Git-pinned RGP")
    digest = hashlib.sha256(actual).hexdigest()
    return {
        "status": "PASS",
        "artifact": NAME,
        "artifact_sha256": digest,
        "source_commit": source,
        "checkout_commit": head,
        "snapshot_equivalent_to_checkout": True,
        "commit_difference_is_artifact_only": source != head,
        "snapshot_complete": True,
        "file_count": overview["file_count"],
        "included_source_bytes": overview["included_bytes"],
        "validation": "committed Git blob, Reader integrity, Git ancestry and all-source diff",
        "gate_b": "HOLD",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("check", "export"):
        command = sub.add_parser(name)
        command.add_argument("--repo", type=Path, default=ROOT)
        if name == "export":
            command.add_argument("--output", required=True, type=Path)
            command.add_argument("--prefix", default="")
            command.add_argument("--max-files", type=int, default=1000)
            command.add_argument("--max-bytes", type=int, default=32 * 1024 * 1024)
    args = parser.parse_args()
    try:
        report = check(args.repo)
        if args.command == "export":
            # check() has already established that the Git-tracked snapshot
            # represents HEAD's complete source tree, though source_commit
            # can differ by the inevitable artifact-only publication commit.
            output = export_workspace(
                Path(args.repo).resolve() / NAME, args.output,
                report["artifact_sha256"], expected_commit=report["source_commit"],
                attested_source_commit=report["source_commit"],
                prefix=args.prefix, max_files=args.max_files,
                max_bytes=args.max_bytes)
            report["export"] = {
                "directory": str(args.output),
                "files_exported": output["files_exported"],
                "bytes_exported": output["bytes_exported"],
            }
    except (OSError, RgpError, ValueError) as exc:
        parser.exit(2, f"{exc}\n")
    print(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

FILE	scripts/stage1_acceptance.py
#!/usr/bin/env python3
"""Stage 1 acceptance: answer real source questions using a generated RGP.

No model, network, GitHub connector or third-party Python packages required.
This is an agent-owned *functional* check, not the comparative Gate B trial.
The emitted JSON contains only evidence metadata, never source bytes.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_reader import Reader, RgpError  # noqa: E402

# Freeze task descriptions BEFORE inspecting the generated RGP.
# Their answers must agree with the original Git commit, not another RGP.
TASKS = (
    ("generator definition", "src/main.rs", "fn generate("),
    ("trusted Reader class", "python/rgp_reader.py", "class Reader:"),
    ("product stage 1", "docs/PRODUCT_ROADMAP.md", "## Этап 1."),
)


def git(repo: Path, *args: str) -> bytes:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    ).stdout


def run(*args: str) -> None:
    result = subprocess.run(list(args), text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(
            f"command failed ({result.returncode}): {args!r}\n"
            f"{result.stdout[-1500:]}\n{result.stderr[-1500:]}"
        )


def check(repo: Path, rust_cli: Path) -> dict:
    commit = git(repo, "rev-parse", "--verify", "HEAD^{commit}").decode().strip()
    evidence = {"status": "FAIL", "stage": 1, "source_commit": commit,
                "tasks": [], "checks": [], "gate_b": "HOLD"}
    with tempfile.TemporaryDirectory(prefix="rgp-stage1-") as d:
        work = Path(d)
        first, second, shared = (work / n for n in ("first.rgp", "second.rgp", "shared.rgp"))
        command = [str(rust_cli), "generate", "--repo", str(repo), "--rev", commit]
        run(*command, "--output", str(first))
        run(*command, "--output", str(second))
        data = first.read_bytes()
        assert data == second.read_bytes(), "nondeterministic RGP bytes"
        inline = Reader(first).overview()
        assert inline["transport"] == "RGP/3.0", "missing standalone transport"
        assert inline["embedded_instructions"], "missing inline agent instructions"
        assert inline["source_commit"] is None, "RGP must not contain Git hash"
        evidence["checks"].append("hash-free RGP; externally verified Git source")
        evidence["artifact_sha256"] = hashlib.sha256(data).hexdigest()
        evidence["artifact_bytes"] = len(data)
        evidence["checks"].append("deterministic RGP generated twice")
        run(str(rust_cli), "verify", "--artifact", str(first), "--repo", str(repo))
        reader = Reader(first)
        assert reader.validate()["valid"] is True
        assert reader.overview()["source_commit"] is None
        assert reader.coverage("index")["status"] == "not_indexed"
        assert reader.coverage("graph")["status"] == "not_indexed"
        assert reader.coverage("investigation")["status"] == "unknown"
        evidence["snapshot_status"] = reader.overview()["status"]
        evidence["checks"].append("Rust verify + Python validate + honest coverage")

        # Exercise tree, whole-file reads and line search through the RGP,
        # comparing their actual answers with Git at the *same pinned commit*.
        paths = set()
        cursor = None
        while True:
            page = reader.tree(limit=20, cursor=cursor)
            paths.update(page["paths"])
            cursor = page["next_cursor"]
            if cursor is None:
                break
        assert len(paths) == reader.overview()["file_count"], "tree pagination lost paths"
        for title, path, needle in TASKS:
            assert path in paths, f"source absent from snapshot: {path}"
            original = git(repo, "show", f"{commit}:{path}")
            decoded = original.decode("utf-8")
            result = reader.read(path)
            assert result["content"] == decoded, f"source mismatch: {path}"
            expected = [i for i, line in enumerate(decoded.splitlines(), 1) if needle in line]
            hits = reader.search(needle, paths=[path], limit=100)
            actual = [h["line"] for h in hits["matches"]]
            assert expected and actual == expected and hits["next_cursor"] is None, (
                f"incorrect answer for {title}: {actual} vs {expected}"
            )
            evidence["tasks"].append({
                "goal": title, "path": path, "source_sha256": hashlib.sha256(original).hexdigest(),
                "expected_lines": expected, "observed_lines": actual, "result": "PASS"
            })
        evidence["checks"].append("three predefined source tasks matched independent Git source")

        # Negative cases on the *actual* generated output, not only fixtures.
        oversized_index = re.sub(rb"index_bytes=[0-9]+", b"index_bytes=999999999",
                                 data, count=1)
        assert oversized_index != data
        for label, bad, code in (
            ("truncation", data[:-10], "TRUNCATED_ARTIFACT"),
            ("unknown version", data.replace(data.split(b"\n", 1)[0], b"RGP/9.0", 1), "UNSUPPORTED_FORMAT"),
            ("oversized index", oversized_index, "RESOURCE_LIMIT"),
        ):
            try:
                Reader(bad)
            except RgpError as exc:
                assert exc.code == code, f"{label}: unexpected error {exc.code}"
            else:
                raise AssertionError(f"{label}: invalid artifact accepted")
        try:
            reader.read("does-not-exist.src")
        except RgpError as exc:
            assert exc.code == "PARTIAL_SNAPSHOT"
        else:
            raise AssertionError("missing source unexpectedly readable")
        evidence["checks"].append("truncation, unsupported version, oversized index and absent file rejected")

        # Concurrent writers to the *same* destination must not share a
        # temporary filename. The published artifact must stay verifiable.
        children = [
            subprocess.Popen(command + ["--output", str(shared)],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            for _ in range(3)
        ]
        for child in children:
            out, err = child.communicate(timeout=180)
            assert child.returncode == 0, f"parallel generation failed: {out!r} {err!r}"
        assert shared.read_bytes() == data
        assert not list(work.glob(".*.tmp")), "staging temp files left behind"
        run(str(rust_cli), "verify", "--artifact", str(shared), "--repo", str(repo))
        evidence["checks"].append("three concurrent writers produced a valid identical artifact")
    evidence["status"] = "PASS"
    return evidence


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=ROOT)
    parser.add_argument("--rust-cli", type=Path, default=ROOT / "target/debug/rgp")
    parser.add_argument("--report", type=Path)
    args = parser.parse_args()
    try:
        report = check(args.repo.resolve(), args.rust_cli.resolve())
    except Exception as exc:
        report = {"status": "FAIL", "stage": 1, "reason": str(exc),
                  "gate_b": "HOLD"}
        print(json.dumps(report, ensure_ascii=False, indent=2), file=sys.stderr)
        if args.report:
            args.report.parent.mkdir(parents=True, exist_ok=True)
            args.report.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
        return 1
    if args.report:
        args.report.parent.mkdir(parents=True, exist_ok=True)
        args.report.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

FILE	scripts/stage1_agent_task_pilot.py
#!/usr/bin/env python3
"""Twelve preregistered coding questions: real RGP context vs pinned Git truth.

This is a *source-grounding* trial, not a hidden model inference benchmark:
the search terms below are author-selected and deliberately informed by
the frozen tasks. Each exact excerpt is compared against independent Git
objects. Do not infer LLM accuracy, token savings or connector calls.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
sys.path.insert(0, str(ROOT / "scripts"))
from rgp_reader import Reader, RgpError  # noqa: E402
from rgp_agent_context import context, compact_json  # noqa: E402
from gate_b import strict_json, validate_plan  # noqa: E402

# Term selection is explicitly *not* blinded: an assistant looked at the
# frozen reference paths and knew relevant symbols. This measures whether
# RGP supplies verifiable source material, not unaided model discovery.
TERMS = {
    "rgp-transport-hash": ("payload_length=", "payload_sha256=", "ZIP hash mismatch"),
    "rgp-git-snapshot": ("fn snapshot(", "submodule_unavailable", "pointer_only"),
    "rgp-search-cursor": ("_read_cursor", "test_search_keyset_cursor_scope_and_exhaustion"),
    "rgp-trust-boundary": ("def bootstrap(", "unsafe Actions ZIP entry", "Trust boundary"),
    "serde-json-deserializer": ("pub fn from_str(", "pub fn from_slice("),
    "serde-json-serializer": ("fn serialize_i64(", "fn serialize_f64(", "fn serialize_str("),
    "serde-json-error-position": ("pub fn line(", "pub fn column(", "pub fn classify("),
    "serde-json-ser-tests": ("fn test_write_i64()", "fn test_write_f64()",
                             "fn test_write_str()", "fn test_write_list()", "fn serialize_str("),
    "itsdangerous-timestamp": ("if age > max_age:", "if age < 0:"),
    "itsdangerous-hmac": ("class HMACAlgorithm", "mac = hmac.new(",
                           "sig = self.algorithm.get_signature"),
    "itsdangerous-deserialization": ("def load_payload(",
                                    "return self.load_payload(signer.unsign(s))", "def unsign("),
    "itsdangerous-expiry-tests": ("def test_max_age(", "if age > max_age:"),
}


def git_blob(source_repo: Path, commit: str, path: str) -> bytes:
    return subprocess.check_output([
        "git", "-C", str(source_repo), "show", f"{commit}:{path}"
    ])


def run(artifact: Path, source_repo: Path, repository: str,
        plan_file: Path = ROOT / "benchmarks/gate_b/plan.json") -> dict:
    plan = strict_json(plan_file)
    validate_plan(plan)
    expected = [task for task in plan["tasks"] if task["repository"] == repository]
    assert len(expected) == 4, "each frozen repository must have four tasks"
    assert set(TERMS) == {task["id"] for task in plan["tasks"]}, (
        "not covering the complete frozen twelve-task plan")
    repo_row = next(r for r in plan["repositories"] if r["id"] == repository)
    reader = Reader(artifact)
    overview = reader.overview()
    # The source revision for RGP/3.0 comes from the independent pinned
    # benchmark plan. Verify actual cited bytes against that Git revision.
    commit = repo_row["commit"]
    assert overview["source_commit"] in (None, commit), "RGP revision contradicts pinned Git"
    assert overview["snapshot_complete"], "a partial archive cannot ground the full task plan"

    source_cache: dict[str, bytes] = {}
    rows = []
    for task in expected:
        task_id = task["id"]
        terms = list(TERMS[task_id])
        result = context(reader, terms, max_files=4, max_bytes=24_000)
        assert not result["search_capped_terms"], f"{task_id}: lexical search was capped"
        assert not result["terms_without_source"], (
            f"{task_id}: query terms missing source passages: {result['terms_without_source']}")
        actual_paths = {s["path"] for s in result["sources"]}
        assert set(task["reference_paths"]) <= actual_paths, (
            f"{task_id}: missing reference paths: {set(task['reference_paths']) - actual_paths}")
        citations = []
        for source in result["sources"]:
            path = source["path"]
            if path not in source_cache:
                source_cache[path] = git_blob(source_repo, commit, path)
            original = source_cache[path]
            decoded = original.decode("utf-8")
            lines = decoded.splitlines(keepends=True)
            start, end, matched = source["start_line"], source["end_line"], source["match_line"]
            assert 1 <= start <= matched <= end <= len(lines), (
                f"{task_id}: invalid source location {path}:{start}-{end}")
            assert source["content"] == "".join(lines[start - 1:end]), (
                f"{task_id}: RGP excerpt differs from the pinned Git blob")
            assert source["match_term"] in lines[matched - 1], (
                f"{task_id}: source does not contain alleged search hit")
            citations.append({
                "path": path, "start_line": start, "end_line": end,
                "match_line": matched, "term": source["match_term"],
                "git_blob_sha1": hashlib.sha1(
                    b"blob " + str(len(original)).encode() + b"\0" + original
                ).hexdigest(),
            })
        rows.append({
            "task_id": task_id,
            "source_navigation": "PASS",
            "model_answer": "NOT_RUN_BY_CI",
            "answer_correctness": "NOT_INDEPENDENTLY_GRADED",
            "search_terms": terms,
            "cited_files": sorted(actual_paths),
            "source_passages": citations,
            "context_bytes": len(compact_json(result).encode("utf-8")),
            "selected_source_terms": sorted({s["match_term"] for s in result["sources"]}),
        })
    return {
        "kind": "rgp_twelve_frozen_agent_source_navigation",
        "status": "PASS",
        "repository": repository,
        "source_commit": commit,
        "source_snapshot_complete": True,
        "index_coverage": reader.coverage("index")["status"],
        "task_count": len(rows),
        "source_passages_compared_to_pinned_git": sum(len(x["source_passages"]) for x in rows),
        "unique_source_files_compared_to_pinned_git": len(source_cache),
        "github_equivalent_unique_source_bytes": sum(len(x) for x in source_cache.values()),
        "rgp_source_context_bytes": sum(x["context_bytes"] for x in rows),
        "tasks": rows,
        "model_inference": "NOT_RUN_BY_CI",
        "independent_answer_grading": "NOT_RUN",
        "provider_connector_calls": "NOT_MEASURED_BY_LOCAL_GIT",
        "gate_b": "HOLD",
        "method_limits": [
            "query terms were selected with knowledge of the frozen task references",
            "this is exact source navigation, not a blinded model answer evaluation",
            "Git show is a local source baseline, not a GitHub connector invocation",
        ],
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", choices=("rgp", "serde_json", "itsdangerous"),
                        required=True)
    parser.add_argument("--artifact", required=True, type=Path)
    parser.add_argument("--source-repo", required=True, type=Path)
    parser.add_argument("--report", required=True, type=Path)
    args = parser.parse_args()
    try:
        result = run(args.artifact, args.source_repo, args.repository)
    except (AssertionError, RgpError, ValueError, OSError,
            subprocess.CalledProcessError) as exc:
        result = {
            "kind": "rgp_twelve_frozen_agent_source_navigation",
            "status": "FAIL", "repository": args.repository,
            "reason": str(exc), "gate_b": "HOLD",
        }
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n")
    print(json.dumps(result, sort_keys=True, indent=2))
    return int(result["status"] != "PASS")


if __name__ == "__main__":
    raise SystemExit(main())

