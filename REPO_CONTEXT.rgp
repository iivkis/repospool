FILE	"benchmarks/gate_b/plan.json"	6248	04322fe1402cffc134881f4f6e8b00ca128f561fdc71ffa1861b0d531f8ca3cd
{
  "schema_version": "2.0",
  "status": "revised-for-assistant-only-comparison",
  "description": "Assistant in this chat compares fixed GitHub connector retrievals against a validated RGP Reader; no model API, external model, automated agent or claimed provider tokens.",
  "arms": [
    "github_connector",
    "rgp_reader"
  ],
  "requirements": {
    "minimum_repositories": 3,
    "minimum_tasks": 10,
    "minimum_connector_call_reduction": 0.3,
    "no_correctness_regressions": true
  },
  "repositories": [
    {
      "id": "rgp",
      "github": "iivkis/rgp",
      "commit": "95963a23e2fd1e5eb68a72db3bde849ed7119a7c",
      "profile": "mixed-rust-python"
    },
    {
      "id": "serde_json",
      "github": "serde-rs/json",
      "commit": "8c535a260ce561eaab4111aafc29038eb9f77ff3",
      "profile": "rust"
    },
    {
      "id": "itsdangerous",
      "github": "pallets/itsdangerous",
      "commit": "672971d66a2ef9f85151e53283113f33d642dabd",
      "profile": "python"
    }
  ],
  "tasks": [
    {
      "id": "rgp-transport-hash",
      "repository": "rgp",
      "kind": "locate-and-explain",
      "prompt": "Find the code that validates the RGP Base64 payload length and SHA-256 and explain what each check protects against, citing source paths.",
      "reference_paths": [
        "python/rgp_reader.py",
        "src/main.rs"
      ],
      "rubric": "Both independent implementations must be identified; distinguish a byte-integrity check from provenance/authenticity."
    },
    {
      "id": "rgp-git-snapshot",
      "repository": "rgp",
      "kind": "control-flow",
      "prompt": "Trace how the CLI takes a Git commit and turns tracked Git blobs into an RGP snapshot, including handling of submodules and LFS pointers.",
      "reference_paths": [
        "src/main.rs"
      ],
      "rubric": "Find snapshot(), fixed Git commit and blob reads, submodule exclusions and pointer_only status."
    },
    {
      "id": "rgp-search-cursor",
      "repository": "rgp",
      "kind": "testing",
      "prompt": "Where is Reader search-cursor misuse prevented and which test covers the cursor contract?",
      "reference_paths": [
        "python/rgp_reader.py",
        "tests/test_reader_api.py"
      ],
      "rubric": "Identify cursor binding to snapshot and query parameters and point to an actual test."
    },
    {
      "id": "rgp-trust-boundary",
      "repository": "rgp",
      "kind": "impact",
      "prompt": "If a developer replaced the Actions ZIP bootstrap with unrestricted extractall(), identify the relevant code and the risk this introduces.",
      "reference_paths": [
        "python/rgp_bootstrap.py",
        "docs/RGP_SECURITY_MODEL.md"
      ],
      "rubric": "Explain path traversal and trust boundary and cite both implementation and policy."
    },
    {
      "id": "serde-json-deserializer",
      "repository": "serde_json",
      "kind": "locate-and-explain",
      "prompt": "Find the deserializer constructors for JSON from a string and from bytes; explain why entry points are distinct.",
      "reference_paths": [
        "src/de.rs"
      ],
      "rubric": "Identify Deserializer::from_str and from_slice and distinguish UTF-8 and byte input."
    },
    {
      "id": "serde-json-serializer",
      "repository": "serde_json",
      "kind": "control-flow",
      "prompt": "Find the JSON serializer implementation for scalar numeric and string values; cite the exact method locations.",
      "reference_paths": [
        "src/ser.rs"
      ],
      "rubric": "Identify the Serializer methods for integer, float, and string values without claiming one universal branch."
    },
    {
      "id": "serde-json-error-position",
      "repository": "serde_json",
      "kind": "impact",
      "prompt": "Where are error categories and input line/column accessors defined? Explain what an error-reporting change could affect.",
      "reference_paths": [
        "src/error.rs"
      ],
      "rubric": "Identify Error::line(), Error::column(), and classify() with caveats on user-visible diagnostics."
    },
    {
      "id": "serde-json-ser-tests",
      "repository": "serde_json",
      "kind": "testing",
      "prompt": "Locate the real serialization tests for integer, float, string and list values, and the production serializer they exercise.",
      "reference_paths": [
        "tests/test.rs",
        "src/ser.rs"
      ],
      "rubric": "Identify test_write_* functions and the production src/ser.rs implementation."
    },
    {
      "id": "itsdangerous-timestamp",
      "repository": "itsdangerous",
      "kind": "locate-and-explain",
      "prompt": "Find the timestamp-aware signature verification method and the code that evaluates token age.",
      "reference_paths": [
        "src/itsdangerous/timed.py"
      ],
      "rubric": "Identify TimestampSigner.unsign and the max_age/expiration checks."
    },
    {
      "id": "itsdangerous-hmac",
      "repository": "itsdangerous",
      "kind": "control-flow",
      "prompt": "Find the HMAC signing algorithm and identify the signing entry point where signatures are produced.",
      "reference_paths": [
        "src/itsdangerous/signer.py"
      ],
      "rubric": "Identify HMACAlgorithm.get_signature and Signer.get_signature."
    },
    {
      "id": "itsdangerous-deserialization",
      "repository": "itsdangerous",
      "kind": "impact",
      "prompt": "Which functions verify signatures before deserializing a payload, and what changes would be security-sensitive?",
      "reference_paths": [
        "src/itsdangerous/serializer.py",
        "src/itsdangerous/signer.py"
      ],
      "rubric": "Distinguish Serializer.loads, unsign and load_payload; no claim that decoding itself authenticates data."
    },
    {
      "id": "itsdangerous-expiry-tests",
      "repository": "itsdangerous",
      "kind": "testing",
      "prompt": "Where are timestamp-expiry tests and which production implementation do they exercise?",
      "reference_paths": [
        "tests/test_itsdangerous/test_timed.py",
        "src/itsdangerous/timed.py"
      ],
      "rubric": "Identify test_timed.py and the timestamp-aware signer or serializer."
    }
  ],
  "method": "assistant_in_chat"
}

