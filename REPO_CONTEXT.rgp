"""End-to-end dogfood freshness against real temporary Git history (no Rust needed)."""
import hashlib
import json
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))
sys.path.insert(0, str(ROOT / "tests"))
from repo_dogfood import check  # noqa: E402
from test_manifest_contract import fake_artifact  # noqa: E402
from rgp_reader import RgpError  # noqa: E402


class RepoDogfoodTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.repo = Path(self.tmp.name)
        self.call("init", "-q")
        self.call("config", "user.name", "RGP Test")
        self.call("config", "user.email", "rgp-test@example.invalid")
        (self.repo / "src").mkdir()
        (self.repo / "src/file.txt").write_bytes(b"alpha\nbeta\nbeta\n")
        self.call("add", "src/file.txt")
        self.call("commit", "-qm", "original source")
        self.source_commit = self.call("rev-parse", "HEAD").stdout.decode().strip()
        self.snapshot = self.repo / "REPO_CONTEXT.rgp"
        self.snapshot.write_bytes(fake_artifact(
            lambda m: m.update(source_commit=self.source_commit)))
        self.call("add", "REPO_CONTEXT.rgp")
        self.call("commit", "-qm", "publish only the RGP")
        self.publish_commit = self.call("rev-parse", "HEAD").stdout.decode().strip()

    def call(self, *args):
        return subprocess.run(["git", "-C", str(self.repo), *args],
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              check=True)

    def test_artifact_only_publication_is_fresh_even_with_different_head(self):
        report = check(self.repo)
        self.assertTrue(report["snapshot_complete"])
        self.assertTrue(report["snapshot_equivalent_to_checkout"])
        self.assertTrue(report["commit_difference_is_artifact_only"])
        self.assertEqual(report["source_commit"], self.source_commit)
        self.assertEqual(report["checkout_commit"], self.publish_commit)
        self.assertEqual(report["file_count"], 1)

    def test_single_file_publication_needs_no_sidecar(self):
        self.assertFalse((self.repo / "REPO_CONTEXT.rgpmi").exists())
        report = check(self.repo)
        self.assertTrue(report["snapshot_complete"])
        self.assertEqual(report["source_commit"], self.source_commit)

    def test_source_edit_after_publication_is_stale(self):
        (self.repo / "src/file.txt").write_text("changed after RGP publication\n")
        self.call("add", "src/file.txt")
        self.call("commit", "-qm", "modify source")
        with self.assertRaisesRegex(RgpError, "STALE_SNAPSHOT"):
            check(self.repo)

    def test_dirty_tracked_worktree_is_not_accepted_as_fresh(self):
        (self.repo / "src/file.txt").write_text("local edit not yet in Git\n")
        with self.assertRaisesRegex(RgpError, "STALE_SNAPSHOT"):
            check(self.repo)
        self.call("add", "src/file.txt")
        with self.assertRaisesRegex(RgpError, "STALE_SNAPSHOT"):
            check(self.repo)

    def test_untracked_source_is_not_in_rgp(self):
        (self.repo / "src/new.py").write_text("new function\n")
        with self.assertRaisesRegex(RgpError, "STALE_SNAPSHOT"):
            check(self.repo)

    def test_non_source_git_commit_does_not_magically_refresh_source(self):
        (self.repo / "AGENTS.md").write_text("New agent contract\n")
        self.call("add", "AGENTS.md")
        self.call("commit", "-qm", "modify docs")
        with self.assertRaisesRegex(RgpError, "STALE_SNAPSHOT"):
            check(self.repo)

    def test_modified_local_rgp_is_not_treated_as_trusted(self):
        with self.snapshot.open("ab") as output:
            output.write(b"uncommitted attacker bytes")
        with self.assertRaisesRegex(RgpError, "HASH_MISMATCH"):
            check(self.repo)

    def test_missing_rgp_refused(self):
        self.snapshot.unlink()
        with self.assertRaisesRegex(RgpError, "UNSUPPORTED_FORMAT"):
            check(self.repo)

    def test_unrelated_source_commit_rejected_even_if_source_text_same(self):
        original = self.source_commit
        self.call("checkout", "-qb", "unrelated", original)
        self.call("commit", "--allow-empty", "-qm", "different unrelated HEAD")
        other = self.call("rev-parse", "HEAD").stdout.decode().strip()
        # Explicitly use commit data from a diverged branch, then return.
        self.call("checkout", "-q", self.publish_commit)
        self.snapshot.write_bytes(fake_artifact(
            lambda m: m.update(source_commit=other)))
        self.call("add", "REPO_CONTEXT.rgp")
        self.call("commit", "-qm", "point snapshot at a non-ancestor")
        with self.assertRaisesRegex(RgpError, "STALE_SNAPSHOT"):
            check(self.repo)

    def test_export_materializes_only_checked_source(self):
        from repo_dogfood import export_workspace
        folder = self.repo / "outside-snapshot"
        report = check(self.repo)
        out = export_workspace(self.snapshot, folder, report["artifact_sha256"],
                               expected_commit=report["source_commit"])
        self.assertEqual(out["files_exported"], 1)
        self.assertEqual((folder / "src/file.txt").read_bytes(), b"alpha\nbeta\nbeta\n")


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_rgp_mcp.py
"""MCP protocol and source safety on a real, independently verified Reader."""
import json
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
sys.path.insert(0, str(ROOT / "tests"))
from test_reader_api import three_scope_artifact  # noqa: E402
from rgp_mcp import RgpMcp, TOOLS, MAX_RESPONSE  # noqa: E402
from rgp_reader import Reader  # noqa: E402


class ProtocolTests(unittest.TestCase):
    def setUp(self):
        self.server = RgpMcp(Reader(three_scope_artifact()))
        self.seq = 0

    def ask(self, method, params=None):
        self.seq += 1
        request = {"jsonrpc": "2.0", "id": self.seq, "method": method}
        if params is not None:
            request["params"] = params
        return self.server.dispatch(request)

    def tool(self, name, args=None):
        reply = self.ask("tools/call", {"name": name, "arguments": args or {}})
        self.assertEqual(reply["id"], self.seq)
        result = reply["result"]
        if not result["isError"]:
            return json.loads(result["content"][0]["text"])
        return result

    def initialize(self):
        message = self.ask("initialize", {"protocolVersion": "2025-06-18"})
        self.assertEqual(message["result"]["protocolVersion"], "2025-06-18")
        self.assertIn("tools", message["result"]["capabilities"])

    def test_initialize_before_tools_and_legacy_client(self):
        self.assertEqual(self.ask("tools/list")["error"]["code"], -32000)
        for version in ("2024-11-05", "2025-03-26", "2025-06-18"):
            response = self.ask("initialize", {"protocolVersion": version})
            self.assertEqual(response["result"]["protocolVersion"], version)
        self.assertIsNone(self.server.dispatch(
            {"jsonrpc": "2.0", "method": "notifications/initialized"}))
        self.assertEqual(self.ask("ping")["result"], {})

    def test_tools_are_real_and_bounded(self):
        self.initialize()
        listed = self.ask("tools/list")["result"]["tools"]
        self.assertEqual({t["name"] for t in listed},
                         {"rgp_status", "rgp_tree", "rgp_search",
                          "rgp_read", "rgp_context"})
        self.assertEqual(len(TOOLS), 5)
        status = self.tool("rgp_status")
        self.assertEqual(status["overview"]["source_commit"], "a" * 40)
        self.assertTrue(status["overview"]["snapshot_complete"])
        self.assertEqual(status["index"]["status"], "not_indexed")
        self.assertTrue(status["repository_source_untrusted"])
        tree = self.tool("rgp_tree", {"prefix": "src/", "limit": 1})
        self.assertEqual(tree["paths"], ["src/a.py"])
        last = self.tool("rgp_tree", {"prefix": "src/", "limit": 1,
                                     "cursor": tree["next_cursor"]})
        self.assertEqual(last["paths"], ["src/sub/b.py"])
        search = self.tool("rgp_search", {"query": "needle", "prefix": "src/"})
        self.assertEqual(len(search["matches"]), 3)
        read = self.tool("rgp_read", {"path": "src/a.py", "start_line": 1,
                                     "end_line": 1})
        self.assertEqual(read["content"], "needle from src A\n")
        ctx = self.tool("rgp_context", {"terms": ["needle", "again"],
                                        "prefix": "src/", "max_bytes": 2048})
        self.assertEqual(ctx["terms_without_source"], [])
        self.assertLessEqual(len(json.dumps(ctx, ensure_ascii=False).encode()),
                             2048 + 300)  # printed JSON uses canonical compact separators
        self.assertTrue(all(x["path"].startswith("src/") for x in ctx["sources"]))

    def test_bad_arguments_are_recoverable_not_fake_source(self):
        self.initialize()
        for name, args in (
            ("rgp_read", {"path": "../secret"}),
            ("rgp_read", {"path": "src/a.py", "start_line": True}),
            ("rgp_search", {"query": "needle", "paths": ["../unknown"]}),
            ("rgp_context", {"terms": ["needle"], "max_bytes": 100}),
            ("rgp_search", {"query": "needle", "extra": "fake"}),
            ("unknown_tool", {}),
        ):
            with self.subTest(name=name, args=args):
                error = self.tool(name, args)
                self.assertTrue(error["isError"])
                self.assertLessEqual(len(error["content"][0]["text"]), 240)
        self.assertEqual(self.tool("rgp_read", {"path": "src/a.py",
                                               "start_line": 1,
                                               "end_line": 1})["content"],
                         "needle from src A\n")

    def test_protocol_errors_and_unknown_notifications(self):
        self.initialize()
        self.assertIsNone(self.server.dispatch(
            {"jsonrpc": "2.0", "method": "notifications/unknown"}))
        self.assertEqual(self.ask("unknown/method")["error"]["code"], -32601)
        self.assertEqual(self.ask("tools/call", [])["error"]["code"], -32602)
        self.assertEqual(self.server.dispatch(
            {"jsonrpc": "2.0", "id": True, "method": "ping"})["error"]["code"], -32600)

    def test_stdio_real_process_keeps_one_reader_and_does_not_log_to_stdout(self):
        with tempfile.TemporaryDirectory() as directory:
            artifact = Path(directory) / "pinned.rgp"
            artifact.write_bytes(three_scope_artifact())
            with subprocess.Popen(
                [sys.executable, "-u", str(ROOT / "python/rgp_mcp.py"),
                 "--artifact", str(artifact)],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            ) as process:
                assert process.stdin and process.stdout
                def send(request):
                    process.stdin.write(
                        (json.dumps(request, ensure_ascii=False) + "\n").encode("utf-8"))
                    process.stdin.flush()
                    return json.loads(process.stdout.readline())
                init = send({"jsonrpc": "2.0", "id": 1, "method": "initialize",
                             "params": {"protocolVersion": "2025-06-18"}})
                self.assertEqual(init["result"]["serverInfo"]["name"], "rgp-pinned-source")
                process.stdin.write(
                    b'{"jsonrpc":"2.0","method":"notifications/initialized"}\n')
                process.stdin.flush()
                result = send({"jsonrpc": "2.0", "id": 2, "method": "tools/call",
                               "params": {"name": "rgp_search",
                                          "arguments": {"query": "again"}}})
                self.assertEqual(result["id"], 2)
                self.assertEqual(json.loads(result["result"]["content"][0]["text"])
                                 ["matches"][0]["line"], 2)
                process.stdin.close()
                self.assertEqual(process.wait(timeout=10), 0)
                self.assertEqual(process.stderr.read(), b"")

    def test_bad_model_unicode_is_recoverable_via_mcp(self):
        self.initialize()
        for name, arguments in (
            ("rgp_tree", {"prefix": chr(0xD800)}),
            ("rgp_search", {"query": chr(0xD800)}),
            ("rgp_context", {"terms": [chr(0xD800)]}),
        ):
            with self.subTest(name=name):
                result = self.tool(name, arguments)
                self.assertTrue(result["isError"])
        self.assertEqual(self.tool("rgp_search", {"query": "needle"})
                         ["matches"][0]["path"], "src/a.py")

    def test_escaped_surrogate_rpc_id_does_not_terminate_stdio(self):
        with tempfile.TemporaryDirectory() as directory:
            artifact = Path(directory) / "pinned.rgp"
            artifact.write_bytes(three_scope_artifact())
            with subprocess.Popen(
                [sys.executable, "-u", str(ROOT / "python/rgp_mcp.py"),
                 "--artifact", str(artifact)],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            ) as process:
                assert process.stdin and process.stdout
                def send_bytes(raw):
                    process.stdin.write(raw + b"\n")
                    process.stdin.flush()
                    return json.loads(process.stdout.readline())
                send_bytes(b'{"jsonrpc":"2.0","id":1,"method":"initialize"}')
                reply = send_bytes(b'{"jsonrpc":"2.0","id":"\\ud800","method":"ping"}')
                self.assertEqual(reply["id"], chr(0xD800))
                self.assertEqual(reply["result"], {})
                valid = send_bytes(b'{"jsonrpc":"2.0","id":3,"method":"tools/list"}')
                self.assertEqual(len(valid["result"]["tools"]), 5)
                process.stdin.close()
                self.assertEqual(process.wait(timeout=10), 0)
                self.assertEqual(process.stderr.read(), b"")

    def test_invalid_archive_cannot_start_mcp(self):
        with tempfile.TemporaryDirectory() as directory:
            invalid = Path(directory) / "broken.rgp"
            invalid.write_bytes(b"not an RGP")
            process = subprocess.run(
                [sys.executable, str(ROOT / "python/rgp_mcp.py"),
                 "--artifact", str(invalid)],
                capture_output=True, timeout=10,
            )
            self.assertEqual(process.returncode, 2)
            self.assertIn(b"RGP MCP startup failed", process.stderr)
            self.assertEqual(process.stdout, b"")


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_rgp_sandbox.py
"""RGP-first sandbox source workspace: real bytes, safe output and provenance."""
import hashlib
import json
import os
import stat
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
sys.path.insert(0, str(ROOT / "tests"))
from rgp_sandbox import METADATA, export_workspace as _export_workspace  # noqa: E402

def export_workspace(*args, **kwargs):
    """Existing test fixture is tied to the deliberately frozen fake commit."""
    return _export_workspace(*args, expected_commit="a" * 40, **kwargs)

from rgp_reader import RgpError, Reader  # noqa: E402
from test_reader_api import three_scope_artifact  # noqa: E402
from test_manifest_contract import fake_artifact  # noqa: E402
from test_reader import fixture  # noqa: E402


class SandboxWorkspaceTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        self.artifact = self.root / "source.rgp"
        self.raw = three_scope_artifact()
        self.artifact.write_bytes(self.raw)
        self.trusted = hashlib.sha256(self.raw).hexdigest()

    def test_valid_authenticated_but_stale_snapshot_rejected(self):
        destination = self.root / "stale"
        with self.assertRaisesRegex(RgpError, "STALE_SNAPSHOT"):
            _export_workspace(self.artifact, destination, self.trusted,
                              expected_commit="b" * 40)
        self.assertFalse(destination.exists())
        self.assertEqual(list(self.root.glob(".rgp-stage-*")), [])
        with self.assertRaises(TypeError):
            _export_workspace(self.artifact, destination, self.trusted)
        for bad_commit in ("", "HEAD", "A" * 40, "f" * 39):
            with self.subTest(bad_commit=bad_commit), self.assertRaisesRegex(
                    RgpError, "UNSUPPORTED_FORMAT"):
                _export_workspace(self.artifact, destination, self.trusted,
                                  expected_commit=bad_commit)
        self.assertFalse(destination.exists())

    def test_correct_commit_report_avoids_claiming_live_github_check(self):
        destination = self.root / "matching"
        result = _export_workspace(self.artifact, destination, self.trusted,
                                   expected_commit="a" * 40)
        self.assertEqual(result["expected_commit"], "a" * 40)
        self.assertEqual(result["source_commit"], "a" * 40)
        self.assertEqual(result["commit_match"], "matched_caller_supplied_commit")
        self.assertFalse(result["current_github_head_checked_by_exporter"])

    def test_real_reader_bytes_and_provenance_in_local_workspace(self):
        output = self.root / "worktree"
        report = export_workspace(self.artifact, output, self.trusted)
        self.assertEqual(report["source_commit"], "a" * 40)
        self.assertEqual(report["files_exported"], 4)
        self.assertTrue(report["snapshot_complete"])
        self.assertFalse(report["git_worktree"])
        self.assertEqual(report["rgp_sha256"], self.trusted)
        r = Reader(self.artifact)
        for item in r.manifest["files"]:
            path = output / item["path"]
            self.assertEqual(path.read_bytes(), r.read_bytes(item["path"]))
            self.assertTrue(stat.S_ISREG(path.lstat().st_mode))
            self.assertEqual(path.stat().st_mode & 0o111, 0)
        self.assertEqual(json.loads((output / METADATA).read_text()), report)
        self.assertFalse((output / ".git").exists())
        self.assertFalse((output / "REPO_CONTEXT.rgp").exists())

    def test_prefix_only_exports_requested_files(self):
        dst = self.root / "source-scope"
        result = export_workspace(self.artifact, dst, self.trusted, prefix="src/")
        self.assertEqual(result["files_exported"], 2)
        self.assertTrue((dst / "src/a.py").exists())
        self.assertTrue((dst / "src/sub/b.py").exists())
        self.assertFalse((dst / "tests").exists())
        self.assertFalse((dst / "src2").exists())
        self.assertEqual(result["prefix"], "src/")

    def test_out_of_band_hash_is_mandatory_and_no_partial_export(self):
        for bad in ("0" * 64, "invalid", "", self.trusted.upper()):
            target = self.root / "target"
            with self.subTest(hash=bad), self.assertRaises(RgpError):
                export_workspace(self.artifact, target, bad)
            self.assertFalse(target.exists())
        target = self.root / "corrupt"
        badfile = self.root / "truncated.rgp"
        badfile.write_bytes(self.raw[:-9])
        with self.assertRaisesRegex(RgpError, "TRUNCATED_ARTIFACT"):
            export_workspace(badfile, target, hashlib.sha256(badfile.read_bytes()).hexdigest())
        self.assertFalse(target.exists())

    def test_partial_snapshot_requires_explicit_opt_in(self):
        source = fake_artifact(lambda manifest: manifest["excluded"].append(
            {"path": "secrets.txt", "reason": "sensitive_path"}))
        self.artifact.write_bytes(source)
        digest = hashlib.sha256(source).hexdigest()
        target = self.root / "out"
        with self.assertRaisesRegex(RgpError, "PARTIAL_SNAPSHOT"):
            export_workspace(self.artifact, target, digest)
        self.assertFalse(target.exists())
        report = export_workspace(self.artifact, target, digest, allow_partial=True)
        self.assertFalse(report["snapshot_complete"])
        self.assertEqual(report["unavailable_paths"], 1)
        self.assertEqual(report["files_exported"], 1)

    def test_existing_destination_and_resource_limits(self):
        output = self.root / "already"
        output.mkdir()
        (output / "keep").write_text("keep")
        with self.assertRaisesRegex(RgpError, "UNSAFE_PATH"):
            export_workspace(self.artifact, output, self.trusted)
        self.assertEqual((output / "keep").read_text(), "keep")
        for kwargs in ({"max_files": 3}, {"max_bytes": 2},
                       {"prefix": "../"}, {"prefix": "/etc"},
                       {"max_files": True}, {"max_bytes": -1}):
            target = self.root / "lim"
            with self.subTest(kwargs=kwargs), self.assertRaises(RgpError):
                export_workspace(self.artifact, target, self.trusted, **kwargs)
            self.assertFalse(target.exists())

    def test_source_symlink_is_never_materialized_as_actual_symlink(self):
        def as_symlink(manifest):
            entry = manifest["files"][0]
            entry["mode"] = "120000"
            entry["kind"] = "symlink"
            manifest["input_tree_digest"] = hashlib.sha256(
                entry["path"].encode() + b"\0" + b"120000\0" +
                bytes.fromhex(entry["sha256"])).hexdigest()
        raw = fake_artifact(as_symlink)
        self.artifact.write_bytes(raw)
        target = self.root / "link-text"
        result = export_workspace(self.artifact, target, hashlib.sha256(raw).hexdigest())
        path = target / "src/file.txt"
        self.assertTrue(path.is_file())
        self.assertFalse(path.is_symlink())
        self.assertEqual(result["symlinks_materialized_as_regular_text_files"],
                         ["src/file.txt"])

    def test_source_executable_bit_is_not_materialized(self):
        def executable(manifest):
            entry = manifest["files"][0]
            entry["mode"] = "100755"
            manifest["input_tree_digest"] = hashlib.sha256(
                entry["path"].encode() + b"\0" + b"100755\0" +
                bytes.fromhex(entry["sha256"])).hexdigest()
        raw = fake_artifact(executable)
        self.artifact.write_bytes(raw)
        target = self.root / "scripts"
        export_workspace(self.artifact, target, hashlib.sha256(raw).hexdigest())
        self.assertEqual((target / "src/file.txt").stat().st_mode & 0o111, 0)

    def test_metadata_collision_refused_and_no_workspace_created(self):
        raw = fixture(path=METADATA)
        self.artifact.write_bytes(raw)
        output = self.root / "blocked"
        with self.assertRaisesRegex(RgpError, "UNSAFE_PATH"):
            export_workspace(self.artifact, output, hashlib.sha256(raw).hexdigest())
        self.assertFalse(output.exists())

    def test_python_cli_creates_local_data_tree(self):
        target = self.root / "cli-output"
        completed = subprocess.run(
            [sys.executable, str(ROOT / "python/rgp_sandbox.py"),
             "--artifact", str(self.artifact),
             "--trusted-sha256", self.trusted,
             "--expected-commit", "a" * 40,
             "--output", str(target), "--prefix", "tests/"],
            capture_output=True, text=True, check=True)
        report = json.loads(completed.stdout)
        self.assertEqual(report["files_exported"], 1)
        self.assertEqual((target / "tests/test_a.py").read_bytes(), b"needle from tests\n")
        self.assertEqual(completed.stderr, "")


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_rgpp_agent_context.py
"""Real Reader-backed agent context: focused source passages, not answers."""
import json
import sys
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
sys.path.insert(0, str(ROOT / "tests"))
from rgp_reader import Reader  # noqa: E402
from rgp_agent_context import context, compact_json  # noqa: E402
from test_reader_api import three_scope_artifact  # noqa: E402


class AgentContextTests(unittest.TestCase):
    def setUp(self):
        self.reader = Reader(three_scope_artifact())

    def test_pinned_source_lines_not_a_model_answer(self):
        result = context(self.reader, ["needle"], prefix="src/")
        self.assertEqual(result["source_commit"], "a" * 40)
        self.assertTrue(result["snapshot_complete"])
        self.assertEqual(result["index_coverage"], "not_indexed")
        self.assertEqual(result["retrieval"], "lexical_not_semantic")
        self.assertTrue(result["source_instructions_untrusted"])
        self.assertEqual(result["candidate_paths"], 2)
        self.assertTrue(result["sources"])
        for source in result["sources"]:
            self.assertTrue(source["path"].startswith("src/"))
            self.assertIn("needle", source["content"])
            self.assertIn(f":{source['start_line']}-{source['end_line']}",
                          source["source_reference"])
            original = self.reader.read(source["path"],
                                        source["start_line"],
                                        source["end_line"])
            self.assertEqual(source["content"], original["content"])

    def test_different_query_never_inherits_an_old_answer(self):
        missing = context(self.reader, ["ABSENT_SOURCE_SYMBOL"])
        self.assertEqual(missing["sources"], [])
        self.assertEqual(missing["candidate_paths"], 0)
        self.assertEqual(missing["search_capped_terms"], [])
        self.assertEqual(missing["retrieval"], "lexical_not_semantic")

    def test_no_sibling_prefix_leak_and_multiple_terms_ranked(self):
        result = context(self.reader, ["needle", "again"], prefix="src/")
        self.assertEqual(result["sources"][0]["path"], "src/a.py")
        chosen_terms = [s["match_term"] for s in result["sources"]
                        if s["path"] == "src/a.py"]
        self.assertIn("needle", chosen_terms)
        self.assertIn("again", chosen_terms)
        self.assertFalse(any(s["path"].startswith("src2/") or
                             s["path"].startswith("tests/")
                             for s in result["sources"]))

    def test_output_size_bound(self):
        result = context(self.reader, ["needle", "again"], max_bytes=2048)
        self.assertLessEqual(len(compact_json(result).encode("utf-8")), 2048)

    def test_unknown_or_malformed_queries_are_rejected(self):
        for terms in ([], [""] , ["x" * 129], ["x"] * 7):
            with self.subTest(terms=terms):
                with self.assertRaises(ValueError):
                    context(self.reader, terms)
        for kwargs in ({"max_files": 0}, {"max_bytes": 100},
                       {"max_files": 8}, {"max_bytes": 65537}):
            with self.subTest(kwargs=kwargs), self.assertRaises(ValueError):
                context(self.reader, ["needle"], **kwargs)

    def test_bad_model_search_term_is_a_recoverable_argument_error(self):
        with self.assertRaisesRegex(ValueError, "UTF-8 bytes"):
            context(self.reader, ["needle", chr(0xD800)])
        self.assertEqual(context(self.reader, ["needle"])["terms"],
                         ["needle"])

    def test_no_code_executed_in_a_source_context(self):
        result = context(self.reader, ["needle"], prefix="tests/")
        self.assertEqual(result["candidate_paths"], 1)
        self.assertEqual(result["sources"][0]["path"], "tests/test_a.py")
        self.assertEqual(result["source_instructions_untrusted"], True)


if __name__ == "__main__":
    unittest.main()

