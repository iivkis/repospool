name: Dependency audit
on:
  schedule:
    - cron: '17 6 * * 1'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  rust-audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
      - run: cargo metadata --locked --no-deps > /dev/null
      - uses: rustsec/audit-check@v2.0.0
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

FILE	".github/workflows/stage1-corpus.yml"	3415	86f2ce469033b55a86f3567ec03f74f3680ca7464b6a1fac6d37c5a3f66bd78c
name: Stage 1 pinned-corpus evidence

on:
  pull_request:
    paths:
      - .github/workflows/stage1-corpus.yml
      - scripts/stage1_corpus.py
      - tests/test_stage1_corpus.py
      - src/main.rs
      - python/rgp_reader.py
      - benchmarks/gate_b/plan.json
      - benchmarks/gate_b/corpus_preparation.json
  push:
    branches: [main]
    paths:
      - .github/workflows/stage1-corpus.yml
      - scripts/stage1_corpus.py
      - tests/test_stage1_corpus.py
      - src/main.rs
      - python/rgp_reader.py
      - benchmarks/gate_b/plan.json
      - benchmarks/gate_b/corpus_preparation.json
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: stage1-corpus-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  pinned-corpus:
    name: Pinned corpus ${{ matrix.repository }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        repository: [rgp, serde_json, itsdangerous]
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Validate frozen task and anchor mapping
        run: |
          python3 -m unittest discover -s tests -p 'test_stage1_corpus.py' -v
          python3 scripts/gate_b.py plan
      - name: Build real Rust generator
        run: cargo build --locked --release
      - name: Fetch pinned source and independently test generated RGP
        shell: bash
        env:
          CORPUS_REPOSITORY: ${{ matrix.repository }}
        run: |
          set -euo pipefail
          python3 scripts/stage1_corpus.py \
            --repository "$CORPUS_REPOSITORY" \
            --rust-cli target/release/rgp \
            --report "$RUNNER_TEMP/stage1-corpus.json"
      - name: Report exact measured evidence and limitations
        if: always()
        shell: bash
        env:
          CORPUS_REPOSITORY: ${{ matrix.repository }}
        run: |
          if [ -f "$RUNNER_TEMP/stage1-corpus.json" ]; then
            python3 - <<'PY'
          import json, os
          from pathlib import Path
          data = json.loads((Path(os.environ["RUNNER_TEMP"]) / "stage1-corpus.json").read_text())
          with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as out:
              out.write(f"### Stage 1: {os.environ['CORPUS_REPOSITORY']}\n\n")
              out.write(f"Status: **{data['status']}** · Gate B: **HOLD**\n\n")
              if data['status'] == "PASS":
                  out.write(f"Pinned SHA: `{data['source_commit']}`\n\n")
                  out.write(f"RGP SHA-256: `{data['rgp_sha256']}`\n\n")
                  out.write(f"RGP: {data['rgp_bytes']} bytes; {len(data['tasks'])} source tasks verified\n\n")
                  out.write(f"Measured resources: `{data['timings']}`\n\n")
              else:
                  out.write(f"Failure: `{data.get('reason', 'unknown')}`\n\n")
              out.write("Not a connector transport test or independent Gate B answer grade.\n")
          PY
          fi
      - name: Upload metadata-only evidence (never repository contents or RGP)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: stage1-corpus-${{ matrix.repository }}
          path: ${{ runner.temp }}/stage1-corpus.json
          retention-days: 14
          if-no-files-found: warn

