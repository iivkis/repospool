FILE	".github/dependabot.yml"	195	db76b8360b5460ae333e00659f7ff11dd62359cb6edf1b8bb493e21103e5f459
version: 2
updates:
  - package-ecosystem: cargo
    directory: /
    schedule:
      interval: weekly
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly

FILE	".github/pull_request_template.md"	1101	9cd07aca4f77adb01736e407f478cc82c8bcf7089675a0617ffc2f4de0599665
## What changed

## Goal-level acceptance (agent-owned)
- [ ] Observable user goal and expected results were stated before the change
- [ ] Implementing agent generated a real RGP from a pinned commit, verified it and used the Reader to answer a predefined repository task (when RGP behavior changed)
- [ ] Agent compared results with source truth and recorded commit/SHA-256, exact commands, observed outcomes and failures
- [ ] If execution was blocked: clearly marked NOT RUN/BLOCKED, with no claim of completion
- [ ] Documentation-only change: links and consistency checked; no invented test executions

## Tests
- [ ] `just check` or equivalent tests
- [ ] Reproducible RGP output checked if serialization changed
- [ ] New negative cases for untrusted inputs

## Safety and product gates
- [ ] No secrets or private source snapshots committed/uploaded
- [ ] No semantic completeness or connector-transport claims without evidence
- [ ] Gate B remains HOLD unless its specific evidence requirements are fulfilled

See [AGENTS.md](../AGENTS.md) and [Product Roadmap](../docs/PRODUCT_ROADMAP.md).

FILE	".github/workflows/ci.yml"	7200	c8f16376702ecea9679528506f00df913d4e8bce9ec5ef97947c149cef0268d8
name: CI
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  rust:
    name: Rust fmt, clippy, test and snapshot
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - uses: Swatinem/rust-cache@v2
      - name: Formatting
        run: cargo fmt --all -- --check
      - name: Clippy
        run: cargo clippy --locked --all-targets -- -D warnings
      - name: Rust tests
        run: cargo test --locked --all-targets
      - name: Reader stdlib tests
        run: python3 -m unittest discover -s tests -p 'test_*.py' -v
      - name: Reader bounded API and CLI smoke
        shell: bash
        run: |
          set -euo pipefail
          python3 python/rgp_reader.py --artifact tests/fixtures/v1/valid-mixed.rgp coverage --scope snapshot
          python3 python/rgp_reader.py --artifact tests/fixtures/v1/valid-mixed.rgp search 'return 42' --limit 1
      - name: Assistant-only Gate B tests and HOLD
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/gate_b.py plan
          python3 scripts/gate_b_sensitivity.py > "$RUNNER_TEMP/sensitivity.json"
          python3 -c 'import json,sys; v=json.load(open(sys.argv[1])); assert v["new_experimental_trials"] == 0 and v["total_nonempty_subsets"] == 4095 and v["full_run_measured_calls"] == {"github":13, "rgp":6} and v["decision"].startswith("HOLD")' "$RUNNER_TEMP/sensitivity.json"
          python3 scripts/gate_b.py report > "$RUNNER_TEMP/hold.json"
          python3 -c 'import json,sys; assert json.load(open(sys.argv[1]))["status"] == "HOLD"' "$RUNNER_TEMP/hold.json"
      - name: Prepare arm-masked Gate B reviewer handoff and assert HOLD
        shell: bash
        run: |
          set -euo pipefail
          handoff="$RUNNER_TEMP/gate-b-review-handoff"
          mkdir -p "$handoff"
          python3 scripts/gate_b_source_lines.py --help > /dev/null
          python3 scripts/gate_b_review.py pack > "$handoff/packet.json"
          python3 scripts/gate_b_review.py template --packet "$handoff/packet.json" > "$handoff/review-template.json"
          python3 scripts/gate_b_review.py check --packet "$handoff/packet.json" --review "$handoff/review-template.json" > "$handoff/initial-status.json"
          python3 -c 'import json,sys; v=json.load(open(sys.argv[1])); assert v["status"]=="HOLD" and v["missing"]==24' "$handoff/initial-status.json"
          # Self-recorded counts are not proof of provider calls.
          # The new handoff contains 19 intentionally missing receipts.
          python3 scripts/gate_b_call_audit.py template --output "$handoff/tool-receipt-template.json" > /dev/null
          python3 scripts/gate_b_call_audit.py audit --ledger "$handoff/tool-receipt-template.json" --output "$handoff/tool-receipt-status.json" > /dev/null
          python3 -c 'import json,sys; x=json.load(open(sys.argv[1])); assert x["status"]=="HOLD" and x["missing_receipts_total"]==19 and x["verified_connector_call_reduction"] is None' "$handoff/tool-receipt-status.json"
          python3 scripts/gate_b_decision.py --packet "$handoff/packet.json" --review "$handoff/review-template.json" --ledger "$handoff/tool-receipt-template.json" --output "$handoff/final-gate-b-status.json" > /dev/null
          python3 -c 'import json,sys; x=json.load(open(sys.argv[1])); assert x["official_status"]=="HOLD" and x["answer_review"]["missing"]==24 and x["tool_history"]["missing_receipts_total"]==19' "$handoff/final-gate-b-status.json"
          # Integrity and discovery hashes are supplied, but no reviewer verdict is invented.
          cp benchmarks/gate_b/source_line_counts.json "$handoff/source-line-counts.json"
          cp benchmarks/gate_b/corpus_preparation.json "$handoff/corpus-checkpoint.json"
          (cd "$handoff" && sha256sum packet.json review-template.json initial-status.json tool-receipt-template.json tool-receipt-status.json final-gate-b-status.json source-line-counts.json corpus-checkpoint.json > SHA256SUMS)
          cp docs/GATE_B_REVIEW.md "$handoff/INSTRUCTIONS.md"
      - name: Upload Gate B review handoff (not a reviewed result)
        uses: actions/upload-artifact@v4
        with:
          name: gate-b-review-handoff
          path: ${{ runner.temp }}/gate-b-review-handoff/
          if-no-files-found: error
          retention-days: 14
      - name: Immutable golden fixtures and Rust/Python verifier parity
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/golden_fixtures.py check
          cargo build --locked
          python3 scripts/golden_fixtures.py check --rust-cli target/debug/rgp
      - name: Tiny valid RGP transport fixture and negative tests
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/transport_probe.py generate --output-dir "$RUNNER_TEMP/probe" --sizes 102400
          python3 scripts/transport_probe.py verify --input-dir "$RUNNER_TEMP/probe" --expected "$RUNNER_TEMP/probe/expected.json"
      - name: Canonical cross-language round-trip and determinism
        shell: bash
        run: |
          set -euo pipefail
          cargo run --locked -- generate --repo . --output "$RUNNER_TEMP/a.rgp"
          cargo run --locked -- generate --repo . --output "$RUNNER_TEMP/b.rgp"
          cmp "$RUNNER_TEMP/a.rgp" "$RUNNER_TEMP/b.rgp"
          cargo run --locked -- verify --artifact "$RUNNER_TEMP/a.rgp" --repo .
          python3 python/rgp_reader.py --artifact "$RUNNER_TEMP/a.rgp" overview
          python3 python/rgp_reader.py --artifact "$RUNNER_TEMP/a.rgp" read --path README.md
      - name: Stage 1 agent-owned RGP acceptance against pinned Git sources
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/stage1_acceptance.py \
            --rust-cli target/debug/rgp \
            --report "$RUNNER_TEMP/stage1-acceptance.json"
          python3 -c 'import json,sys; r=json.load(open(sys.argv[1])); assert r["status"]=="PASS" and len(r["tasks"])==3 and r["gate_b"]=="HOLD"' "$RUNNER_TEMP/stage1-acceptance.json"
      - name: Publish sanitized Stage 1 acceptance evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: stage1-acceptance
          path: ${{ runner.temp }}/stage1-acceptance.json
          if-no-files-found: warn
          retention-days: 14

  nix:
    name: Nix flake dev-shell evaluation
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: DeterminateSystems/nix-installer-action@v17
      - uses: DeterminateSystems/magic-nix-cache-action@v11
      - run: nix flake check --no-update-lock-file --show-trace
      - run: nix develop --no-update-lock-file --command bash -c 'cargo --version && rustc --version && uv --version && python3 --version && task --version && task --list && task --dry check'

FILE	".github/workflows/gate-b-prepare.yml"	13143	79ff71d7e8d376f4ca965a4ee9808eff321feafde242fd8fb5a60d3a5880ecb8
name: Gate B pinned corpus preparation

on:
  workflow_dispatch:
  pull_request:
    paths:
      - .github/workflows/gate-b-prepare.yml
      - benchmarks/gate_b/plan.json
      - benchmarks/gate_b/corpus_preparation.json
      - scripts/gate_b.py
      - scripts/stage1_delivery.py
      - tests/test_stage1_delivery.py
      - python/rgp_bootstrap.py
      - python/rgp_agent_context.py
      - scripts/stage1_agent_task_pilot.py
      - tests/test_rgpp_agent_context.py
      - python/rgp_mcp.py
      - tests/test_rgp_mcp.py
      - scripts/stage1_mcp_agent_trial.py
      - python/rgp_sandbox.py
      - tests/test_rgp_sandbox.py
      - scripts/stage1_sandbox_task_trial.py
  push:
    branches: [main]
    paths:
      - .github/workflows/gate-b-prepare.yml
      - benchmarks/gate_b/plan.json
      - benchmarks/gate_b/corpus_preparation.json
      - scripts/gate_b.py
      - scripts/stage1_delivery.py
      - tests/test_stage1_delivery.py
      - python/rgp_bootstrap.py
      - python/rgp_agent_context.py
      - scripts/stage1_agent_task_pilot.py
      - tests/test_rgpp_agent_context.py
      - python/rgp_mcp.py
      - tests/test_rgp_mcp.py
      - scripts/stage1_mcp_agent_trial.py
      - python/rgp_sandbox.py
      - tests/test_rgp_sandbox.py
      - scripts/stage1_sandbox_task_trial.py

permissions:
  contents: read

jobs:
  prepare:
    name: Prepare ${{ matrix.repository }}
    runs-on: ubuntu-latest
    timeout-minutes: 35
    strategy:
      fail-fast: false
      matrix:
        include:
          - repository: rgp
            url: https://github.com/iivkis/rgp.git
            commit: 95963a23e2fd1e5eb68a72db3bde849ed7119a7c
          - repository: serde_json
            url: https://github.com/serde-rs/json.git
            commit: 8c535a260ce561eaab4111aafc29038eb9f77ff3
          - repository: itsdangerous
            url: https://github.com/pallets/itsdangerous.git
            commit: 672971d66a2ef9f85151e53283113f33d642dabd
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Validate preregistered comparison plan
        run: python3 scripts/gate_b.py plan
      - name: Download exact pinned source without running its code
        shell: bash
        env:
          SRC_URL: ${{ matrix.url }}
          SRC_COMMIT: ${{ matrix.commit }}
        run: |
          set -euo pipefail
          git init -q "$RUNNER_TEMP/source"
          git -C "$RUNNER_TEMP/source" remote add origin "$SRC_URL"
          git -C "$RUNNER_TEMP/source" -c protocol.version=2 fetch --depth=1 --filter=blob:none origin "$SRC_COMMIT"
          git -C "$RUNNER_TEMP/source" checkout --detach -q FETCH_HEAD
          test "$(git -C "$RUNNER_TEMP/source" rev-parse HEAD)" = "$SRC_COMMIT"
      - name: Verify benchmark reference paths exist at pinned commit
        env:
          SRC_REPO: ${{ matrix.repository }}
          SRC_COMMIT: ${{ matrix.commit }}
        run: |
          python3 - <<'PY'
          import os
          import subprocess
          from pathlib import Path
          from scripts.gate_b import strict_json
          plan = strict_json(Path("benchmarks/gate_b/plan.json"))
          tasks = [t for t in plan["tasks"] if t["repository"] == os.environ["SRC_REPO"]]
          assert tasks, "no benchmark tasks for this repository"
          for task in tasks:
              for path in task["reference_paths"]:
                  subprocess.run(
                      ["git", "-C", str(Path(os.environ["RUNNER_TEMP"]) / "source"),
                       "cat-file", "-e", f"{os.environ['SRC_COMMIT']}:{path}"],
                      check=True,
                  )
          print(f"Validated {len(tasks)} pinned task reference sets")
          PY
      - name: Produce and verify pinned RGP snapshot
        shell: bash
        env:
          SRC_COMMIT: ${{ matrix.commit }}
        run: |
          set -euo pipefail
          cargo run --locked --release -- generate \
            --repo "$RUNNER_TEMP/source" --rev "$SRC_COMMIT" \
            --output "$RUNNER_TEMP/REPO_CONTEXT.rgp"
          cargo run --locked --release -- verify \
            --artifact "$RUNNER_TEMP/REPO_CONTEXT.rgp" --repo "$RUNNER_TEMP/source"
          python3 python/rgp_reader.py --artifact "$RUNNER_TEMP/REPO_CONTEXT.rgp" validate
      - name: Write transport-independent provenance
        shell: bash
        env:
          SRC_REPO: ${{ matrix.repository }}
          SRC_COMMIT: ${{ matrix.commit }}
        run: |
          python3 - <<'PY'
          import hashlib
          import json
          import os
          from pathlib import Path
          from python.rgp_reader import Reader
          root = Path(os.environ["RUNNER_TEMP"])
          path = root / "REPO_CONTEXT.rgp"
          reader = Reader(path)
          assert reader.manifest["source_commit"] == os.environ["SRC_COMMIT"]
          plan_path = Path("benchmarks/gate_b/plan.json")
          from scripts.gate_b import digest_plan, strict_json
          report = {
              "repository": os.environ["SRC_REPO"],
              "source_commit": os.environ["SRC_COMMIT"],
              "plan_sha256": digest_plan(strict_json(plan_path)),
              "rgp_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
              "rgp_bytes": path.stat().st_size,
              "reader_overview": reader.overview(),
              "transport_verified": False,
              "note": "CI generation and ZIP integrity only. Agent-side connector download must be measured separately."
          }
          (root / "provenance.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
          with open(os.environ["GITHUB_STEP_SUMMARY"], "a", encoding="utf-8") as summary:
              summary.write(f"### {report['repository']}\n")
              summary.write(f"Pinned commit: `{report['source_commit']}`\n\n")
              summary.write(f"RGP SHA-256: `{report['rgp_sha256']}`\n\n")
              summary.write(f"RGP bytes: {report['rgp_bytes']}\n\n")
              summary.write(f"Snapshot complete: {report['reader_overview']['snapshot_complete']}\n")
          PY
      - name: Verify local Actions-style ZIP against committed checkpoint and independent Git
        shell: bash
        env:
          SRC_REPO: ${{ matrix.repository }}
        run: |
          set -euo pipefail
          python3 -m unittest discover -s tests -p 'test_stage1_delivery.py' -q
          python3 - <<'PY'
          import os
          from pathlib import Path
          from zipfile import ZipFile, ZIP_STORED
          folder = Path(os.environ["RUNNER_TEMP"])
          with ZipFile(folder / "local-actions-wrapper.zip", "w", ZIP_STORED) as archive:
              archive.write(folder / "REPO_CONTEXT.rgp", "REPO_CONTEXT.rgp")
              archive.write(folder / "provenance.json", "provenance.json")
          PY
          python3 scripts/stage1_delivery.py \
            --actions-zip "$RUNNER_TEMP/local-actions-wrapper.zip" \
            --repository "$SRC_REPO" \
            --source-repo "$RUNNER_TEMP/source" \
            --output "$RUNNER_TEMP/recovered.rgp" \
            --report "$RUNNER_TEMP/delivery-check.json"
          cmp "$RUNNER_TEMP/recovered.rgp" "$RUNNER_TEMP/REPO_CONTEXT.rgp"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          report = json.loads((Path(os.environ["RUNNER_TEMP"]) / "delivery-check.json").read_text())
          assert (report["status"] == "PASS" and
                  report["task_reference_sets"] == 4 and
                  report["source_comparison"] == "PASS" and
                  report["gate_b"] == "HOLD")
          print("STAGE1_DELIVERY_SHA256=" + report["rgp_sha256"])
          print("STAGE1_DELIVERY_PINNED_SOURCE=" + report["source_commit"])
          print("STAGE1_DELIVERY_RESULT=PASS")
          PY
      - name: Agent question to source-context to pinned-Git evidence
        env:
          SRC_REPO: ${{ matrix.repository }}
        shell: bash
        run: |
          set -euo pipefail
          python3 -m unittest discover -s tests -p 'test_rgpp_agent_context.py' -q
          python3 scripts/stage1_agent_task_pilot.py \
            --repository "$SRC_REPO" \
            --artifact "$RUNNER_TEMP/REPO_CONTEXT.rgp" \
            --source-repo "$RUNNER_TEMP/source" \
            --report "$RUNNER_TEMP/agent-task-pilot.json"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          x = json.loads((Path(os.environ["RUNNER_TEMP"]) / "agent-task-pilot.json").read_text())
          assert x["status"] == "PASS" and x["gate_b"] == "HOLD"
          assert x["task_count"] == 4 and len(x["tasks"]) == 4
          assert x["source_passages_compared_to_pinned_git"] >= 8
          assert all(t["source_navigation"] == "PASS" for t in x["tasks"])
          assert all(t["answer_correctness"] == "NOT_INDEPENDENTLY_GRADED"
                     for t in x["tasks"])
          assert x["model_inference"] == "NOT_RUN_BY_CI"
          assert x["independent_answer_grading"] == "NOT_RUN"
          assert x["provider_connector_calls"] == "NOT_MEASURED_BY_LOCAL_GIT"
          PY
      - name: Upload metadata-only question-context results
        uses: actions/upload-artifact@v4
        with:
          name: stage1-agent-context-${{ matrix.repository }}
          path: ${{ runner.temp }}/agent-task-pilot.json
          retention-days: 14
          if-no-files-found: error
      - name: Real MCP client solves 4 pinned source tasks
        env:
          SRC_REPO: ${{ matrix.repository }}
        shell: bash
        run: |
          set -euo pipefail
          python3 -m unittest discover -s tests -p 'test_rgp_mcp.py' -q
          python3 scripts/stage1_mcp_agent_trial.py \
            --repository "$SRC_REPO" \
            --artifact "$RUNNER_TEMP/REPO_CONTEXT.rgp" \
            --source-repo "$RUNNER_TEMP/source" \
            --report "$RUNNER_TEMP/mcp-agent-trial.json"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          x = json.loads((Path(os.environ["RUNNER_TEMP"]) / "mcp-agent-trial.json").read_text())
          assert x["status"] == "PASS" and x["gate_b"] == "HOLD"
          assert x["task_count"] == 4 and x["verified_source_passages"] >= 8
          assert x["mcp_tool_calls"] >= 12 and x["negative_read_rejected"]
          assert x["model_inference"] == "NOT_RUN"
          assert x["independent_answer_grading"] == "NOT_RUN"
          PY
      - name: Publish metadata-only MCP coding-agent evidence
        uses: actions/upload-artifact@v4
        with:
          name: stage1-mcp-agent-${{ matrix.repository }}
          path: ${{ runner.temp }}/mcp-agent-trial.json
          retention-days: 14
          if-no-files-found: error
      - name: Export independently pinned RGP into a sandbox source workspace
        env:
          SRC_REPO: ${{ matrix.repository }}
        shell: bash
        run: |
          set -euo pipefail
          python3 -m unittest discover -s tests -p 'test_rgp_sandbox.py' -q
          python3 scripts/stage1_sandbox_task_trial.py \
            --repository "$SRC_REPO" \
            --artifact "$RUNNER_TEMP/REPO_CONTEXT.rgp" \
            --source-repo "$RUNNER_TEMP/source" \
            --output "$RUNNER_TEMP/agent-sandbox-workspace" \
            --report "$RUNNER_TEMP/sandbox-workspace-trial.json"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          value = json.loads((Path(os.environ["RUNNER_TEMP"]) / "sandbox-workspace-trial.json").read_text())
          assert value["status"] == "PASS" and value["gate_b"] == "HOLD"
          assert value["files_exported"] == value["source_files_compared_byte_for_byte_to_git"]
          assert value["valid_but_stale_commit_rejected"]
          assert value["expected_commit_matches_pinned_git"]
          assert value["artifact_sha256_matched_committed_external_checkpoint"]
          assert value["all_file_executable_bits_cleared"]
          assert value["source_code_execution"] == "NONE"
          assert value["model_task_quality"] == "NOT_MEASURED_BY_THIS_SCRIPT"
          PY
      - name: Publish metadata-only sandbox workspace evidence
        uses: actions/upload-artifact@v4
        with:
          name: stage1-sandbox-workspace-${{ matrix.repository }}
          path: ${{ runner.temp }}/sandbox-workspace-trial.json
          retention-days: 14
          if-no-files-found: error
      - name: Publish metadata-only delivery evidence
        uses: actions/upload-artifact@v4
        with:
          name: stage1-delivery-${{ matrix.repository }}
          path: ${{ runner.temp }}/delivery-check.json
          retention-days: 14
          if-no-files-found: error
      - uses: actions/upload-artifact@v4
        with:
          name: gate-b-${{ matrix.repository }}
          path: |
            ${{ runner.temp }}/REPO_CONTEXT.rgp
            ${{ runner.temp }}/provenance.json
          retention-days: 7
          if-no-files-found: error

FILE	".github/workflows/kira-sandbox-rgp.yml"	6939	c6c8a54870eec978959ec5c2633a221e7289a9f83eab7710873efd47b3e8b1b0
name: Kira sandbox RGP snapshot

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: kira-sandbox-rgp-${{ github.ref }}
  cancel-in-progress: true

jobs:
  snapshot:
    name: Verified snapshot at current GitHub SHA
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: true
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Build release generator and produce exactly the triggering commit
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          cargo build --locked --release
          target/release/rgp generate \
            --repo . --rev "$GITHUB_SHA" \
            --output "$RUNNER_TEMP/REPO_CONTEXT.rgp"
          target/release/rgp verify \
            --artifact "$RUNNER_TEMP/REPO_CONTEXT.rgp" --repo .
          python3 python/rgp_reader.py \
            --artifact "$RUNNER_TEMP/REPO_CONTEXT.rgp" validate
          python3 python/rgpmi.py \
            --metadata "$RUNNER_TEMP/REPO_CONTEXT.rgpmi" \
            --expected-commit "$GITHUB_SHA"
      - name: Publish out-of-band source SHA and digest to Actions job summary
        id: attest
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import hashlib
          import json
          import os
          from pathlib import Path
          import sys
          sys.path.insert(0, "python")
          from rgp_reader import Reader

          path = Path(os.environ["RUNNER_TEMP"]) / "REPO_CONTEXT.rgp"
          reader = Reader(path)
          overview = reader.overview()
          commit = os.environ["GITHUB_SHA"]
          assert overview["source_commit"] == commit
          assert overview["snapshot_complete"], "unsafe partial default sandbox snapshot"
          sha = hashlib.sha256(path.read_bytes()).hexdigest()
          report = {
              "kind": "rgp_sandbox_current_commit_snapshot",
              "source_commit": commit,
              "rgp_sha256": sha,
              "rgp_bytes": path.stat().st_size,
              "file_count": overview["file_count"],
              "included_source_bytes": overview["included_bytes"],
              "snapshot_complete": True,
              "index_coverage": overview["index_coverage"],
              "provenance_source": "GitHub Actions job summary (separate from downloaded artifact)",
              "gate_b": "HOLD",
          }
          (path.parent / "snapshot-provenance.json").write_text(
              json.dumps(report, sort_keys=True, indent=2) + "\n"
          )
          with open(os.environ["GITHUB_STEP_SUMMARY"], "a", encoding="utf-8") as summary:
              summary.write("## RGP for Kira's local coding sandbox\n\n")
              summary.write(f"GitHub SHA: `{commit}`\n\n")
              summary.write(f"Independent expected RGP SHA-256: `{sha}`\n\n")
              summary.write(f"Source files: {overview['file_count']}\n\n")
              summary.write("Snapshot complete: true. **This SHA is available independently from the downloaded ZIP.**\n\n")
              summary.write("Use the exact SHA as --expected-commit when exporting to the Python sandbox.\n")
          with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as output:
              output.write(f"rgp_sha256={sha}\n")
          print("RGP_CURRENT_COMMIT=" + commit)
          print("RGP_TRUSTED_SHA256=" + sha)
          PY
      - name: Exercise actual sandbox source export for this exact Git commit
        shell: bash
        env:
          TRUSTED_SHA256: ${{ steps.attest.outputs.rgp_sha256 }}
        run: |
          set -euo pipefail
          python3 python/rgp_sandbox.py \
            --artifact "$RUNNER_TEMP/REPO_CONTEXT.rgp" \
            --trusted-sha256 "$TRUSTED_SHA256" \
            --expected-commit "$GITHUB_SHA" \
            --output "$RUNNER_TEMP/rgp-local-source"
          python3 - <<'PY'
          import json
          import os
          from pathlib import Path
          folder = Path(os.environ["RUNNER_TEMP"]) / "rgp-local-source"
          x = json.loads((folder / ".rgp-sandbox.json").read_text())
          assert x["source_commit"] == os.environ["GITHUB_SHA"]
          assert x["expected_commit"] == os.environ["GITHUB_SHA"]
          assert x["files_exported"] > 0 and x["snapshot_complete"]
          assert x["files_non_executable"] and not x["git_worktree"]
          assert x["current_github_head_checked_by_exporter"] is False
          print("RGP_SANDBOX_SELF_DOGFOOD=PASS")
          print("RGP_EXPORT_FILES=" + str(x["files_exported"]))
          PY
      - name: Upload actual current-commit RGP for Kira to download
        uses: actions/upload-artifact@v4
        with:
          name: kira-sandbox-rgp-${{ github.sha }}
          path: |
            ${{ runner.temp }}/REPO_CONTEXT.rgp
            ${{ runner.temp }}/REPO_CONTEXT.rgpmi
            ${{ runner.temp }}/snapshot-provenance.json
          retention-days: 7
          if-no-files-found: error
      - name: Keep REPO_CONTEXT.rgp and .rgpmi in main for normal agent development
        if: github.ref == 'refs/heads/main'
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          # Avoid a commit on an artifact-only run. Compare source data,
          # never rely on the embedded commit hash matching HEAD literally.
          if test -f REPO_CONTEXT.rgp && python3 scripts/repo_dogfood.py check --repo .; then
            echo "Tracked RGP already represents this exact source tree"
            exit 0
          fi
          cp "$RUNNER_TEMP/REPO_CONTEXT.rgp" REPO_CONTEXT.rgp
          cp "$RUNNER_TEMP/REPO_CONTEXT.rgpmi" REPO_CONTEXT.rgpmi
          git add -- REPO_CONTEXT.rgp REPO_CONTEXT.rgpmi
          if git diff --cached --quiet; then
            echo "Tracked RGP bytes unchanged"
            python3 scripts/repo_dogfood.py check --repo .
            exit 0
          fi
          # Only the archive and its sidecar may change in this publication.
          while IFS= read -r changed; do
            case "$changed" in
              REPO_CONTEXT.rgp|REPO_CONTEXT.rgpmi) ;;
              *) echo "Unexpected staged change: $changed" >&2; exit 1 ;;
            esac
          done < <(git diff --cached --name-only)
          git -c user.name="github-actions[bot]" \
              -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
              commit -m "chore(rgp): refresh tracked source context for $GITHUB_SHA"
          python3 scripts/repo_dogfood.py check --repo .
          # Never force a concurrent user's change; a newer push will
          # trigger its own snapshot workflow and eventually supersede this.
          git push origin HEAD:main

