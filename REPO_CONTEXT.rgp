FILE	.github/pull_request_template.md
## Change and acceptance

- [ ] Goal stated in observable terms
- [ ] RGP remains language-agnostic and does not infer code meaning
- [ ] No semantic symbols, file-role guesses or per-file hashes in artifact
- [ ] Single `rgp generate .` artifact still reads without companion tools
- [ ] Included files, byte framing, RGP line coordinates and omission coverage remain correct

## Verification

- [ ] `task check`
- [ ] `task nix:check`
- [ ] Output stable for identical pinned Git input
- [ ] Invalid, truncated and outdated formats rejected
- [ ] GitHub CI results checked
- [ ] Any skipped checks explicitly marked

## Security

- [ ] No secrets or private sources published
- [ ] Source revision and locator treated as untrusted hints
- [ ] Changes to live GitHub repositories independently verified

See [AGENTS.md](../AGENTS.md) and
[product contract](../docs/PRODUCT_CONTRACT.md).

FILE	.github/workflows/ci.yml
name: CI
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-rgp3-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  rust:
    name: Rust formatting, clippy, tests and generation
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - uses: Swatinem/rust-cache@v2
      - run: cargo fmt --all -- --check
      - run: cargo clippy --locked --all-targets -- -D warnings
      - run: cargo test --locked --all-targets
      - name: CLI generation, verification and determinism
        shell: bash
        run: |
          set -euo pipefail
          cargo build --locked
          target/debug/rgp generate . --output "$RUNNER_TEMP/a.rgp"
          target/debug/rgp generate . --output "$RUNNER_TEMP/b.rgp"
          cmp "$RUNNER_TEMP/a.rgp" "$RUNNER_TEMP/b.rgp"
          target/debug/rgp verify --artifact "$RUNNER_TEMP/a.rgp" --repo .
          test "$(head -n 1 "$RUNNER_TEMP/a.rgp")" = "RGP/0.3.0"

  nix:
    name: Nix package build and external-style invocation
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: DeterminateSystems/nix-installer-action@v17
      - run: nix flake check --no-update-lock-file --show-trace
      - run: nix build --no-update-lock-file .#rgp --out-link "$RUNNER_TEMP/rgp-package"
      - name: Nix-installed CLI generates and verifies a standalone artifact
        shell: bash
        run: |
          set -euo pipefail
          "$RUNNER_TEMP/rgp-package/bin/rgp" generate . --output "$RUNNER_TEMP/nix.rgp"
          "$RUNNER_TEMP/rgp-package/bin/rgp" verify --artifact "$RUNNER_TEMP/nix.rgp" --repo .
          test "$(head -n 1 "$RUNNER_TEMP/nix.rgp")" = "RGP/0.3.0"

FILE	.github/workflows/kira-sandbox-rgp.yml
name: Publish standalone RGP snapshot
on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: publish-rgp-${{ github.ref }}
  cancel-in-progress: true

jobs:
  snapshot:
    name: Generate and publish REPO_CONTEXT.rgp
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: true
      - name: Skip artifact-only commits to avoid revisional regeneration loop
        id: changes
        shell: bash
        run: |
          set -euo pipefail
          changed="$(git diff-tree --no-commit-id --name-only -r "$GITHUB_SHA")"
          if [ "$changed" = "REPO_CONTEXT.rgp" ]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "Only the tracked artifact changed; preserve its original source revision"
          fi
      - uses: dtolnay/rust-toolchain@stable
        if: steps.changes.outputs.skip != 'true'
      - uses: Swatinem/rust-cache@v2
        if: steps.changes.outputs.skip != 'true'
      - name: Build, generate and verify using only Rust
        if: steps.changes.outputs.skip != 'true'
        shell: bash
        run: |
          set -euo pipefail
          cargo build --locked --release
          target/release/rgp generate . --rev "$GITHUB_SHA" --output "$RUNNER_TEMP/REPO_CONTEXT.rgp"
          target/release/rgp verify --artifact "$RUNNER_TEMP/REPO_CONTEXT.rgp" --repo .
          echo "Source commit: $GITHUB_SHA" >> "$GITHUB_STEP_SUMMARY"
          sha256sum "$RUNNER_TEMP/REPO_CONTEXT.rgp" >> "$GITHUB_STEP_SUMMARY"
      - uses: actions/upload-artifact@v4
        if: steps.changes.outputs.skip != 'true'
        with:
          name: standalone-rgp-${{ github.sha }}
          path: ${{ runner.temp }}/REPO_CONTEXT.rgp
          retention-days: 7
          if-no-files-found: error
      - name: Refresh tracked RGP only when source changes
        if: github.ref == 'refs/heads/main' && steps.changes.outputs.skip != 'true'
        shell: bash
        run: |
          set -euo pipefail
          if test -f REPO_CONTEXT.rgp && cmp -s REPO_CONTEXT.rgp "$RUNNER_TEMP/REPO_CONTEXT.rgp"; then
            echo "Snapshot is already current"
            exit 0
          fi
          cp "$RUNNER_TEMP/REPO_CONTEXT.rgp" REPO_CONTEXT.rgp
          git add -- REPO_CONTEXT.rgp
          git -c user.name="github-actions[bot]" \
              -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
              commit -m "chore(rgp): refresh tracked source context for $GITHUB_SHA"
          git push origin HEAD:main

FILE	.github/workflows/security.yml
name: Dependency audit
on:
  schedule:
    - cron: '17 6 * * 1'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  rust-audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
      - run: cargo metadata --locked --no-deps > /dev/null
      - uses: rustsec/audit-check@v2.0.0
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

