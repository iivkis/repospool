"""RGP corpus integrity tests; only source verification, no model."""
import copy
import json
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))
from gate_b import ProtocolError, strict_json  # noqa: E402
from gate_b_rgp_audit import audit  # noqa: E402

PLAN = strict_json(ROOT / "benchmarks/gate_b/plan.json")


class CorpusAuditTest(unittest.TestCase):
    def test_missing_artifact_fails(self):
        corpus = {"artifacts": [{"repository": r["id"], "source_commit": r["commit"]}
                                for r in PLAN["repositories"]]}
        with tempfile.TemporaryDirectory() as td, self.assertRaisesRegex(ProtocolError, "missing RGP"):
            audit(PLAN, corpus, Path(td))

    def test_wrong_source_commit_fails(self):
        corpus = {"artifacts": [{"repository": r["id"], "source_commit": "f"*40}
                                for r in PLAN["repositories"]]}
        with tempfile.TemporaryDirectory() as td, self.assertRaisesRegex(ProtocolError, "wrong source commit"):
            audit(PLAN, corpus, Path(td))

    def test_rejects_unknown_path(self):
        plan = copy.deepcopy(PLAN)
        plan["tasks"][0]["reference_paths"] = ["missing/will/fail"]
        # validate_plan accepts safe unknown paths; audit enforces actual presence.
        corpus = {"artifacts": [{"repository": r["id"], "source_commit": r["commit"]}
                                for r in plan["repositories"]]}
        with tempfile.TemporaryDirectory() as td, self.assertRaisesRegex(ProtocolError, "missing RGP"):
            audit(plan, corpus, Path(td))


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_gate_b_sensitivity.py
"""Conditional Gate B call-volume calculations, not independent trials."""
from __future__ import annotations

import copy
import json
import sys
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))
from gate_b import ProtocolError  # noqa: E402
from gate_b_sensitivity import analyze, task_subset_counts, validate_setup  # noqa: E402

PLAN = json.loads((ROOT / "benchmarks/gate_b/plan.json").read_text(encoding="utf-8"))
OBS = json.loads((ROOT / "benchmarks/gate_b/observations.cache_fair_2026-10-29.json")
                 .read_text(encoding="utf-8"))
SETUP = json.loads((ROOT / "benchmarks/gate_b/setup_cost_model.json")
                   .read_text(encoding="utf-8"))


class GateBSensitivity(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.report = analyze(PLAN, OBS, SETUP)
        cls.by_size = {x["tasks"]: x for x in cls.report["by_task_count"]}

    def test_reproduces_full_measured_baseline_without_new_trials(self):
        self.assertEqual(self.report["full_run_measured_calls"], {"github": 13, "rgp": 6})
        self.assertAlmostEqual(self.report["full_run_reduction_pct"], 100 * 7 / 13)
        self.assertEqual(self.report["new_experimental_trials"], 0)
        self.assertTrue(self.report["decision"].startswith("HOLD"))
        self.assertEqual(self.report["total_nonempty_subsets"], 4095)
        self.assertEqual(self.report["conditional_shared_setup_calls"], 3)

    def test_single_task_always_worse_due_to_amortized_preparation(self):
        x = self.by_size[1]
        self.assertEqual(x["subsets"], 12)
        self.assertEqual(x["github_fewer_calls"], 12)
        self.assertEqual(x["rgp_fewer_calls"], 0)
        self.assertEqual(x["at_least_30_percent"], 0)

    def test_threshold_depends_on_workload_size_and_files(self):
        self.assertEqual(self.by_size[3]["at_least_30_percent"], 0)
        self.assertEqual(self.by_size[4]["at_least_30_percent"], 2)
        self.assertEqual(self.by_size[5]["rgp_fewer_calls"], 521)
        self.assertEqual(self.by_size[5]["subsets"], 792)
        self.assertEqual(self.by_size[5]["at_least_30_percent"], 51)
        for size in range(9, 13):
            x = self.by_size[size]
            self.assertEqual(x["at_least_30_percent"], x["subsets"])
        self.assertEqual(self.by_size[12]["subsets"], 1)

    def test_overlap_is_deduplicated_by_repository_and_path(self):
        by_id = {t["id"]: t for t in PLAN["tasks"]}
        rows = [by_id["rgp-transport-hash"], by_id["rgp-git-snapshot"]]
        cost = task_subset_counts(tuple(rows), 3, {k: 1 for k in
                                  ("rgp", "serde_json", "itsdangerous")},
                                  {x["id"]: 0 for x in PLAN["tasks"]})
        self.assertEqual(cost, (2, 4))

    def test_cost_model_disagrees_with_recorded_acquisition(self):
        x = copy.deepcopy(SETUP)
        x["shared_preparation_calls"]["pinned_reader_source"] = 0
        with self.assertRaisesRegex(ProtocolError, "positive integers"):
            analyze(PLAN, OBS, x)
        x = copy.deepcopy(SETUP)
        x["shared_preparation_calls"]["pinned_reader_source"] = 2
        with self.assertRaisesRegex(ProtocolError, "disagree"):
            analyze(PLAN, OBS, x)

    def test_model_rejects_fabricated_free_preparation(self):
        x = copy.deepcopy(SETUP)
        x["artifact_download_calls_per_repository"]["rgp"] = 0
        with self.assertRaisesRegex(ProtocolError, "positive integers"):
            analyze(PLAN, OBS, x)
        x = copy.deepcopy(SETUP)
        x["shared_preparation_calls"]["corpus_checkpoint"] = False
        with self.assertRaisesRegex(ProtocolError, "positive integers"):
            analyze(PLAN, OBS, x)

    def test_model_rejects_unknown_missing_repositories(self):
        for mode in ("extra", "missing"):
            x = copy.deepcopy(SETUP)
            downloads = x["artifact_download_calls_per_repository"]
            if mode == "extra":
                downloads["phantom"] = 1
            else:
                downloads.pop("serde_json")
            with self.subTest(mode=mode), self.assertRaisesRegex(
                    ProtocolError, "missing repository acquisition costs"):
                analyze(PLAN, OBS, x)

    def test_broken_cached_source_ledger_cannot_feed_sensitivity(self):
        x = copy.deepcopy(OBS)
        x["github_cache"]["source_fetches"].pop()
        with self.assertRaises(ProtocolError):
            analyze(PLAN, x, SETUP)
        x = copy.deepcopy(OBS)
        x.pop("github_cache")
        with self.assertRaises(ProtocolError):
            analyze(PLAN, x, SETUP)

    def test_plan_mismatch_and_unmeasured_costs_are_rejected(self):
        x = copy.deepcopy(OBS)
        x["plan_sha256"] = "0" * 64
        with self.assertRaises(ProtocolError):
            analyze(PLAN, x, SETUP)
        x = copy.deepcopy(OBS)
        x["rgp_preparation_calls"]["rgp"] = 0
        with self.assertRaises(ProtocolError):
            analyze(PLAN, x, SETUP)

    def test_summary_distinguishes_ties_from_savings(self):
        for row in self.report["by_task_count"]:
            self.assertEqual(row["rgp_fewer_calls"] + row["github_fewer_calls"]
                             + row["same_calls"], row["subsets"])
            self.assertGreaterEqual(row["max_reduction_pct"], row["min_reduction_pct"])
            self.assertLessEqual(row["at_least_30_percent"], row["rgp_fewer_calls"])


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_index_schema.py
"""SQLite is a future optional read-only index; validate its schema in stdlib."""
import sqlite3
import unittest
from pathlib import Path

SCHEMA = (Path(__file__).resolve().parents[1] / "schema.sql").read_text(encoding="utf-8")
DIGEST = "a" * 64


class IndexSchemaTests(unittest.TestCase):
    def setUp(self):
        self.db = sqlite3.connect(":memory:")
        self.db.executescript(SCHEMA)
        self.db.execute("INSERT INTO snapshot VALUES (1, '1.0', ?, ?)", ("c" * 40, DIGEST))
        self.db.execute(
            "INSERT INTO files VALUES ('src/app.py', '100644', 'file', 8, ?, ?, 'included')",
            (DIGEST, "files/" + DIGEST),
        )
        self.db.execute(
            "INSERT INTO analysis_runs VALUES ('run-1', 'test', '0.1', '{}', 'parsed', ?)",
            (DIGEST,),
        )
        self.db.execute(
            "INSERT INTO symbols VALUES ('sym-1', 'src/app.py', 'f', 'function', 1, 0, 1, 8, 'run-1', 'confirmed_reference')"
        )

    def tearDown(self):
        self.db.close()

    def test_schema_version_and_foreign_keys(self):
        self.assertEqual(self.db.execute("PRAGMA user_version").fetchone()[0], 1)
        self.assertEqual(self.db.execute("PRAGMA foreign_keys").fetchone()[0], 1)
        self.assertEqual(self.db.execute("PRAGMA integrity_check").fetchone()[0], "ok")
        self.assertEqual(self.db.execute("PRAGMA foreign_key_check").fetchall(), [])

    def test_resolved_relation_provenance(self):
        self.db.execute(
            """INSERT INTO relations
            (relation_id, relation_type, source_path, source_symbol_id, target_symbol_id,
             evidence_path, start_line, start_column, end_line, end_column, run_id,
             evidence, confidence_kind)
            VALUES ('r1', 'references', 'src/app.py', 'sym-1', 'sym-1',
                    'src/app.py', 1, 0, 1, 8, 'run-1', 'symbol occurrence', 'confirmed_reference')"""
        )
        self.assertEqual(
            self.db.execute("SELECT confidence_kind FROM relations WHERE target_symbol_id = 'sym-1'").fetchone()[0],
            "confirmed_reference",
        )

    def test_unresolved_target_cannot_be_marked_confirmed(self):
        with self.assertRaises(sqlite3.IntegrityError):
            self.db.execute(
                """INSERT INTO relations
                (relation_id, relation_type, source_path, unresolved_target,
                 evidence_path, start_line, start_column, end_line, end_column,
                 run_id, evidence, confidence_kind)
                VALUES ('r2', 'calls', 'src/app.py', 'maybe', 'src/app.py',
                        1, 0, 1, 8, 'run-1', 'guess', 'confirmed_reference')"""
            )

    def test_unknown_symbol_and_wrong_layer_rejected(self):
        with self.assertRaises(sqlite3.IntegrityError):
            self.db.execute(
                "INSERT INTO symbols VALUES ('bad', 'missing.py', 'f', 'function', 1, 0, 1, 2, 'run-1', 'unknown')"
            )
        with self.assertRaises(sqlite3.IntegrityError):
            self.db.execute("INSERT INTO coverage(layer,scope,status) VALUES ('understanding','all','available')")

    def test_independent_coverage_layers(self):
        for layer, status in [("snapshot", "available"), ("index", "not_indexed"),
                              ("graph", "unknown"), ("investigation", "unknown")]:
            self.db.execute("INSERT INTO coverage(layer, scope, status) VALUES (?, 'all', ?)", (layer, status))
        self.assertEqual(
            self.db.execute("SELECT layer FROM coverage ORDER BY layer").fetchall(),
            [("graph",), ("index",), ("investigation",), ("snapshot",)],
        )


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_lean_reader.py
"""RGP/0.1.0 independent hash-free, token-lean reader vectors."""
import sys
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "python"))
from rgp_reader import Reader, RgpError  # noqa: E402


def artifact(files=None, ignored=2, excluded=None):
    if files is None:
        files = {
            "src/example.py": b'print("END RGP\\nFILE\\tgotcha")\r\n',
            "src/unicode.txt": "Привет!\n".encode("utf-8"),
        }
    excluded = excluded or []
    guide = b"Read only relevant source and verify provenance from trusted Git."
    index = "".join(f"F\t{path}\t{len(raw)}\n" for path, raw in sorted(files.items()))
    if ignored:
        index += f"I\t{ignored}\n"
    index += "S\t1\n"
    index += "".join(f"X\t{name}\t{reason}\n" for name, reason in excluded)
    result = (f"RGP/0.1.0\nguide_bytes={len(guide)}\nindex_bytes={len(index.encode())}\n--\n"
              ).encode() + guide + b"\n" + index.encode() + b"\n"
    for path, raw in sorted(files.items()):
        result += f"FILE\t{path}\n".encode() + raw + b"\n"
    return result + b"END RGP\n"


class LeanTransportTest(unittest.TestCase):
    def test_no_embedded_hashes_and_original_content(self):
        raw = artifact()
        self.assertTrue(raw.startswith(b"RGP/0.1.0\n"))
        for token in (b"sha256", b"source_commit", b"manifest_length", b"input_tree_digest",
                      b"payload_sha256", b"base64_line_width", b'"blob"'):
            self.assertNotIn(token, raw)
        self.assertNotIn(b"PK\x03\x04", raw)
        reader = Reader(raw)
        overview = reader.overview()
        self.assertIsNone(overview["source_commit"])
        self.assertEqual(overview["transport"], "RGP/0.1.0")
        self.assertEqual(overview["intentionally_ignored_files"], 2)
        self.assertEqual(overview["self_artifact_excluded"], 1)
        self.assertTrue(overview["snapshot_complete"])
        self.assertTrue(reader.validate()["valid"])
        self.assertEqual(reader.read_bytes("src/example.py"),
                         b'print("END RGP\\nFILE\\tgotcha")\r\n')
        self.assertEqual(reader.search("Привет")["matches"][0]["line"], 1)
        self.assertEqual(reader.tree()["paths"], ["src/example.py", "src/unicode.txt"])

    def test_nonignored_exclusions_make_partial(self):
        r = Reader(artifact(excluded=[("sensitive/.env", "sensitive_path")]))
        self.assertFalse(r.overview()["snapshot_complete"])
        self.assertEqual(r.overview()["excluded_files"], 1)

    def test_bounds_and_delimiters_reject_corruption(self):
        raw = artifact()
        for changed, code in (
            (raw[:-8], "TRUNCATED_ARTIFACT"),
            (raw.replace(b"index_bytes=", b"index_bytes=999999999", 1), "RESOURCE_LIMIT"),
            (raw.replace(b"FILE\tsrc/example.py", b"F1LE\tsrc/example.py", 1),
             "UNSUPPORTED_FORMAT"),
            (raw.replace(b"RGP/0.1.0", b"RGP/9.0", 1), "UNSUPPORTED_FORMAT"),
            (raw + b"\xff", "UNSUPPORTED_FORMAT"),
        ):
            with self.subTest(code=code):
                with self.assertRaisesRegex(RgpError, code):
                    Reader(changed)

    def test_equal_length_tamper_is_not_authenticated_without_external_git(self):
        raw = artifact({"file.py": b"answer = 42\n"}, ignored=0)
        changed = raw.replace(b"answer = 42", b"answer = 43")
        self.assertEqual(Reader(changed).read_bytes("file.py"), b"answer = 43\n")
        # This is an explicit security trade-off. The full Git blob hash
        # MUST be verified independently before treating RGP as trusted.


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_reader_api.py
"""Reader contract for the only supported format, RGP/0.1.0."""
import json
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python"))
from rgp_reader import Reader, RgpError
from rgp_fixture import make_artifact, three_scope_artifact

class ReaderApiTests(unittest.TestCase):
    def setUp(self):
        self.reader = Reader(three_scope_artifact())

    def test_version_scope_and_guide(self):
        overview = self.reader.overview()
        self.assertEqual(overview["transport"], "RGP/0.1.0")
        self.assertIsNone(overview["source_commit"])
        self.assertTrue(overview["snapshot_complete"])
        self.assertEqual(overview["file_count"], 4)
        self.assertTrue(overview["embedded_instructions"])
        self.assertEqual(len(self.reader._blobs), 4)

    def test_read_tree_and_search(self):
        self.assertEqual(self.reader.read("src/a.py")["content"], "needle from src A\nneedle again\n")
        self.assertEqual(self.reader.tree(prefix="src/")["paths"], ["src/a.py", "src/sub/b.py"])
        self.assertEqual(len(self.reader.search("needle")["matches"]), 5)
        self.assertEqual(len(self.reader.search("needle", prefix="src/")["matches"]), 3)

    def test_paginated_cursors(self):
        a = self.reader.tree(limit=2)
        self.assertEqual(len(self.reader.tree(limit=2, cursor=a["next_cursor"])["paths"]), 2)
        with self.assertRaises(RgpError):
            self.reader.tree(prefix="tests/", cursor=a["next_cursor"])
        first = self.reader.search("needle", limit=2)
        second = self.reader.search("needle", limit=3, cursor=first["next_cursor"])
        self.assertEqual(len(first["matches"]) + len(second["matches"]), 5)

    def test_errors_and_scoped_coverage(self):
        with self.assertRaisesRegex(RgpError, "PARTIAL_SNAPSHOT"):
            self.reader.read("missing")
        with self.assertRaises(RgpError):
            self.reader.search("needle", prefix="../")
        partial = Reader(make_artifact({"x.txt": b"abc\n"}, ignored=2,
                                       excluded=(("missing.bin", "non_text"),)))
        self.assertFalse(partial.overview()["snapshot_complete"])
        self.assertEqual(partial.overview()["intentionally_ignored_files"], 2)

    def test_reject_all_old_versions(self):
        source = three_scope_artifact()
        for version in ("RGP/1.0", "RGP/1.1", "RGP/1.2", "RGP/2.0", "RGP/2.1", "RGP/3.0"):
            with self.subTest(version=version), self.assertRaisesRegex(RgpError, "UNSUPPORTED_FORMAT"):
                Reader(source.replace(b"RGP/0.1.0", version.encode(), 1))

    def test_truncation_and_external_trust_boundary(self):
        source = three_scope_artifact()
        with self.assertRaisesRegex(RgpError, "TRUNCATED_ARTIFACT"):
            Reader(source[:-8])
        changed = source.replace(b"needle from src A", b"needle from src B")
        self.assertIn("src B", Reader(changed).read("src/a.py")["content"])

    def test_cli(self):
        with tempfile.TemporaryDirectory() as folder:
            artifact = Path(folder) / "snapshot.rgp"
            artifact.write_bytes(three_scope_artifact())
            command = [sys.executable, str(ROOT / "python/rgp_reader.py"),
                       "--artifact", str(artifact), "search", "needle", "--prefix", "src/"]
            result = subprocess.run(command, check=True, capture_output=True, text=True)
            self.assertEqual(len(json.loads(result.stdout)["matches"]), 3)

if __name__ == "__main__":
    unittest.main()

