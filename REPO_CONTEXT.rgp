name: Stage 1 paired memory comparison

on:
  pull_request:
    paths:
      - src/main.rs
      - scripts/stage1_memory_ab.py
      - .github/workflows/stage1-memory-ab.yml

permissions:
  contents: read

jobs:
  paired-memory:
    name: Same-format paired memory A/B (cross-version is SKIP)
    runs-on: ubuntu-latest
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Compile candidate generator
        run: cargo build --locked --release
      - name: Compile independently checked out base revision
        shell: bash
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: |
          set -euo pipefail
          test -n "$BASE_SHA"
          git worktree add --detach "$RUNNER_TEMP/rgp-baseline" "$BASE_SHA"
          CARGO_TARGET_DIR="$RUNNER_TEMP/rgp-baseline-target" \
            cargo build --locked --release --manifest-path "$RUNNER_TEMP/rgp-baseline/Cargo.toml"
          echo "RGP_BASELINE_SHA=$BASE_SHA" >> "$GITHUB_ENV"
      - name: Paired memory and exact-RGP-byte acceptance
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/stage1_memory_ab.py \
            --baseline "$RUNNER_TEMP/rgp-baseline-target/release/rgp" \
            --candidate target/release/rgp \
            --report "$RUNNER_TEMP/stage1-memory-ab.json"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          x=json.loads((Path(os.environ["RUNNER_TEMP"]) / "stage1-memory-ab.json").read_text())
          assert x["gate_b"] == "HOLD"
          if x["status"] == "SKIP":
              assert x["reason"] == "TRANSPORT_VERSION_CHANGED"
              assert x["baseline_version"] != x["candidate_version"]
              assert x["candidate_version"] == "RGP/2.0"
          else:
              assert x["status"] == "PASS"
              assert len(x["profiles"]) == 5
              assert x["profiles"][-1]["included_files"] == 49999
              assert all(i["same_artifact_sha256"] for i in x["profiles"])
          PY
      - name: Summarize observed paired run
        if: always()
        shell: bash
        run: |
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          path = Path(os.environ["RUNNER_TEMP"]) / "stage1-memory-ab.json"
          if path.exists():
              r = json.loads(path.read_text())
              with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as f:
                  f.write(f"## Paired A/B memory: {r['status']}\n\n")
                  f.write(f"Baseline: `{os.environ.get('RGP_BASELINE_SHA', 'unknown')}`\n\n")
                  if r["status"] == "SKIP":
                      f.write(f"Skipped incompatible transport versions: {r['baseline_version']} -> {r['candidate_version']}. No paired memory claim.\n\n")
                  if "error" in r:
                      f.write(f"Failure: `{r['error']}`\n\n")
                  for item in r["profiles"]:
                      f.write(f"- {item['profile']}: baseline {item['baseline']['peak_rss_kib']} KiB, candidate {item['candidate']['peak_rss_kib']} KiB, change {item['peak_rss_change_percent']}%; artifact SHA-256 `{item['same_artifact_sha256']}`\n")
                  f.write("\nSame ephemeral runner; no model, GitHub connector or token-performance claims.\n")
          PY
      - name: Upload measured metadata only
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: stage1-memory-ab
          path: ${{ runner.temp }}/stage1-memory-ab.json
          retention-days: 14
          if-no-files-found: warn

FILE	".github/workflows/stage1-scale.yml"	3009	447123496e4746e9e97be973991e8b1e335dbf78ac706cfe2e6a82836d7491c3
name: Stage 1 50k Git-member boundary

on:
  pull_request:
    paths:
      - src/main.rs
      - python/rgp_reader.py
      - scripts/stage1_scale.py
      - .github/workflows/stage1-scale.yml
  push:
    branches: [main]
    paths:
      - src/main.rs
      - python/rgp_reader.py
      - scripts/stage1_scale.py
      - .github/workflows/stage1-scale.yml
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: stage1-scale-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  scale:
    name: 50k-member bounded Git-to-RGP acceptance
    runs-on: ubuntu-latest
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Compile production generator and verifier
        run: cargo build --locked --release
      - name: Create real 50005-blob Git commit and verify RGP capacity
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/stage1_scale.py \
            --rust-cli target/release/rgp \
            --report "$RUNNER_TEMP/stage1-scale.json"
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          r = json.loads((Path(os.environ["RUNNER_TEMP"]) / "stage1-scale.json").read_text())
          assert r["status"] == "PASS"
          assert r["source_files"] == 50005
          assert r["included_files"] == 49999
          assert r["excluded_files"] == 6
          assert r["plain_source_sections"] == 49999
          assert r["gate_b"] == "HOLD"
          PY
      - name: Record results and honest coverage
        if: always()
        shell: bash
        run: |
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          file = Path(os.environ["RUNNER_TEMP"]) / "stage1-scale.json"
          if file.exists():
              r = json.loads(file.read_text())
              with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as out:
                  out.write(f"## Stage 1 50k boundary: {r['status']}\n\n")
                  if r["status"] == "PASS":
                      out.write(f"Input: {r['source_files']} Git files; RGP: {r['included_files']} included, {r['excluded_files']} excluded, complete=false.\n\n")
                      out.write(f"Artifact SHA-256: `{r['rgp_sha256']}`\n\n")
                      out.write(f"Actual measurements: `{r['timings']}`\n\n")
                  else:
                      out.write(f"Failure: `{r.get('reason', 'unknown')}`\n\n")
                  out.write("Synthetic Git, not connector throughput, agent comprehension or independent Gate B.\n")
          PY
      - name: Upload metadata only (no Git blobs or RGP)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: stage1-scale-50k
          path: ${{ runner.temp }}/stage1-scale.json
          retention-days: 14
          if-no-files-found: warn

FILE	".github/workflows/stage1-stress.yml"	3120	fff5540be4ef41678e51b187a9b67486cc73591940d11e53042f70da6e2d2782
name: Stage 1 stress and limit acceptance

on:
  pull_request:
    paths:
      - src/main.rs
      - python/rgp_reader.py
      - scripts/stage1_stress.py
      - tests/test_stage1_stress.py
      - .github/workflows/stage1-stress.yml
  push:
    branches: [main]
    paths:
      - src/main.rs
      - python/rgp_reader.py
      - scripts/stage1_stress.py
      - tests/test_stage1_stress.py
      - .github/workflows/stage1-stress.yml
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: stage1-stress-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  synthetic-stress:
    name: Stress ${{ matrix.profile }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        profile: [many-files, incompressible, compressible, disk-fallback, oversized]
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Build generator
        run: cargo build --locked --release
      - name: Execute full Git-to-RGP stress case and resource measurement
        shell: bash
        env:
          TEST_PROFILE: ${{ matrix.profile }}
        run: |
          set -euo pipefail
          python3 scripts/stage1_stress.py \
            --profile "$TEST_PROFILE" \
            --rust-cli target/release/rgp \
            --report "$RUNNER_TEMP/stage1-stress.json"
          python3 -c 'import json,os; from pathlib import Path; x=json.loads((Path(os.environ["RUNNER_TEMP"]) / "stage1-stress.json").read_text()); assert x["status"]=="PASS" and x["gate_b"]=="HOLD"'
      - name: Summarize measured evidence
        if: always()
        shell: bash
        env:
          TEST_PROFILE: ${{ matrix.profile }}
        run: |
          python3 - <<'PY'
          import json, os
          from pathlib import Path
          path = Path(os.environ["RUNNER_TEMP"]) / "stage1-stress.json"
          if path.exists():
              r = json.loads(path.read_text())
              with open(os.environ["GITHUB_STEP_SUMMARY"], "a", encoding="utf-8") as out:
                  out.write(f"### Synthetic stress: {os.environ['TEST_PROFILE']}\n\n")
                  out.write(f"Status: **{r['status']}**; Gate B: HOLD\n\n")
                  if r["status"] == "PASS":
                      out.write(f"RGP bytes: {r['rgp_bytes']}; files: {r['file_count']}; complete: {r['snapshot_complete']}\n\n")
                      out.write(f"Observed resources: `{r['timings']}`\n\n")
                  else:
                      out.write(f"Failure: `{r.get('reason', 'unknown')}`\n\n")
                  out.write("Local synthetic Git only; no connector throughput, tokens or performance improvement claim.\n")
          PY
      - name: Upload metadata only, never source or RGP
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: stage1-stress-${{ matrix.profile }}
          path: ${{ runner.temp }}/stage1-stress.json
          if-no-files-found: warn
          retention-days: 14

FILE	".github/workflows/transport-probe.yml"	1403	c62eb7b606bb85ec36cdec5f2b6eb7aefd36d97a0f8e8667321d4d0aa6d605b1
name: Gate A transport fixtures

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  fixtures:
    name: Synthetic RGP ${{ matrix.size }} bytes
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        size: [102400, 5242880, 20971520, 52428800]
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@v6
        with:
          enable-cache: false
      - name: Generate a complete and deterministic RGP fixture
        shell: bash
        run: |
          set -euo pipefail
          uv run --no-project python scripts/transport_probe.py generate \
            --output-dir "$RUNNER_TEMP/rgp-fixtures" --sizes "${{ matrix.size }}"
          uv run --no-project python scripts/transport_probe.py verify \
            --input-dir "$RUNNER_TEMP/rgp-fixtures" \
            --expected "$RUNNER_TEMP/rgp-fixtures/expected.json"
          sha256sum "$RUNNER_TEMP/rgp-fixtures/probe-${{ matrix.size }}.rgp"
          wc -c "$RUNNER_TEMP/rgp-fixtures/probe-${{ matrix.size }}.rgp"
      - name: Retain short-lived fixture for connector experiments
        uses: actions/upload-artifact@v4
        with:
          name: rgp-transport-${{ matrix.size }}
          path: ${{ runner.temp }}/rgp-fixtures/
          if-no-files-found: error
          compression-level: 0
          retention-days: 3

